  "faq": {
    "id": "blog",
    "eyebrow": "FAQ",
    "title": "Frequently asked questions.",
    "lead": "Short answers to what parents usually ask first.",
    "items": [
      {
        "q": "Is Famixa a chore-tracking app for kids?",
        "a": "No. Famixa measures household progress (less nagging, more self-drive) — not rankings or grades for children."
      },
      {
        "q": "How much time do parents need each day?",
        "a": "Designed for ≤ 1 minute: Morning Brief highlights one focus, Decision Inbox reviews in seconds."
      },
      {
        "q": "Is Fami an AI chatbot for kids?",
        "a": "Fami is a companion mascot — not an LLM chatbot talking to children. AI supports parents with observation and suggestions."
      },
      {
        "q": "Is family data safe?",
        "a": "Yes. Data is protected under KIT Technology's privacy policy; you control access within the family."
      },
      {
        "q": "Which plan should we start with?",
        "a": "Start with Family (Free) for the daily rhythm. The 30-day trial unlocks Pro. Choose Premium for Timeline/Twin; Pro for Coach & evidence; Family Plus for Deep Playbook."
      }
    ]
