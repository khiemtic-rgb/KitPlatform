---
import '../styles/global.css';
import { absoluteUrl, APP_URL, DEFAULT_OG_IMAGE, SITE_NAME, SITE_URL } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'Famixa',
  description = 'AI Human Growth OS for Families — giúp con tự giác, bố mẹ bớt nhắc mỗi ngày.',
  canonicalPath = '/vi/',
} = Astro.props;

const fullTitle =
  title === SITE_NAME
    ? `${SITE_NAME} — AI Human Growth OS for Families`
    : `${title} — ${SITE_NAME}`;
const canonical = absoluteUrl(canonicalPath);
const ogImage = absoluteUrl(DEFAULT_OG_IMAGE);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_NAME,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web',
  url: SITE_URL,
  description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'VND',
  },
  publisher: {
    '@type': 'Organization',
    name: 'KIT Technology',
    url: 'https://novixa.vn',
  },
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1B6B4A" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-app-url={APP_URL}>
    <slot />
  </body>
</html>
