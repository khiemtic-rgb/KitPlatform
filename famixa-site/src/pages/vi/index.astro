---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { APP_URL } from '../../lib/site';

const moments = [
  {
    img: '/images/moment-sleep.png',
    title: 'Giờ đi ngủ',
    body: 'Routine tối nhẹ nhàng — bớt căng, ngủ đúng giờ hơn.',
  },
  {
    img: '/images/moment-study.png',
    title: 'Giờ học tập',
    body: 'Con chủ động bắt đầu; bố mẹ ít phải đứng nhắc.',
  },
  {
    img: '/images/moment-chores.png',
    title: 'Việc nhà',
    body: 'Mission nhỏ mỗi ngày — thành thói quen, không thành trận chiến.',
  },
  {
    img: '/images/moment-family.png',
    title: 'Thời gian gia đình',
    body: 'Movie Night & khoảnh khắc ấm — phần thưởng cả nhà cùng mở.',
  },
];

const steps = [
  { icon: '👀', title: 'Quan sát', body: 'Lắng nghe nhịp nhà — không soi, không chấm điểm con.' },
  { icon: '💛', title: 'Thấu hiểu', body: 'Hiểu vì sao nhắc nhiều / căng thẳng — trước khi đề xuất.' },
  { icon: '💡', title: 'Đề xuất', body: 'Một việc bố mẹ làm hôm nay — Decision Inbox vài giây.' },
  { icon: '🤝', title: 'Đồng hành', body: 'AI học gia đình bạn — càng dùng càng vừa nhà.' },
];

const growth = [
  { title: 'Hạt mầm', hint: 'Bắt đầu' },
  { title: 'Nảy mầm', hint: 'Thói quen mới' },
  { title: 'Fami nhỏ', hint: 'Ít nhắc hơn' },
  { title: 'Fami lớn', hint: 'Con tự giác' },
  { title: 'Cây trưởng thành', hint: 'Nhà yên' },
];

const quotes = [
  {
    name: 'Chị Lan Anh',
    place: 'Hà Nội',
    img: '/images/quote-lan.png',
    text: 'Trước phải nhắc con 5–6 lần mỗi sáng. Giờ Morning Brief chỉ chỉ một việc — nhà đỡ ồn hẳn.',
  },
  {
    name: 'Anh Minh Hoàng',
    place: 'TP.HCM',
    img: '/images/quote-minh.png',
    text: 'Không phải app chấm sao cho vui. Mình thấy rõ tuần nào bớt căng — đó mới là thứ đáng trả tiền.',
  },
  {
    name: 'Chị Thu Thảo',
    place: 'Đà Nẵng',
    img: '/images/quote-thu.png',
    text: '3 câu tối mất chưa tới một phút. Con cũng thích Movie Night khi cả nhà xong nhiệm vụ.',
  },
];

const plans = [
  {
    name: 'Start',
    price: '0đ',
    period: '/ vĩnh viễn',
    badge: null as string | null,
    featured: false,
    cta: 'Bắt đầu miễn phí',
    items: ['AI Coach cơ bản', 'Morning Brief', 'Thời gian giới hạn', 'Bảo mật cơ bản'],
  },
  {
    name: 'Peace',
    price: '149.000đ',
    period: '/ tháng',
    badge: null as string | null,
    featured: false,
    cta: 'Dùng thử 14 ngày',
    items: [
      'Tất cả tính năng Start',
      'AI Coach nâng cao',
      'Behavior OS',
      'Thử thách & phần thưởng',
      'Báo cáo tuần',
    ],
  },
  {
    name: 'Growth',
    price: '249.000đ',
    period: '/ tháng',
    badge: 'Phổ biến',
    featured: true,
    cta: 'Dùng thử 14 ngày',
    items: [
      'Tất cả tính năng Peace',
      'AI Coach cá nhân hóa',
      'Family Reson',
      'Hỗ trợ ưu tiên',
      'Sự kiện & workshop',
    ],
  },
];
---

<BaseLayout>
  <Header />

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1>AI giúp con tự giác.<br />Cha mẹ không còn phải nhắc mỗi ngày.</h1>
          <p class="lead">
            Famixa là người bạn đồng hành AI hiểu từng gia đình — giúp nuôi dạy nhẹ hơn, thời gian bên nhau
            chất lượng hơn, và con lớn lên bằng thói quen chứ không bằng lời nhắc.
          </p>
          <div class="hero-cta">
            <a class="btn btn-primary" href={APP_URL}>
              Bắt đầu hành trình
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"
                ><path
                  d="M5 12h14M13 5l7 7-7 7"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
            </a>
            <a class="btn btn-ghost" href="#video">
              <span class="play" aria-hidden="true"
                ><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"
                  ><path d="M8 5v14l11-7z"></path></svg
                ></span
              >
              Xem video
            </a>
          </div>
          <div class="proof" aria-label="Cam kết">
            <div class="proof-item">
              <span class="proof-icon" aria-hidden="true">👨‍👩‍👧</span>
              <div>
                <strong>10.000+</strong>
                <span>gia đình</span>
              </div>
            </div>
            <div class="proof-item">
              <span class="proof-icon" aria-hidden="true">⭐</span>
              <div>
                <strong>4.8/5</strong>
                <span>đánh giá</span>
              </div>
            </div>
            <div class="proof-item">
              <span class="proof-icon" aria-hidden="true">🔒</span>
              <div>
                <strong>Bảo mật</strong>
                <span>dữ liệu gia đình</span>
              </div>
            </div>
            <div class="proof-item">
              <span class="proof-icon" aria-hidden="true">🇻🇳</span>
              <div>
                <strong>Made in VN</strong>
                <span>by KIT</span>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-art">
          <img
            src="/images/hero-family.png"
            alt="Gia đình bên Fami — mascot Famixa"
            width="1200"
            height="825"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section class="section chapter" id="giai-phap">
      <div class="wrap fami-appear">
        <div>
          <p class="eyebrow">Chương 1</p>
          <h2>Fami xuất hiện.</h2>
          <p class="chapter-lead">
            Không phải chatbot dạy con. Fami là hạt mầm đồng hành — nhắc nhẹ, ăn mừng đúng lúc, và giúp cả
            nhà nhìn thấy tiến bộ thật: bớt nhắc, thêm tự giác.
          </p>
        </div>
        <figure class="fami-figure">
          <img src="/images/fami-appear.png" alt="Fami — mầm xanh Famixa" width="840" height="630" />
        </figure>
      </div>
    </section>

    <section class="section chapter alt" id="ai-coach">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Chương 2</p>
          <h2>Fami lắng nghe và thấu hiểu.</h2>
          <p>Quan sát nhịp nhà → thấu hiểu cảm xúc → đề xuất vừa lúc → đồng hành từng ngày.</p>
        </div>
        <div class="steps">
          {steps.map((s) => (
            <article class="step">
              <i aria-hidden="true">{s.icon}</i>
              <strong>{s.title}</strong>
              <p>{s.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section chapter">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Chương 3</p>
          <h2>Đồng hành trong mọi khoảnh khắc.</h2>
          <p>Một OS cho cả ngày — không phải năm app rời rạc.</p>
        </div>
        <div class="moment-grid">
          {moments.map((m) => (
            <article class="moment">
              <div class="moment-media">
                <img src={m.img} alt="" width="640" height="480" loading="lazy" />
              </div>
              <div class="moment-body">
                <h3>{m.title}</h3>
                <p>{m.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section chapter mint" id="growth">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Chương 4</p>
          <h2>Hành trình trưởng thành của gia đình bạn.</h2>
          <p>Từ hạt mầm đến cây lớn — Famixa đo tiến bộ nhà, không đo “điểm con”.</p>
        </div>
        <figure class="journey-art">
          <img
            src="/images/growth-journey.png"
            alt="Hành trình Fami từ hạt mầm đến cây trưởng thành"
            width="1400"
            height="788"
            loading="lazy"
          />
        </figure>
        <div class="growth-track" aria-label="Các giai trưởng thành">
          {growth.map((g) => (
            <div class="growth-item">
              <strong>{g.title}</strong>
              <span>{g.hint}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section chapter" id="method">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Chương 5</p>
          <h2>Công nghệ tinh tế, trải nghiệm đơn giản.</h2>
          <p>Morning Brief · Decision Inbox · Growth Report — trên mọi thiết bị bố mẹ đang dùng.</p>
        </div>
        <figure class="devices-art">
          <img
            src="/images/devices-mock.png"
            alt="Famixa trên laptop, tablet và điện thoại"
            width="1400"
            height="788"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="section chapter alt" id="video">
      <div class="wrap loop-grid">
        <div class="section-head left">
          <p class="eyebrow">Chương 6</p>
          <h2>Vòng lặp tăng trưởng của Famixa.</h2>
          <p>Gia đình thực hành → AI học nhà bạn → đề xuất ngày càng vừa.</p>
          <ol class="loop-list">
            <li><strong>Quan sát</strong> nhịp nhà & hành vi</li>
            <li><strong>Thấu hiểu</strong> trước khi khuyên</li>
            <li><strong>Đề xuất</strong> 1 hành động ≤ 1 phút</li>
            <li><strong>Gia đình thực hành</strong> · AI học tiếp</li>
          </ol>
        </div>
        <figure class="loop-art">
          <img
            src="/images/growth-loop.png"
            alt="Vòng lặp tăng trưởng Famixa quanh Fami"
            width="900"
            height="900"
            loading="lazy"
          />
        </figure>
      </div>
    </section>

    <section class="section chapter">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Chương 7</p>
          <h2>Cha mẹ nói gì về Famixa?</h2>
          <p>Giọng pilot — câu chuyện ROI cảm xúc, không phải “app chấm việc”.</p>
        </div>
        <div class="quotes">
          {quotes.map((q) => (
            <article class="quote">
              <img class="quote-avatar" src={q.img} alt="" width="72" height="72" loading="lazy" />
              <p>“{q.text}”</p>
              <div class="quote-meta">
                <strong>{q.name}</strong>
                <span>{q.place}</span>
              </div>
              <div class="stars" aria-label="5 sao">★★★★★</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section chapter mint" id="pricing">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Chương 8</p>
          <h2>Gói đồng hành cho mọi gia đình.</h2>
          <p>Chọn nhịp nhà bạn — bắt đầu miễn phí, nâng cấp khi đã thấy yên hơn.</p>
        </div>
        <div class="pricing">
          {plans.map((p) => (
            <article class:list={['plan', p.featured && 'featured']}>
              {p.badge ? <span class="badge">{p.badge}</span> : null}
              <h3>{p.name}</h3>
              <div class="price">
                {p.price}
                <small>{p.period}</small>
              </div>
              <ul>
                {p.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a class:list={['btn', p.featured ? 'btn-primary' : 'btn-secondary']} href={APP_URL}>
                {p.cta}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section final-section">
      <div class="wrap">
        <div class="final-cta">
          <img src="/images/cta-campfire.png" alt="" width="1400" height="788" loading="lazy" />
          <div class="veil" aria-hidden="true" />
          <div class="content">
            <h2>Mỗi gia đình là một hành trình. Famixa ở đây để đồng hành từng bước nhỏ.</h2>
            <a class="btn btn-primary" href={APP_URL}>Bắt đầu hành trình của bạn</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
