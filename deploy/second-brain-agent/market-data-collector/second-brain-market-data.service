[Unit]
Description=Second Brain public market data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sbagent
Group=sbagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/second-brain-market-data/collector.py --archive /var/lib/second-brain-research/market-data sync
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/second-brain-research /var/log/second-brain-market-data
UMask=0027
StandardOutput=append:/var/log/second-brain-market-data/collector.log
StandardError=append:/var/log/second-brain-market-data/collector.log
