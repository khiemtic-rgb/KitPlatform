[Unit]
Description=Second Brain research.evaluate task
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sbagent
Group=sbagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/second-brain-research-runner/research_task.py run --archive /var/lib/second-brain-research/market-data --publications /var/lib/second-brain-research/publications --tasks /var/lib/second-brain-research/tasks --lab-root /opt/second-brain-research-runner/engine --frozen-snapshot /opt/second-brain-research-runner/frozen/SOLUSDT.json --anchor /opt/second-brain-research-runner/frozen/LAB_RESULT.json --frozen-publication /opt/second-brain-research-publication-v1 --funding-dir /var/lib/second-brain-research/funding
Nice=10
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/second-brain-research /var/log/second-brain-market-data
UMask=0027
StandardOutput=append:/var/log/second-brain-market-data/research-evaluate.log
StandardError=append:/var/log/second-brain-market-data/research-evaluate.log
