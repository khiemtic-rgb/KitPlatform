---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const copy: Record<string, { title: string; body: string[] }> = {
  'quy-dinh': {
    title: 'Quy định sử dụng',
    body: [
      'Chỉ đăng tin việc / sự kiện / phòng trọ thật, có chỗ và cách liên hệ. Không livestream, đa cấp, crypto, “triệu/ngày”. Phòng không điền giá trên site.',
      'Tin mới ở trạng thái chờ duyệt. Site công khai chỉ hiện tin đã duyệt, còn hạn, không gắn cờ an toàn.',
    ],
  },
  'dieu-khoan': {
    title: 'Điều khoản',
    body: [
      'Bạn chịu trách nhiệm nội dung tin đăng. Phỏng vấn / xem phòng do chủ tin, không qua nền tảng.',
      'Chúng tôi có thể từ chối hoặc gỡ tin vi phạm quy định. Không tự đăng hộ lên group Facebook.',
    ],
  },
  'bao-mat': {
    title: 'Chính sách bảo mật',
    body: [
      'Đăng tin dùng số điện thoại liên hệ. Không bán dữ liệu. Không thu phí ứng tuyển.',
      'Duyệt tin do người vận hành. Không crawl Facebook, không tự đăng group.',
    ],
  },
  'lien-he': {
    title: 'Liên hệ',
    body: [
      'Chưa có hotline công khai. Đăng tin việc trên site; tin lên sau khi duyệt.',
      'Gợi ý group Facebook — bạn tự mở và dán. Chúng tôi không đăng hộ.',
    ],
  },
  'quang-cao': {
    title: 'Quảng cáo',
    body: [
      'Chưa nhận quảng cáo ngoài. Ưu đãi quán / thương hiệu sẽ làm khi có cộng đồng. Học bổng chưa mở trên site.',
    ],
  },
};

const slug = Astro.params.slug ?? '';
const page = copy[slug];
if (!page) {
  return Astro.redirect('/');
}
---
<Layout title={`${page.title} — Thái Nguyên Life`} description={page.body[0]}>
  <div class="page">
    <div class="wrap legal-wrap">
      <h1 class="page-title">{page.title}</h1>
      <div class="panel legal-panel">
        {page.body.map((p) => <p>{p}</p>)}
        <a class="btn-green" href="/">Về trang chủ</a>
      </div>
    </div>
  </div>
</Layout>
