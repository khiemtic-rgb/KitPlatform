---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const copy: Record<string, { title: string; body: string[] }> = {
  'gioi-thieu': {
    title: 'Giới thiệu',
    body: [
      'Thái Nguyên Life là nền tảng thông tin địa phương — việc, sự kiện, nhà ở quanh Thái Nguyên.',
      'Xem không cần tài khoản. Tin lên site sau khi duyệt tay. Chúng tôi không nhận hồ sơ, không phỏng vấn, không thu phí ứng tuyển.',
    ],
  },
  'quy-dinh': {
    title: 'Quy định sử dụng',
    body: [
      'Chỉ đăng tin việc thật, có chỗ làm và cách liên hệ. Không livestream, đa cấp, crypto, “triệu/ngày”.',
      'Tin mới ở trạng thái chờ duyệt. Site công khai chỉ hiện tin đã duyệt, còn hạn, không gắn cờ an toàn.',
    ],
  },
  'dieu-khoan': {
    title: 'Điều khoản',
    body: [
      'Bạn chịu trách nhiệm nội dung tin đăng. Phỏng vấn / xem phòng do chủ tin, không qua nền tảng.',
      'Chúng tôi có thể từ chối hoặc gỡ tin vi phạm quy định. Không tự đăng hộ lên group Facebook.',
    ],
  },
  'bao-mat': {
    title: 'Chính sách bảo mật',
    body: [
      'Đăng tin việc dùng số điện thoại + OTP. Không bán dữ liệu. Không thu phí ứng tuyển.',
      'Duyệt tin do người vận hành. Không crawl Facebook, không tự đăng group.',
    ],
  },
  'lien-he': {
    title: 'Liên hệ',
    body: [
      'Chưa có hotline công khai. Đăng tin việc trên site; tin lên sau khi duyệt.',
      'Gợi ý group Facebook — bạn tự mở và dán. Chúng tôi không đăng hộ.',
    ],
  },
  'quang-cao': {
    title: 'Quảng cáo',
    body: [
      'Chưa nhận quảng cáo ngoài. Ưu đãi / học bổng trên site đang để chỗ — sắp mở.',
    ],
  },
};

const slug = Astro.params.slug ?? '';
const page = copy[slug];
if (!page) {
  return Astro.redirect('/');
}
---
<Layout title={`${page.title} — Thái Nguyên Life`}>
  <div class="page">
    <div class="wrap publish-wrap">
      <h1 class="page-title">{page.title}</h1>
      <div class="panel">
        {page.body.map((p) => <p>{p}</p>)}
        <a class="btn-green" href="/">Về trang chủ</a>
      </div>
    </div>
  </div>
</Layout>
