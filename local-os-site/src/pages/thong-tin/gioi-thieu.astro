---
import Layout from '../../layouts/Layout.astro';
import { listGroups, listListings } from '../../lib/api';
import { PLACES } from '../../lib/discover';

const [jobs, events, rooms, groups] = await Promise.all([
  listListings('job'),
  listListings('event'),
  listListings('room'),
  listGroups(),
]);
const live = jobs.length + events.length + rooms.length;

const features = [
  {
    id: 'place',
    title: 'Hiểu Thái Nguyên',
    lead: 'Địa điểm, chè, văn hóa, cẩm nang — có nguồn, không phải blog tour.',
    href: '/kham-pha',
    ico: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/></svg>',
  },
  {
    id: 'job',
    title: 'Tìm việc dễ dàng',
    lead: 'Tin việc đã duyệt, còn hạn. Nền tảng không nhận CV, không phỏng vấn.',
    href: '/viec',
    ico: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V6a4 4 0 0 1 8 0v1M3 12h18"/></svg>',
  },
  {
    id: 'event',
    title: 'Cập nhật sự kiện',
    lead: 'Lễ hội, workshop, ngày hội còn hạn — sau khi duyệt tay.',
    href: '/su-kien',
    ico: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>',
  },
  {
    id: 'room',
    title: 'Tìm chỗ ở phù hợp',
    lead: 'Phòng đã duyệt. Giá liên hệ khi gọi — không niêm yết giá trên site.',
    href: '/tro',
    ico: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 11.5 12 5l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-8.5z"/></svg>',
  },
  {
    id: 'offer',
    title: 'Ưu đãi quanh bạn',
    lead: 'Sắp có — chưa mở sổ quán / mã giảm giá.',
    soon: true,
    ico: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 4.8 7.2v9.6L12 21l7.2-4.2V7.2L12 3z"/><path d="M9 12h6"/></svg>',
  },
  {
    id: 'community',
    title: 'Kết nối cộng đồng',
    lead: 'Group Facebook thật quanh Thái Nguyên. Tự mở và tham gia — không đăng hộ.',
    href: '/#cong-dong',
    ico: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="16" cy="9" r="2.4"/><path d="M3.6 18a5.4 5.4 0 0 1 10.8 0M13.2 18a4.4 4.4 0 0 1 7.2 0"/></svg>',
  },
];
---
<Layout title="Giới thiệu — Thái Nguyên Life" description="Thái Nguyên Life là nền tảng thông tin địa phương: việc, sự kiện, phòng trọ đã duyệt. Không thu phí ứng tuyển.">
  <div class="page about-page">
    <div class="wrap">
      <nav class="about-crumb" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span aria-hidden="true">›</span>
        <span>Giới thiệu</span>
      </nav>

      <section class="about-hero">
        <div class="about-hero-copy">
          <h1>Thái Nguyên Life là gì?</h1>
          <p>Nền tảng hiểu nơi mình sống, rồi tìm việc — sự kiện — phòng trọ đã duyệt tại Thái Nguyên. Xem không cần tài khoản. Tin lên site sau khi người duyệt tay.</p>
          <p>Không nhận hồ sơ, không phỏng vấn, không thu phí ứng tuyển. Không crawl Facebook, không tự đăng group.</p>
          <a class="btn-green" href="/">Về trang chủ →</a>
        </div>
        <div class="about-hero-photo">
          <img src="/discover/doi-che.jpg" alt="" />
          <span class="photo-caption">Ảnh minh họa</span>
        </div>
      </section>

      <section class="about-feats" aria-label="Việc nền tảng làm">
        {features.map((f) =>
          f.soon || !f.href ? (
            <span class={`about-feat is-soon tone-${f.id}`}>
              <span class="about-feat-ico" aria-hidden="true" set:html={f.ico} />
              <strong>{f.title}</strong>
              <em>{f.lead}</em>
            </span>
          ) : (
            <a class={`about-feat tone-${f.id}`} href={f.href}>
              <span class="about-feat-ico" aria-hidden="true" set:html={f.ico} />
              <strong>{f.title}</strong>
              <em>{f.lead}</em>
            </a>
          )
        )}
      </section>

      <section class="about-mission">
        <figure class="about-mission-photo">
          <img src="/discover/doi-che.jpg" alt="" />
          <span class="photo-caption">Ảnh minh họa</span>
          <figcaption>
            <strong>Thái Nguyên — đất chè, hồ, di tích</strong>
            <span>Chỗ để hiểu trước, rồi mới tìm việc / phòng / sự kiện quanh mình.</span>
          </figcaption>
        </figure>
        <div class="about-mission-copy">
          <h2>Sứ mệnh của chúng tôi</h2>
          <p>Giữ thông tin địa phương đúng và còn hạn. Không bịa điểm đánh giá, không bịa danh bạ quán, không biến site thành mạng xã hội sinh viên.</p>
          <ul>
            <li>
              <span class="about-m-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.4"/><path d="M12 4v2.4M12 17.6V20M4 12h2.4M17.6 12H20"/></svg>
              </span>
              <div>
                <strong>Địa phương trước tiên</strong>
                <p>Thái Nguyên là thành phố đầu. Khám phá + việc + sự kiện + phòng — không phải catalog du lịch cả nước.</p>
              </div>
            </li>
            <li>
              <span class="about-m-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 5 6.2v6.3c0 4.2 2.9 7.2 7 8.5 4.1-1.3 7-4.3 7-8.5V6.2L12 3z"/><path d="m8.8 12 2.2 2.2 4.4-4.6"/></svg>
              </span>
              <div>
                <strong>Tin cậy &amp; minh bạch</strong>
                <p>Tin mới chờ duyệt. Site chỉ hiện tin ACTIVE, còn hạn. Nguồn ghi trên trang. Không tự publish.</p>
              </div>
            </li>
            <li>
              <span class="about-m-ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6.5" cy="12" r="2.2"/><circle cx="17.5" cy="7.5" r="2.2"/><circle cx="17.5" cy="16.5" r="2.2"/><path d="m8.4 11.2 6.4-2.6M8.4 12.8l6.4 2.6"/></svg>
              </span>
              <div>
                <strong>Kết nối, không làm hộ</strong>
                <p>Gợi ý group Facebook thật. Bạn tự mở và dán. Chúng tôi không crawl group, không đăng hộ.</p>
              </div>
            </li>
          </ul>
        </div>
      </section>

      <section class="about-stats" aria-label="Số đang có trên site">
        <div>
          <span class="about-stat-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 4h10v16H7z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
          </span>
          <strong>{live}</strong>
          <em>Tin việc / sự kiện / phòng đang hiện</em>
        </div>
        <div>
          <span class="about-stat-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M3.6 18a5.4 5.4 0 0 1 10.8 0"/></svg>
          </span>
          <strong>{groups.length}</strong>
          <em>Group Facebook thật quanh Thái Nguyên</em>
        </div>
        <div>
          <span class="about-stat-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/></svg>
          </span>
          <strong>{PLACES.length}</strong>
          <em>Địa điểm khám phá có nguồn</em>
        </div>
        <div>
          <span class="about-stat-ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 5 6.2v6.3c0 4.2 2.9 7.2 7 8.5 4.1-1.3 7-4.3 7-8.5V6.2L12 3z"/></svg>
          </span>
          <strong>Không mất phí</strong>
          <em>Xem tin và liên hệ — không cần tài khoản</em>
        </div>
      </section>

      <section class="about-cta">
        <div>
          <h2>Cùng xây dựng Thái Nguyên tốt đẹp hơn</h2>
          <p>Đăng tin việc miễn phí, chờ duyệt. Hoặc vào group Facebook thật — tự tham gia, không qua nền tảng.</p>
        </div>
        <div class="about-cta-actions">
          <a class="btn-green" href="/#cong-dong">Tham gia cộng đồng →</a>
          <a class="btn-outline" href="/dang-tin">+ Đăng tin việc</a>
        </div>
      </section>
    </div>
  </div>
</Layout>
