---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { formatEventLine, hrefFor, listListings } from '../../../lib/api';
import {
  GUIDES,
  PLACES,
  getPlace,
  guideHref,
  matchEventsForPlace,
  placeHref,
} from '../../../lib/discover';

export function getStaticPaths() {
  return PLACES.map((p) => ({ params: { slug: p.slug } }));
}

const place = getPlace(Astro.params.slug ?? '');
if (!place) return Astro.redirect('/kham-pha/dia-diem');

const events = await listListings('event');
const related = matchEventsForPlace(place, events);
const nearby = place.nearby.map((s) => getPlace(s)).filter(Boolean);
const guides = GUIDES.filter((g) => g.sections.some((s) => s.placeSlugs?.includes(place.slug)));
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.mapsQuery)}`;
---
<Layout title={`${place.title} — Khám phá Thái Nguyên`} active="discover">
  <div class="page discover-page">
    <div class="wrap guide-wrap">
      <nav class="job-crumb" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <a href="/kham-pha">Khám phá</a>
        <span>›</span>
        <a href="/kham-pha/dia-diem">Địa điểm</a>
        <span>›</span>
        <span>{place.title}</span>
      </nav>

      <article class="event-detail-main guide-article">
        <div class="event-hero-media">
          <img src={place.cover} alt="" />
          <span class="photo-caption">Ảnh minh họa</span>
        </div>
        <header class="event-detail-head">
          <p class="muted">{place.kicker}</p>
          <h1>{place.title}</h1>
          <p class="event-detail-lead">{place.placeText}</p>
        </header>

        <section class="job-block">
          <h2>Giới thiệu</h2>
          {place.intro.map((p) => <p>{p}</p>)}
        </section>
        <section class="job-block">
          <h2>Đi đâu / làm gì</h2>
          {place.doWhat.map((x) => <p>{x}</p>)}
        </section>
        <section class="job-block">
          <h2>Ăn gì</h2>
          {place.eatWhat.map((x) => <p>{x}</p>)}
        </section>
        {nearby.length > 0 && (
          <section class="job-block">
            <h2>Gần đây</h2>
            {nearby.map((n) => n && (
              <div class="guide-hit">
                <p>{n.summary}</p>
                <p class="guide-pills">
                  <a class="btn-outline" href={placeHref(n.slug)}>{n.title}</a>
                </p>
              </div>
            ))}
          </section>
        )}
        {related.length > 0 && (
          <section class="job-block">
            <h2>Sự kiện liên quan</h2>
            {related.map((e) => (
              <div class="guide-hit">
                <p>{formatEventLine(e.startAt) || e.placeText || ''}</p>
                <p class="guide-pills">
                  <a class="btn-outline" href={hrefFor(e)}>{e.title}</a>
                </p>
              </div>
            ))}
            <p class="guide-pills">
              <a class="btn-outline" href="/su-kien">Tất cả sự kiện</a>
            </p>
          </section>
        )}
        {guides.length > 0 && (
          <section class="job-block">
            <h2>Cẩm nang</h2>
            <p class="guide-pills">
              {guides.map((g) => (
                <a class="btn-outline" href={guideHref(g.slug)}>{g.title}</a>
              ))}
            </p>
          </section>
        )}
        <section class="job-block">
          <h2>Bản đồ</h2>
          <p class="guide-pills">
            <a class="btn-outline" href={maps} rel="nofollow noopener" target="_blank">Xem trên Google Maps</a>
          </p>
        </section>
        <section class="job-block">
          <h2>Nguồn</h2>
          <ul>
            {place.sources.map((s) => (
              <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>
            ))}
          </ul>
        </section>
      </article>
    </div>
  </div>
</Layout>
