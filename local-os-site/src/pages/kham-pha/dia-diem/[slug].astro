---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { formatEventLine, hrefFor, listListings } from '../../../lib/api';
import {
  GUIDES,
  PLACES,
  getPlace,
  guideHref,
  matchEventsForPlace,
  placeHref,
} from '../../../lib/discover';

export function getStaticPaths() {
  return PLACES.map((p) => ({ params: { slug: p.slug } }));
}

const place = getPlace(Astro.params.slug ?? '');
if (!place) return Astro.redirect('/kham-pha/dia-diem');

const events = await listListings('event');
const related = matchEventsForPlace(place, events);
const nearby = place.nearby.map((s) => getPlace(s)).filter(Boolean);
const guides = GUIDES.filter((g) => g.sections.some((s) => s.placeSlugs?.includes(place.slug)));
const maps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.mapsQuery)}`;
---
<Layout title={`${place.title} — Khám phá Thái Nguyên`} active="discover">
  <div class="page discover-page">
    <div class="wrap">
      <nav class="job-crumb" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <a href="/kham-pha">Khám phá</a>
        <span>›</span>
        <a href="/kham-pha/dia-diem">Địa điểm</a>
        <span>›</span>
        <span>{place.title}</span>
      </nav>

      <div class="discover-detail">
        <article class="discover-detail-main">
          <div class="event-hero-media">
            <img src={place.cover} alt="" />
            <span class="photo-caption">Ảnh minh họa</span>
          </div>
          <header class="event-detail-head">
            <p class="muted">{place.kicker}</p>
            <h1>{place.title}</h1>
            <p class="event-detail-lead">{place.placeText}</p>
          </header>

          <section class="job-block">
            <h2>Giới thiệu</h2>
            {place.intro.map((p) => <p>{p}</p>)}
          </section>
          <section class="job-block">
            <h2>Đi đâu / làm gì</h2>
            <ul>{place.doWhat.map((x) => <li>{x}</li>)}</ul>
          </section>
          <section class="job-block">
            <h2>Ăn gì</h2>
            <ul>{place.eatWhat.map((x) => <li>{x}</li>)}</ul>
          </section>
          {nearby.length > 0 && (
            <section class="job-block">
              <h2>Gần đây</h2>
              <ul>
                {nearby.map((n) => n && (
                  <li><a href={placeHref(n.slug)}>{n.title}</a> — {n.summary}</li>
                ))}
              </ul>
            </section>
          )}
          <p class="discover-maps">
            <a class="btn-outline" href={maps} rel="nofollow noopener" target="_blank">Xem trên Google Maps</a>
          </p>
          <section class="job-block">
            <h2>Nguồn</h2>
            <ul>
              {place.sources.map((s) => (
                <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>
              ))}
            </ul>
          </section>
        </article>

        <aside class="discover-detail-side">
          {related.length > 0 && (
            <section class="panel">
              <h3>Sự kiện liên quan</h3>
              {related.map((e) => (
                <a class="event-mini" href={hrefFor(e)}>
                  <span class="event-mini-date"><strong>SK</strong></span>
                  <div>
                    <strong>{e.title}</strong>
                    <span>{formatEventLine(e.startAt) || e.placeText || ''}</span>
                  </div>
                </a>
              ))}
              <a class="panel-more" href="/su-kien">Tất cả sự kiện →</a>
            </section>
          )}
          {guides.length > 0 && (
            <section class="panel">
              <h3>Cẩm nang</h3>
              {guides.map((g) => (
                <a class="discover-guide" href={guideHref(g.slug)}>
                  <strong>{g.title}</strong>
                  <span>{g.summary}</span>
                </a>
              ))}
            </section>
          )}
          <section class="panel">
            <h3>Hôm nay</h3>
            <p class="muted">Tin động — việc, sự kiện, phòng trọ.</p>
            <p><a href="/viec">Việc làm →</a></p>
            <p><a href="/su-kien">Sự kiện →</a></p>
            <p><a href="/tro">Phòng trọ →</a></p>
          </section>
        </aside>
      </div>
    </div>
  </div>
</Layout>
