---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { WEEK_GUIDE, buildWeekDigest } from '../../../lib/week-digest';

const digest = await buildWeekDigest();
const sections = [digest.events, digest.jobs, digest.rooms];
---
<Layout
  title={`${WEEK_GUIDE.title} — Thái Nguyên Life`}
  active="discover"
  description={digest.blurb}
>
  <div class="page discover-page">
    <div class="wrap guide-wrap">
      <nav class="job-crumb" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <a href="/kham-pha">Khám phá</a>
        <span>›</span>
        <a href="/kham-pha/cam-nang">Cẩm nang</a>
        <span>›</span>
        <span>{WEEK_GUIDE.title}</span>
      </nav>

      <article class="event-detail-main guide-article">
        <div class="event-hero-media">
          <img src={WEEK_GUIDE.cover} alt="" />
          <span class="photo-caption">Ảnh minh họa</span>
        </div>
        <header class="event-detail-head">
          <p class="muted">{WEEK_GUIDE.kicker}</p>
          <h1>{WEEK_GUIDE.title}</h1>
          <p class="event-detail-lead">{digest.blurb}</p>
        </header>

        {sections.map((sec) => (
          <section class="job-block">
            <h2>{sec.title}</h2>
            {sec.items.length === 0 ? (
              <p>{sec.empty}</p>
            ) : (
              sec.items.map((row) => (
                <div class="guide-hit">
                  {row.meta && <p>{row.meta}</p>}
                  <p class="guide-pills">
                    <a class="btn-outline" href={row.href}>{row.title}</a>
                  </p>
                </div>
              ))
            )}
            <p class="guide-pills">
              <a class="btn-outline" href={sec.moreHref}>{sec.moreLabel}</a>
            </p>
          </section>
        ))}

        <section class="job-block">
          <h2>Đọc thêm</h2>
          <p class="guide-pills">
            <a class="btn-outline" href="/kham-pha/cam-nang/cuoi-tuan">Cuối tuần đi đâu</a>
            <a class="btn-outline" href="/kham-pha/cam-nang/sinh-vien-moi">Sinh viên mới đến</a>
            <a class="btn-outline" href="/kham-pha/cam-nang/an-gi">Ăn gì ở Thái Nguyên</a>
          </p>
        </section>
      </article>
    </div>
  </div>
</Layout>
