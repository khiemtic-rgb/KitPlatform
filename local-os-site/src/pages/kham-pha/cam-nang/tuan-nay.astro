---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import ShareListing from '../../../components/ShareListing.astro';
import { WEEK_GUIDE, buildWeekDigest } from '../../../lib/week-digest';
import { discoverBadgeClass, kickerPills } from '../../../lib/discover';
import { articleJsonLd, breadcrumbJsonLd, clipMeta, siteOrigin } from '../../../lib/seo';

const digest = await buildWeekDigest();
const sections = [digest.events, digest.jobs, digest.rooms];
const pills = kickerPills(WEEK_GUIDE.kicker);
const badge = pills[0] || 'Cẩm nang';
---
<Layout
  title={`${WEEK_GUIDE.title} — Thái Nguyên Life`}
  active="discover"
  description={clipMeta(digest.blurb)}
  image={WEEK_GUIDE.cover}
  ogType="article"
  jsonLd={[
    breadcrumbJsonLd(siteOrigin(Astro.site), [
      { name: 'Trang chủ', path: '/' },
      { name: 'Khám phá', path: '/kham-pha' },
      { name: 'Cẩm nang', path: '/kham-pha/cam-nang' },
      { name: WEEK_GUIDE.title, path: WEEK_GUIDE.href },
    ]),
    articleJsonLd({
      origin: siteOrigin(Astro.site),
      path: WEEK_GUIDE.href,
      headline: WEEK_GUIDE.title,
      description: clipMeta(digest.blurb),
      image: WEEK_GUIDE.cover,
    }),
  ]}
>
  <div class="page event-detail-page">
    <div class="wrap">
      <nav class="job-crumb" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a>
        <span>›</span>
        <a href="/kham-pha">Khám phá</a>
        <span>›</span>
        <a href="/kham-pha/cam-nang">Cẩm nang</a>
        <span>›</span>
        <span>{WEEK_GUIDE.title}</span>
      </nav>

      <div class="event-detail-grid">
        <article class="event-detail-main">
          <div class="event-hero-media">
            <img src={WEEK_GUIDE.cover} alt="" />
            <span class={`event-row-badge ${discoverBadgeClass(badge)}`}>{badge}</span>
            <span class="photo-caption">Ảnh minh họa</span>
          </div>
          <header class="event-detail-head">
            <h1>{WEEK_GUIDE.title}</h1>
            <div class="event-detail-pills">
              {pills.map((p) => <span class="room-pill">{p}</span>)}
            </div>
          </header>
          <p class="event-detail-lead">{digest.blurb}</p>

          <dl class="event-quick">
            <div>
              <dt>Sự kiện</dt>
              <dd>{digest.events.total}</dd>
            </div>
            <div>
              <dt>Việc</dt>
              <dd>{digest.jobs.total}</dd>
            </div>
            <div>
              <dt>Phòng</dt>
              <dd>{digest.rooms.total}</dd>
            </div>
          </dl>

          {sections.map((sec) => (
            <section class="job-block">
              <h2>{sec.title}</h2>
              {sec.items.length === 0 ? (
                <p>{sec.empty}</p>
              ) : (
                sec.items.map((row) => (
                  <a class="event-mini" href={row.href}>
                    <span class="event-mini-date"><strong>{sec.id === 'event' ? 'SK' : sec.id === 'job' ? 'VL' : 'PT'}</strong></span>
                    <div>
                      <strong>{row.title}</strong>
                      {row.meta && <span>{row.meta}</span>}
                    </div>
                  </a>
                ))
              )}
              <a class="panel-more" href={sec.moreHref}>{sec.moreLabel} →</a>
            </section>
          ))}
        </article>

        <aside class="event-detail-side">
          <section class="event-reg-card">
            <h3>Xem tin đang mở</h3>
            <p>Gọi thẳng số trên tin. Giá phòng hỏi khi gọi.</p>
            <a class="btn-green event-reg-go" href="/su-kien">Sự kiện</a>
            <a class="btn-outline event-reg-src" href="/viec">Việc làm</a>
            <a class="btn-outline event-reg-src" href="/tro">Phòng trọ</a>
            <ul>
              <li>Gọi số trên tin việc và phòng</li>
              <li>Giá phòng hỏi khi gọi</li>
            </ul>
          </section>

          <section class="panel">
            <h3>Đọc thêm</h3>
            <a class="event-mini" href="/kham-pha/cam-nang/cuoi-tuan">
              <span class="event-mini-date"><strong>CN</strong></span>
              <div>
                <strong>Cuối tuần đi đâu</strong>
                <span>Gợi ý vừa sức quanh Thái Nguyên</span>
              </div>
            </a>
            <a class="event-mini" href="/kham-pha/cam-nang/an-gi">
              <span class="event-mini-date"><strong>CN</strong></span>
              <div>
                <strong>Ăn gì ở Thái Nguyên</strong>
                <span>Chè Tân Cương, chè La Bằng</span>
              </div>
            </a>
            <a class="event-mini" href="/kham-pha/cam-nang/sinh-vien-moi">
              <span class="event-mini-date"><strong>CN</strong></span>
              <div>
                <strong>Sinh viên mới đến</strong>
                <span>Việc, phòng, cuối tuần</span>
              </div>
            </a>
            <a class="panel-more" href="/kham-pha/cam-nang">Cẩm nang →</a>
          </section>

          <ShareListing />
        </aside>
      </div>
    </div>
  </div>
</Layout>
