---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Đăng tin — Thái Nguyên Life" active="publish" description="Đăng tin miễn phí, hai bước. Không cần tài khoản.">
  <section class="job-hero">
    <div class="wrap pub-hero">
      <div>
        <h1 id="pub-title">Đăng tin</h1>
        <p id="pub-lead" class="job-hero-lead">Miễn phí · Không cần tài khoản · Hai bước</p>
      </div>
      <button type="button" class="pub-preview-btn" id="btn-preview">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
        Xem trước tin đăng
      </button>
    </div>
  </section>

  <div class="page pub-page">
    <div class="wrap pub-layout">
      <div class="pub-main">
        <ol class="pub-steps" id="pub-steps" aria-label="Các bước đăng tin">
          <li class="is-on" data-step="1"><span>1</span> Tin đăng</li>
          <li data-step="2"><span>2</span> Đăng tin</li>
        </ol>

        <form id="job-form" class="pub-form" autocomplete="on" novalidate>
          <section class="pub-card" data-pane="1">
            <h2>Loại tin</h2>
            <div class="pub-kinds" id="step-kind">
              <button class="pub-kind is-on" type="button" data-kind="job">
                <span class="pub-kind-ico job" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </span>
                <strong>Việc làm</strong>
                <em>Part-time, full-time, thực tập</em>
              </button>
              <button class="pub-kind" type="button" data-kind="event">
                <span class="pub-kind-ico event" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                </span>
                <strong>Sự kiện</strong>
                <em>Workshop, lễ hội, ngày hội</em>
              </button>
              <button class="pub-kind" type="button" data-kind="room">
                <span class="pub-kind-ico room" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z"/></svg>
                </span>
                <strong>Phòng trọ</strong>
                <em>Giá hỏi khi gọi</em>
              </button>
            </div>
          </section>

          <section class="pub-card" data-pane="1" data-for="job">
            <h2>Hình thức</h2>
            <div class="pub-chips" id="templates">
              <button class="chip is-on" type="button" data-template="part_time">Part-time</button>
              <button class="chip" type="button" data-template="full_time">Full-time</button>
              <button class="chip" type="button" data-template="intern">Thực tập</button>
            </div>
            <h2 class="pub-subhead">Ngành</h2>
            <div class="pub-chips" id="categories">
              <button class="chip" type="button" data-cat="phuc_vu">Phục vụ</button>
              <button class="chip" type="button" data-cat="ban_hang">Bán hàng</button>
              <button class="chip" type="button" data-cat="gia_su">Giáo viên</button>
              <button class="chip" type="button" data-cat="van_phong">Văn phòng</button>
              <button class="chip" type="button" data-cat="khac">Khác</button>
            </div>
          </section>

          <section class="pub-card" data-pane="1" data-for="event">
            <h2>Loại sự kiện</h2>
            <div class="pub-chips" id="event-cats">
              <button class="chip is-on" type="button" data-event-cat="culture">Văn hóa</button>
              <button class="chip" type="button" data-event-cat="sport">Thể thao</button>
              <button class="chip" type="button" data-event-cat="tourism">Du lịch</button>
              <button class="chip" type="button" data-event-cat="fair">Hội chợ</button>
              <button class="chip" type="button" data-event-cat="workshop">Workshop</button>
              <button class="chip" type="button" data-event-cat="other">Khác</button>
            </div>
          </section>

          <section class="pub-card" data-pane="1" data-for="room">
            <h2>Loại phòng</h2>
            <div class="pub-chips" id="room-types">
              <button class="chip is-on" type="button" data-room="private">Phòng riêng</button>
              <button class="chip" type="button" data-room="shared">Ở ghép</button>
              <button class="chip" type="button" data-room="transfer">Chuyển nhượng</button>
            </div>
            <p class="muted">Giá hỏi khi gọi — không cần ghi trên tin.</p>
          </section>

          <section class="pub-card" data-pane="1">
            <h2>Nội dung tin</h2>
            <div class="pub-grid">
              <label class="pub-field pub-span-2">Tiêu đề tin đăng
                <input name="title" required maxlength="100" placeholder="VD: Tuyển phục vụ part-time quán nướng" />
                <span class="pub-count" data-count="title">0/100</span>
              </label>
              <label class="pub-field" data-for="job,event">Địa điểm
                <span class="pub-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/></svg>
                  <input name="placeText" required maxlength="160" placeholder="Số nhà, đường, phường / gần ĐHTN" />
                </span>
              </label>
              <label class="pub-field pub-span-2" data-for="room" hidden>Địa chỉ phòng
                <span class="pub-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/></svg>
                  <input name="placeTextRoom" maxlength="160" placeholder="Số nhà, đường, phường / gần trường" />
                </span>
              </label>
              <label class="pub-field" data-for="job">Thời gian làm việc
                <span class="pub-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>
                  <input name="workingTime" maxlength="120" placeholder="VD: 17h–22h, T2–T6" />
                </span>
              </label>
              <label class="pub-field" data-for="event" hidden>Bắt đầu
                <input name="startAt" type="datetime-local" />
              </label>
              <label class="pub-field" data-for="event" hidden>Kết thúc (tuỳ chọn)
                <input name="endAt" type="datetime-local" />
              </label>
              <label class="pub-field">Người liên hệ
                <input name="contactName" required maxlength="80" placeholder="Tên chủ / quản lý / ban tổ chức" />
              </label>
              <label class="pub-field" data-for="job">Số lượng tuyển dụng
                <span class="pub-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="3"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                  <input name="quantity" maxlength="40" placeholder="VD: 3 bạn (tuỳ chọn)" />
                </span>
              </label>
              <label class="pub-field pub-span-2" data-for="job">Thu nhập (tuỳ chọn)
                <span class="pub-input">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/></svg>
                  <input name="salaryText" maxlength="80" placeholder="VD: 25k/giờ hoặc 4–5 triệu/tháng" />
                </span>
              </label>
              <label class="pub-field pub-span-2" data-for="event" hidden>Link đăng ký (tuỳ chọn)
                <input name="registrationUrl" maxlength="240" placeholder="https://…" />
              </label>
            </div>
          </section>

          <section class="pub-card" data-pane="1">
            <h2 id="detail-title">Yêu cầu (tuỳ chọn)</h2>
            <label class="pub-field">
              <textarea name="requirements" rows="4" maxlength="500" placeholder="Nam/nữ, ca tối, không cần kinh nghiệm…"></textarea>
              <span class="pub-count" data-count="requirements">0/500</span>
            </label>
            <p class="muted">Bỏ trống cũng được — gửi được ngay.</p>
          </section>

          <section class="pub-card" data-pane="2" hidden>
            <h2>Số điện thoại</h2>
            <label class="pub-field">Số của bạn — người xem sẽ gọi số này
              <input name="phone" required inputmode="tel" maxlength="16" placeholder="09xxxxxxxx" />
            </label>
            <p class="muted" id="draft-hint"></p>
            <label class="pub-check">
              <input type="checkbox" name="agree" required />
              <span>Tôi đồng ý với <a href="/thong-tin/quy-dinh">quy định sử dụng</a>.</span>
            </label>
          </section>

          <p class="err" id="form-err" hidden></p>
          <div class="pub-actions" data-pane-actions>
            <button type="button" class="btn-outline" id="btn-draft">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 20h16M6 20V8l6-4 6 4v12"/><path d="M10 20v-6h4v6"/></svg>
              Lưu nháp
            </button>
            <button type="button" class="btn-outline" id="btn-back" hidden>← Quay lại</button>
            <button type="button" class="btn-green" id="btn-next">Tiếp: đăng tin →</button>
            <button type="submit" class="btn-green" id="btn-submit" hidden>Đăng tin</button>
          </div>
        </form>

        <div id="success" class="pub-card" hidden>
          <h2>Đã nhận tin</h2>
          <p id="review-note" class="muted"></p>
          <label class="pub-field">Nội dung chia sẻ
            <textarea id="share-text" rows="12" readonly></textarea>
          </label>
          <button type="button" class="btn-green" id="btn-copy">Copy nội dung</button>
          <h2 style="margin-top:22px">Gợi ý group để chia sẻ</h2>
          <div id="groups"></div>
        </div>
      </div>

      <aside class="pub-side">
        <section class="pub-card">
          <h3>Mẹo giúp tin đăng hiệu quả hơn</h3>
          <ul class="pub-tips" id="pub-tips"></ul>
          <p class="pub-protip">Viết rõ chỗ làm / chỗ ở và số liên hệ để người xem gọi được ngay.</p>
        </section>
        <section class="pub-card">
          <h3>Lợi ích khi đăng tin</h3>
          <ul class="pub-benefits">
            <li><strong>Miễn phí</strong> — không mất phí đăng tin.</li>
            <li><strong>Đúng người</strong> — tin hiện cho người đang tìm ở Thái Nguyên.</li>
            <li><strong>Nhanh</strong> — hai bước, khoảng một phút.</li>
            <li><strong>Chia sẻ thêm</strong> — copy nội dung nếu muốn đăng lên group.</li>
          </ul>
        </section>
      </aside>
    </div>
  </div>

  <dialog class="pub-dialog" id="preview-dialog">
    <form method="dialog" class="pub-dialog-inner">
      <h2>Xem trước tin đăng</h2>
      <p class="muted">Đây là bản bạn đang điền.</p>
      <dl id="preview-body" class="pub-preview"></dl>
      <button class="btn-green" value="close">Đóng</button>
    </form>
  </dialog>
</Layout>

<script>
  import { publishJob, trackShare } from '../lib/api';

  const DRAFT_KEY = 'tnlife-listing-draft';
  const form = document.getElementById('job-form') as HTMLFormElement;
  const success = document.getElementById('success') as HTMLElement;
  const errEl = document.getElementById('form-err') as HTMLElement;
  const draftHint = document.getElementById('draft-hint') as HTMLElement;
  const shareTextEl = document.getElementById('share-text') as HTMLTextAreaElement;
  const groupsEl = document.getElementById('groups') as HTMLElement;
  const reviewNote = document.getElementById('review-note') as HTMLElement;
  const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
  const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
  const previewDlg = document.getElementById('preview-dialog') as HTMLDialogElement;
  const previewBody = document.getElementById('preview-body') as HTMLElement;

  let step = 1;
  let kind: 'job' | 'event' | 'room' = 'job';
  let template = 'part_time';
  let roomType = 'private';
  let eventCat = 'culture';
  let category = '';
  let listingId = '';

  const kindLabel: Record<string, string> = {
    job: 'Việc làm',
    event: 'Sự kiện',
    room: 'Phòng trọ',
  };
  const templateLabel: Record<string, string> = {
    part_time: 'Part-time',
    full_time: 'Full-time',
    intern: 'Thực tập',
  };
  const catLabel: Record<string, string> = {
    phuc_vu: 'Phục vụ',
    ban_hang: 'Bán hàng',
    gia_su: 'Giáo viên',
    van_phong: 'Văn phòng',
    khac: 'Khác',
  };
  const roomLabel: Record<string, string> = {
    private: 'Phòng riêng',
    shared: 'Ở ghép',
    transfer: 'Chuyển nhượng',
  };
  const eventLabel: Record<string, string> = {
    culture: 'Văn hóa',
    sport: 'Thể thao',
    tourism: 'Du lịch',
    fair: 'Hội chợ',
    workshop: 'Workshop',
    festival: 'Lễ hội',
    community: 'Cộng đồng',
    other: 'Khác',
  };
  const leads: Record<string, string> = {
    job: 'Miễn phí · Không cần tài khoản · Hai bước',
    event: 'Miễn phí · Không cần tài khoản · Hai bước',
    room: 'Miễn phí · Không cần tài khoản · Hai bước',
  };
  const tips: Record<string, string[]> = {
    job: [
      'Tiêu đề rõ: việc gì, ca nào, khu nào.',
      'Địa điểm cụ thể — số nhà hoặc gần trường / quán.',
      'Thu nhập thật nếu có; để trống còn hơn ghi sai.',
      'Số liên hệ đúng để người xem gọi được.',
    ],
    event: [
      'Tên sự kiện + ngày giờ thật, chưa hết hạn.',
      'Địa điểm cụ thể — hội trường, sân, đường.',
      'Link đăng ký gốc nếu có; để trống nếu chỉ gọi SĐT.',
      'Số ban tổ chức để người xem gọi được.',
    ],
    room: [
      'Địa chỉ rõ — số nhà / gần trường.',
      'Chọn loại phòng: riêng, ghép, chuyển nhượng.',
      'Giá hỏi khi gọi — không cần ghi trên tin.',
      'Số chủ nhà để người xem gọi được.',
    ],
  };

  function showErr(msg: string) {
    errEl.hidden = false;
    errEl.textContent = msg;
  }

  function clearErr() {
    errEl.hidden = true;
    errEl.textContent = '';
  }

  function data() {
    return new FormData(form);
  }

  function field(name: string) {
    return String(data().get(name) || '').trim();
  }

  function placeValue() {
    return kind === 'room' ? field('placeTextRoom') || field('placeText') : field('placeText');
  }

  function applies(el: HTMLElement, k: string) {
    const raw = el.dataset.for;
    if (!raw) return true;
    return raw.split(',').map((s) => s.trim()).includes(k);
  }

  function setKind(next: 'job' | 'event' | 'room') {
    kind = next;
    document.querySelectorAll<HTMLButtonElement>('#step-kind [data-kind]').forEach((b) => {
      b.classList.toggle('is-on', b.dataset.kind === kind);
    });
    document.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => {
      const on = applies(el, kind);
      if (el.hasAttribute('data-pane') && Number(el.dataset.pane) !== step) {
        el.hidden = true;
        return;
      }
      el.hidden = !on;
    });
    const title = document.getElementById('pub-title');
    const lead = document.getElementById('pub-lead');
    const detail = document.getElementById('detail-title');
    const tipsEl = document.getElementById('pub-tips');
    if (title) title.textContent = `Đăng tin ${kindLabel[kind].toLowerCase()}`;
    if (lead) lead.textContent = leads[kind];
    if (detail) {
      detail.textContent = kind === 'room' ? 'Mô tả / tiện nghi (tuỳ chọn)' : kind === 'event' ? 'Mô tả (tuỳ chọn)' : 'Yêu cầu (tuỳ chọn)';
    }
    const req = form.querySelector<HTMLTextAreaElement>('[name="requirements"]');
    if (req) {
      req.placeholder = kind === 'room'
        ? 'Điện nước, chỗ để xe, giờ giấc… — không ghi giá.'
        : kind === 'event'
          ? 'Đối tượng, lịch trình ngắn, cần đăng ký trước…'
          : 'Nam/nữ, ca tối, không cần kinh nghiệm…';
    }
    const titleInput = form.querySelector<HTMLInputElement>('[name="title"]');
    if (titleInput) {
      titleInput.placeholder = kind === 'room'
        ? 'VD: Phòng gần ĐHTN, 1 người'
        : kind === 'event'
          ? 'VD: Workshop CV cho sinh viên ICTU'
          : 'VD: Tuyển phục vụ part-time quán nướng';
    }
    if (tipsEl) tipsEl.innerHTML = tips[kind].map((t) => `<li>${t}</li>`).join('');
  }

  function renderCounts() {
    const title = form.querySelector<HTMLInputElement>('[name="title"]');
    const req = form.querySelector<HTMLTextAreaElement>('[name="requirements"]');
    const t = document.querySelector('[data-count="title"]');
    const r = document.querySelector('[data-count="requirements"]');
    if (t && title) t.textContent = `${title.value.length}/100`;
    if (r && req) r.textContent = `${req.value.length}/500`;
  }

  function setStep(n: number) {
    step = n;
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach((el) => {
      const paneOn = Number(el.dataset.pane) === n;
      const forOn = applies(el, kind);
      el.hidden = !(paneOn && forOn);
    });
    document.querySelectorAll('#pub-steps li').forEach((li) => {
      const s = Number((li as HTMLElement).dataset.step);
      li.classList.toggle('is-on', s === n);
      li.classList.toggle('is-done', s < n);
    });
    btnBack.hidden = n === 1;
    btnNext.hidden = n === 2;
    btnSubmit.hidden = n !== 2;
    clearErr();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function validateStep(n: number): boolean {
    clearErr();
    if (n === 1) {
      if (!field('title') || !placeValue() || !field('contactName')) {
        showErr('Điền tiêu đề, địa điểm và người liên hệ.');
        return false;
      }
      if (kind === 'job' && !field('workingTime')) {
        showErr('Việc làm cần thời gian làm việc.');
        return false;
      }
      if (kind === 'event' && !field('startAt')) {
        showErr('Sự kiện cần ngày giờ bắt đầu.');
        return false;
      }
    }
    if (n === 2) {
      if (!field('phone')) {
        showErr('Nhập số điện thoại liên hệ.');
        return false;
      }
      if (!form.querySelector<HTMLInputElement>('[name="agree"]')?.checked) {
        showErr('Cần đồng ý quy định sử dụng.');
        return false;
      }
    }
    return true;
  }

  function saveDraft() {
    const d = {
      kind,
      template,
      roomType,
      eventCat,
      category,
      title: field('title'),
      placeText: field('placeText'),
      placeTextRoom: field('placeTextRoom'),
      workingTime: field('workingTime'),
      startAt: field('startAt'),
      endAt: field('endAt'),
      registrationUrl: field('registrationUrl'),
      contactName: field('contactName'),
      quantity: field('quantity'),
      salaryText: field('salaryText'),
      requirements: field('requirements'),
      phone: field('phone'),
    };
    localStorage.setItem(DRAFT_KEY, JSON.stringify(d));
  }

  function loadDraft() {
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      if (!raw) return;
      const d = JSON.parse(raw) as Record<string, unknown>;
      for (const name of [
        'title', 'placeText', 'placeTextRoom', 'workingTime', 'startAt', 'endAt',
        'registrationUrl', 'contactName', 'quantity', 'salaryText', 'requirements', 'phone',
      ]) {
        const el = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
        if (el && typeof d[name] === 'string') el.value = d[name] as string;
      }
      if (d.kind === 'job' || d.kind === 'event' || d.kind === 'room') kind = d.kind;
      if (typeof d.template === 'string') template = d.template;
      if (typeof d.roomType === 'string') roomType = d.roomType;
      if (typeof d.eventCat === 'string') eventCat = d.eventCat;
      if (typeof d.category === 'string') category = d.category;
      else if (Array.isArray(d.categories) && typeof d.categories[0] === 'string') category = d.categories[0];
      document.querySelectorAll('#templates .chip').forEach((c) => {
        c.classList.toggle('is-on', (c as HTMLButtonElement).dataset.template === template);
      });
      document.querySelectorAll('#categories .chip').forEach((el) => {
        el.classList.toggle('is-on', (el as HTMLButtonElement).dataset.cat === category);
      });
      document.querySelectorAll('#room-types .chip').forEach((c) => {
        c.classList.toggle('is-on', (c as HTMLButtonElement).dataset.room === roomType);
      });
      document.querySelectorAll('#event-cats .chip').forEach((c) => {
        c.classList.toggle('is-on', (c as HTMLButtonElement).dataset.eventCat === eventCat);
      });
      renderCounts();
    } catch {
      /* ignore broken draft */
    }
  }

  function previewRows(): [string, string][] {
    const rows: [string, string][] = [
      ['Loại', kindLabel[kind]],
      ['Tiêu đề', field('title') || '—'],
      ['Địa điểm', placeValue() || '—'],
      ['Người liên hệ', field('contactName') || '—'],
      ['SĐT', field('phone') || '—'],
    ];
    if (kind === 'job') {
      rows.splice(1, 0, ['Hình thức', [templateLabel[template], category ? catLabel[category] || category : ''].filter(Boolean).join(' · ')]);
      rows.push(['Thời gian', field('workingTime') || '—'], ['Số lượng', field('quantity') || '—'], ['Thu nhập', field('salaryText') || '—']);
    }
    if (kind === 'event') {
      rows.splice(1, 0, ['Nhóm', eventLabel[eventCat] || eventCat]);
      rows.push(['Bắt đầu', field('startAt') || '—'], ['Kết thúc', field('endAt') || '—'], ['Link đăng ký', field('registrationUrl') || '—']);
    }
    if (kind === 'room') {
      rows.splice(1, 0, ['Loại phòng', roomLabel[roomType] || roomType]);
      rows.push(['Giá', 'Liên hệ khi gọi']);
    }
    rows.push(['Chi tiết', field('requirements') || '—']);
    return rows;
  }

  document.getElementById('step-kind')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-kind]');
    if (!btn?.dataset.kind) return;
    if (btn.dataset.kind === 'job' || btn.dataset.kind === 'event' || btn.dataset.kind === 'room') {
      setKind(btn.dataset.kind);
      saveDraft();
    }
  });

  document.getElementById('templates')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-template]');
    if (!btn) return;
    template = btn.dataset.template || 'part_time';
    document.querySelectorAll('#templates .chip').forEach((c) => c.classList.toggle('is-on', c === btn));
  });

  document.getElementById('categories')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cat]');
    if (!btn) return;
    category = btn.dataset.cat === category ? '' : (btn.dataset.cat || '');
    document.querySelectorAll('#categories .chip').forEach((c) => {
      c.classList.toggle('is-on', (c as HTMLButtonElement).dataset.cat === category);
    });
  });

  document.getElementById('room-types')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-room]');
    if (!btn) return;
    roomType = btn.dataset.room || 'private';
    document.querySelectorAll('#room-types .chip').forEach((c) => c.classList.toggle('is-on', c === btn));
  });

  document.getElementById('event-cats')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-event-cat]');
    if (!btn) return;
    eventCat = btn.dataset.eventCat || 'culture';
    document.querySelectorAll('#event-cats .chip').forEach((c) => c.classList.toggle('is-on', c === btn));
  });

  form.addEventListener('input', () => {
    renderCounts();
    saveDraft();
  });

  btnNext.addEventListener('click', () => {
    if (!validateStep(step)) return;
    setStep(Math.min(2, step + 1));
  });
  btnBack.addEventListener('click', () => setStep(Math.max(1, step - 1)));

  document.getElementById('btn-draft')?.addEventListener('click', () => {
    saveDraft();
    clearErr();
    draftHint.textContent = 'Đã lưu nháp trên máy này. Chưa gửi lên server.';
  });

  document.getElementById('btn-preview')?.addEventListener('click', () => {
    previewBody.innerHTML = previewRows()
      .map(([k, v]) => `<div><dt>${k}</dt><dd>${v.replace(/</g, '&lt;')}</dd></div>`)
      .join('');
    previewDlg.showModal();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validateStep(2)) return;
    try {
      const result = await publishJob({
        phone: field('phone'),
        kind,
        template: kind === 'job' ? template : kind === 'event' ? eventCat : undefined,
        categories: kind === 'job' && category ? [category] : undefined,
        title: field('title'),
        quantity: kind === 'job' ? field('quantity') || undefined : undefined,
        placeText: placeValue(),
        workingTime: kind === 'job' ? field('workingTime') : undefined,
        salaryText: kind === 'job' ? field('salaryText') || undefined : undefined,
        requirements: field('requirements') || undefined,
        contactName: field('contactName'),
        roomType: kind === 'room' ? roomType : undefined,
        startAt: kind === 'event' ? field('startAt') || undefined : undefined,
        endAt: kind === 'event' ? field('endAt') || undefined : undefined,
        registrationUrl: kind === 'event' ? field('registrationUrl') || undefined : undefined,
      });
      listingId = result.listing.id;
      localStorage.removeItem(DRAFT_KEY);
      form.hidden = true;
      document.getElementById('pub-steps')!.hidden = true;
      document.getElementById('btn-preview')!.hidden = true;
      success.hidden = false;
      shareTextEl.value = result.shareText;
      reviewNote.textContent = 'Đã nhận tin. Chúng tôi sẽ xem và đăng lên site sớm.';
      const topic = kindLabel[result.listing.kind] || kindLabel[kind];
      groupsEl.innerHTML = result.groups.length
        ? result.groups
            .map(
              (g) =>
                `<div class="group-row"><div><strong>${g.name}</strong><div class="muted">${g.url}</div></div>
                 <div class="group-actions">
                   <a class="btn" data-open="${g.id}" href="${g.url}" target="_blank" rel="noopener">Mở group</a>
                   <button type="button" class="btn" data-copy-group="${g.id}">Copy link</button>
                 </div></div>`,
            )
            .join('')
        : `<p class="muted">Chưa có group ${topic.toLowerCase()} gợi ý. Copy nội dung nếu muốn chia sẻ thêm.</p>`;
    } catch (err) {
      showErr(err instanceof Error ? err.message : 'Không gửi được tin.');
    }
  });

  document.getElementById('btn-copy')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(shareTextEl.value);
    if (listingId) void trackShare(listingId, null, 'copy');
    (document.getElementById('btn-copy') as HTMLButtonElement).textContent = 'Đã copy';
  });

  groupsEl.addEventListener('click', async (e) => {
    const open = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-open]');
    const copy = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy-group]');
    if (open && listingId) void trackShare(listingId, open.dataset.open || null, 'open');
    if (copy) {
      const row = copy.closest('.group-row');
      const url = row?.querySelector('.muted')?.textContent || '';
      await navigator.clipboard.writeText(url);
      if (listingId) void trackShare(listingId, copy.dataset.copyGroup || null, 'copy');
      copy.textContent = 'Đã copy';
    }
  });

  loadDraft();
  setKind(kind);
  setStep(1);
  renderCounts();
</script>
