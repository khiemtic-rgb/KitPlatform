---
import Layout from '../layouts/Layout.astro';
import TrendCard from '../components/TrendCard.astro';
import {
  coverFor,
  formatClock,
  formatEventLine,
  groupCover,
  groupHint,
  hrefFor,
  isRecent,
  listGroups,
  listListings,
  orgInitial,
} from '../lib/api';
import { featuredGuides, featuredPlaces, guideHref, placeHref } from '../lib/discover';
import { jobPay } from '../lib/job-filters';

const homePlaces = featuredPlaces();
const homeGuides = featuredGuides().slice(0, 3);

const q = Astro.url.searchParams.get('q') ?? '';
const [jobs, events, rooms, groups] = await Promise.all([
  listListings('job', q || undefined),
  listListings('event', q || undefined),
  listListings('room', q || undefined),
  listGroups(),
]);

const picked: typeof jobs = [];
for (const list of [jobs, events, rooms]) {
  if (list[0]) picked.push(list[0]);
}
for (const item of [...jobs, ...events, ...rooms]) {
  if (picked.length >= 8) break;
  if (!picked.some((x) => x.id === item.id)) picked.push(item);
}
const latestJobs = jobs.slice(0, 4);
const upcoming = [...events]
  .sort((a, b) => Number(Boolean(b.startAt)) - Number(Boolean(a.startAt)))
  .slice(0, 4);
const featuredRooms = rooms.slice(0, 4);
const liveCount = jobs.length + events.length + rooms.length;
---
<Layout title="Thái Nguyên Life – Hiểu Thái Nguyên, sống trọn trải nghiệm" description="Việc làm, sự kiện, phòng trọ và khám phá Thái Nguyên.">
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>Hôm nay ở <em>Thái Nguyên</em> có gì đáng để bạn quan tâm?</h1>
        <p class="hero-sub">Việc làm, sự kiện, phòng trọ và khám phá quanh Thái Nguyên.</p>
      </div>
      <div class="hero-find" id="tim">
        <form class="search-bar hero-search" method="get" action="/">
          <input
            type="search"
            name="q"
            value={q}
            placeholder="Bạn đang tìm gì? Ví dụ: việc làm part-time, phòng trọ, sự kiện..."
          />
          <button type="submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
            <span class="search-label">Tìm kiếm</span>
          </button>
        </form>
        <div class="quick">
          <a class="pill" href="/viec?q=part-time">
            <svg class="pill-ico job" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            việc làm part-time
          </a>
          <a class="pill" href="/tro?q=trường">
            <svg class="pill-ico room" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z"/></svg>
            phòng trọ gần trường
          </a>
          <a class="pill" href="/su-kien">
            <svg class="pill-ico event" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
            sự kiện cuối tuần
          </a>
          <a class="pill" href="/su-kien?cat=culture">
            <svg class="pill-ico workshop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
            văn hóa
          </a>
          <a class="pill" href="/su-kien?cat=sport">
            <svg class="pill-ico event" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            thể thao
          </a>
          <a class="pill" href="/su-kien?cat=fair">
            <svg class="pill-ico offer" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h16v9H4zM4 10l2-4h12l2 4"/></svg>
            hội chợ
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap cat-wrap">
    <nav class="cat-bar" aria-label="Danh mục">
      <a class="cat-item" href="/viec">
        <span class="cat-ico job" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg>
        </span>
        <strong>Việc làm</strong>
        <span>{jobs.length} tin</span>
      </a>
      <a class="cat-item" href="/su-kien">
        <span class="cat-ico event" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        </span>
        <strong>Sự kiện</strong>
        <span>{events.length} sự kiện</span>
      </a>
      <a class="cat-item" href="/tro">
        <span class="cat-ico room" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z"/></svg>
        </span>
        <strong>Phòng trọ</strong>
        <span>{rooms.length} tin</span>
      </a>
      <a class="cat-item" href="#cong-dong">
        <span class="cat-ico community" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="2.4"/><circle cx="15.5" cy="8.4" r="2"/><path d="M4.8 17.2c.4-2.4 2.4-3.8 4.2-3.8s3.8 1.4 4.2 3.8"/><path d="M13.2 13.8c1.6-.2 3.4 1 3.8 3.4"/></svg>
        </span>
        <strong>Cộng đồng</strong>
        <span>{groups.length} nhóm</span>
      </a>
    </nav>
  </div>

  <div class="page">
    <div class="wrap">
      <div class="section-head trend-head">
        <h2>
          <span class="trend-title-ico" aria-hidden="true">🔥</span>
          Đang được quan tâm
        </h2>
        <a class="see-all" href="/viec">Xem tất cả →</a>
      </div>
      <div class="trend-scroller">
        <div class="trend-track" data-trend-track>
          {picked.map((item, i) => <TrendCard item={item} index={i} />)}
        </div>
        {picked.length > 3 && (
          <>
            <button type="button" class="trend-nav trend-prev" data-trend-prev aria-label="Tin trước">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <button type="button" class="trend-nav trend-next" data-trend-next aria-label="Tin sau">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </button>
          </>
        )}
      </div>
      {picked.length === 0 && <p class="empty">Đang cập nhật tin.</p>}

      <div class="section-head" style="margin-top:28px">
        <h2>Khám phá Thái Nguyên</h2>
        <a class="see-all" href="/kham-pha">Xem tất cả →</a>
      </div>
      <div class="discover-home">
        {homePlaces.map((p) => (
          <a class="discover-card" href={placeHref(p.slug)}>
            <div class="discover-card-photo">
              <img src={p.cover} alt="" />
              <span class="photo-caption">Ảnh minh họa</span>
            </div>
            <div class="discover-card-body">
              <h3>{p.title}</h3>
              <p>{p.summary}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="discover-guides" style="margin:-12px 0 28px">
        <a class="discover-guide is-live" href="/kham-pha/cam-nang">
          <strong>Cẩm nang Thái Nguyên</strong>
          <span>Cuối tuần đi đâu, đang tuyển gì, phòng nào gần trường.</span>
        </a>
        {homeGuides.map((g) => (
          <a class="discover-guide" href={guideHref(g.slug)}>
            <strong>{g.title}</strong>
            <span>{g.summary}</span>
          </a>
        ))}
      </div>

      <div class="trio equal">
        <section class="panel">
          <div class="section-head tight">
            <h2>Việc làm mới nhất</h2>
            <a class="see-all" href="/viec">Xem tất cả →</a>
          </div>
          <div class="home-col-list">
          {latestJobs.map((item, i) => (
            <a class="job-line" href={hrefFor(item)}>
              <span class={`job-ico c${i % 3}`}>{orgInitial(item)}</span>
              <div class="job-body">
                <div class="job-title">
                  <strong>{item.title}</strong>
                  {isRecent(item.publishedAt || item.lastCheckedAt) && <span class="new-badge">Mới</span>}
                </div>
                {item.organizationName && <div class="job-meta">{item.organizationName}</div>}
                {item.placeText && (
                  <div class="job-meta">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
                    {item.placeText}
                  </div>
                )}
                <div class="job-pay">Lương: {jobPay(item)}</div>
              </div>
            </a>
          ))}
          {latestJobs.length === 0 && <p class="empty">Đang cập nhật việc làm.</p>}
          </div>
          <a class="panel-more" href="/viec">Xem tất cả việc làm →</a>
        </section>

        <section class="panel">
          <div class="section-head tight">
            <h2>Sự kiện sắp diễn ra</h2>
            <a class="see-all" href="/su-kien">Xem tất cả →</a>
          </div>
          <div class="home-col-list">
          {upcoming.map((item, i) => (
            <a class="ev" href={hrefFor(item)}>
              <span class="ev-thumb-wrap">
                <img class="ev-thumb" src={coverFor('event', i)} alt="Ảnh minh họa" />
                <span class="photo-caption">Minh họa</span>
              </span>
              <div class="ev-body">
                <strong>{item.title}</strong>
                {item.placeText && (
                  <div class="job-meta">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
                    {item.placeText}
                  </div>
                )}
                <div class="job-meta">{formatEventLine(item.startAt) || formatClock(item.startAt) || 'Xem ngày trên tin'}</div>
                <span class="mini-badge event">Sự kiện</span>
              </div>
            </a>
          ))}
          {upcoming.length === 0 && <p class="empty">Đang cập nhật sự kiện.</p>}
          </div>
          <a class="panel-more" href="/su-kien">Xem tất cả sự kiện →</a>
        </section>

        <section class="panel">
          <div class="section-head tight">
            <h2>Phòng trọ nổi bật</h2>
            <a class="see-all" href="/tro">Xem tất cả →</a>
          </div>
          <div class="home-col-list">
          {featuredRooms.map((item, i) => (
            <a class="ev" href={hrefFor(item)}>
              <span class="ev-thumb-wrap">
                <img class="ev-thumb" src={coverFor('room', i)} alt="Ảnh minh họa" />
                <span class="photo-caption">Minh họa</span>
              </span>
              <div class="ev-body">
                <strong>{item.title}</strong>
                {item.placeText && (
                  <div class="job-meta">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
                    {item.placeText}
                  </div>
                )}
                <div class="job-pay">Giá thuê: liên hệ</div>
              </div>
            </a>
          ))}
          {featuredRooms.length === 0 && <p class="empty">Đang cập nhật phòng trọ.</p>}
          </div>
          <a class="panel-more" href="/tro">Xem tất cả phòng trọ →</a>
        </section>
      </div>
    </div>
  </div>

  <section class="post-band">
    <div class="wrap post-band-grid">
      <div class="post-band-copy">
        <h2>Đăng tin dễ dàng – Chia sẻ nhanh chóng</h2>
        <ul>
          <li><span>✓</span> Đăng tin miễn phí</li>
          <li><span>✓</span> Tiếp cận người quanh Thái Nguyên</li>
          <li><span>✓</span> Không mất phí khi xem và liên hệ</li>
        </ul>
        <div class="post-band-actions">
          <a class="btn-green" href="/dang-tin">+ Đăng tin ngay</a>
          <a class="btn btn-outline" href="/dang-tin">Hướng dẫn đăng tin</a>
        </div>
      </div>
      <div class="post-band-art" aria-hidden="true">
        <img class="cta-hills" src="/trend/cta-hills.jpg" alt="" />
        <img class="cta-phone" src="/trend/cta-phone.jpg" alt="" />
      </div>
    </div>
  </section>

  <div class="page">
    <div class="wrap">
      <section id="cong-dong">
        <div class="section-head">
          <h2>Cộng đồng quanh bạn</h2>
        </div>
        <div class="comm-scroller">
          <div class="comm-track" data-comm-track>
            {groups.map((g, i) => (
              <article class="comm-card">
                <img src={groupCover(i)} alt="" />
                <div class="comm-card-body">
                  <strong>{g.name}</strong>
                  <span>{groupHint(g)}</span>
                  <a class="btn-green comm-join" href={g.url} target="_blank" rel="noopener">Tham gia</a>
                </div>
              </article>
            ))}
          </div>
          {groups.length > 3 && (
            <>
              <button type="button" class="trend-nav trend-prev" data-comm-prev aria-label="Group trước">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
              </button>
              <button type="button" class="trend-nav trend-next" data-comm-next aria-label="Group sau">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              </button>
            </>
          )}
        </div>
        {groups.length === 0 && <p class="empty">Đang cập nhật cộng đồng.</p>}
        {groups.length > 0 && <p class="comm-note">Nhóm quanh Thái Nguyên — mở và tham gia khi muốn.</p>}
      </section>
    </div>
  </div>

  <section class="life-band">
    <div class="wrap">
      <div class="life-bar">
        <div class="life-stats">
          <div class="life-stat">
            <span class="life-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 5 6v6c0 4.2 2.8 7.2 7 8.5 4.2-1.3 7-4.3 7-8.5V6z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <div>
              <b>{liveCount}</b>
              <span>Tin đang đăng</span>
            </div>
          </div>
          <div class="life-stat">
            <span class="life-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="2.2"/><circle cx="16" cy="8.3" r="1.8"/><path d="M4.8 17.2c.4-2.3 2.3-3.7 4.2-3.7s3.8 1.4 4.2 3.7"/></svg>
            </span>
            <div>
              <b>Không mất phí</b>
              <span>khi xem &amp; liên hệ</span>
            </div>
          </div>
          <div class="life-stat">
            <span class="life-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 8v4.2L15 14"/></svg>
            </span>
            <div>
              <b>Chọn lọc</b>
              <span>Tin tại Thái Nguyên</span>
            </div>
          </div>
          <div class="life-stat">
            <span class="life-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="2.2"/><path d="M7 17.2c.5-2.4 2.4-3.7 5-3.7s4.5 1.3 5 3.7"/><circle cx="12" cy="12" r="9"/></svg>
            </span>
            <div>
              <b>{groups.length}</b>
              <span>Cộng đồng gợi ý</span>
            </div>
          </div>
        </div>
        <div class="life-brand">
          <strong>Thái Nguyên Life</strong>
          <span>Đồng hành cùng bạn mỗi ngày</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    function bindScroller(trackSel: string, nextSel: string, prevSel: string) {
      const track = document.querySelector(trackSel);
      document.querySelector(nextSel)?.addEventListener('click', () => {
        track?.scrollBy({ left: 280, behavior: 'smooth' });
      });
      document.querySelector(prevSel)?.addEventListener('click', () => {
        track?.scrollBy({ left: -280, behavior: 'smooth' });
      });
    }
    bindScroller('[data-trend-track]', '[data-trend-next]', '[data-trend-prev]');
    bindScroller('[data-comm-track]', '[data-comm-next]', '[data-comm-prev]');
  </script>
</Layout>
