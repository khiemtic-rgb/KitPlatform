---
import Layout from '../../layouts/Layout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { listListings } from '../../lib/api';
const q = Astro.url.searchParams.get('q') ?? '';
const items = await listListings('room', q || undefined);
---
<Layout title="Nhà ở — Thái Nguyên Life" active="room">
  <div class="page">
    <div class="wrap">
      <h1 class="page-title">Nhà ở</h1>
      <form class="search-bar" method="get" style="max-width:640px;margin-bottom:20px">
        <input type="search" name="q" value={q} placeholder="Giá, khu, ở ghép…" />
        <button type="submit">Lọc</button>
      </form>
      <div class="cards-3">
        {items.map((item, i) => <ListingCard item={item} index={i} />)}
      </div>
      {items.length === 0 && <p class="empty">Chưa có phòng còn hạn.</p>}
    </div>
  </div>
</Layout>
