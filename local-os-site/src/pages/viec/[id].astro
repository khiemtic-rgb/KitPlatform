---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getListing, telHref } from '../../lib/api';
const { id } = Astro.params;
const item = id ? await getListing(id) : null;
if (!item) Astro.response.status = 404;
---
<Layout title={item ? `${item.title} — Thái Nguyên Life` : 'Không tìm thấy'} active="job">
  <div class="page">
    <div class="wrap" style="max-width:760px">
      {item ? (
        <article class="detail">
          <p class="muted">Việc làm · {item.trust}</p>
          <h1>{item.title}</h1>
          <p>{item.summary}</p>
          <div class="facts">
            {item.organizationName && <div><strong>Đơn vị:</strong> {item.organizationName}</div>}
            {item.placeText && <div><strong>Địa điểm:</strong> {item.placeText}</div>}
            {item.salaryText && <div><strong>Lương:</strong> {item.salaryText}</div>}
            {item.workingTime && <div><strong>Ca:</strong> {item.workingTime}</div>}
          </div>
          {item.contactPhone && (
            <p>
              Liên hệ chủ/QL:{' '}
              {telHref(item.contactPhone) ? (
                <a class="hl" href={telHref(item.contactPhone)!}>{item.contactPhone}</a>
              ) : (
                <strong>{item.contactPhone}</strong>
              )}
              <span class="muted"> — tự phỏng vấn, chúng tôi không nhận hồ sơ.</span>
            </p>
          )}
          {item.sourceUrl && <p><a href={item.sourceUrl} rel="nofollow">Xem tin gốc</a></p>}
        </article>
      ) : <p class="empty">Tin không còn hoặc đã ẩn.</p>}
    </div>
  </div>
</Layout>
