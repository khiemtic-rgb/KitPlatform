---
import Layout from '../../layouts/Layout.astro';
import JobRow from '../../components/JobRow.astro';
import { hrefFor as listingHref, listListings, orgInitial } from '../../lib/api';
import {
  featuredJobs,
  filterJobs,
  isRemote,
  JOB_TYPES,
  jobPay,
  jobStats,
  jobTypeOf,
} from '../../lib/job-filters';
import { WARDS } from '../../lib/room-filters';

const PAGE_SIZE = 12;
const q = Astro.url.searchParams.get('q') ?? '';
const type = Astro.url.searchParams.get('type') ?? '';
const place = Astro.url.searchParams.get('place') ?? '';
const pay = Astro.url.searchParams.get('pay') ?? '';
const chip = Astro.url.searchParams.get('chip') ?? '';
const all = await listListings('job', q || undefined);
const types = JOB_TYPES.filter((t) => all.some((j) => jobTypeOf(j) === t.id));
const showRemote = all.some(isRemote);
const items = filterJobs(all, { type, place, pay, chip });
const pages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
const page = Math.min(pages, Math.max(1, Number(Astro.url.searchParams.get('page')) || 1));
const from = items.length === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
const to = Math.min(items.length, page * PAGE_SIZE);
const slice = items.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const hasFilter = Boolean(q || type || place || pay || chip);
const featured = featuredJobs(all);
const stats = jobStats(all);

const chips = [
  { id: '', label: 'Tất cả' },
  { id: 'new', label: 'Việc làm mới' },
  { id: 'part_time', label: 'Part-time' },
  { id: 'student', label: 'Sinh viên' },
  ...(showRemote ? [{ id: 'remote', label: 'Làm tại nhà' }] : []),
];

function hrefFor(next: { page?: number; chip?: string } = {}): string {
  const p = new URLSearchParams();
  if (q) p.set('q', q);
  if (type) p.set('type', type);
  if (place) p.set('place', place);
  if (pay) p.set('pay', pay);
  const nextChip = next.chip !== undefined ? next.chip : chip;
  if (nextChip) p.set('chip', nextChip);
  const nextPage = next.page ?? 1;
  if (nextPage > 1) p.set('page', String(nextPage));
  const qs = p.toString();
  return qs ? `/viec?${qs}` : '/viec';
}

function pagerNums(current: number, total: number): Array<number | 'gap'> {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const set = new Set([1, total, current, current - 1, current + 1]);
  if (current <= 3) {
    set.add(2); set.add(3); set.add(4);
  }
  if (current >= total - 2) {
    set.add(total - 1); set.add(total - 2); set.add(total - 3);
  }
  const sorted = [...set].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
  const out: Array<number | 'gap'> = [];
  for (const n of sorted) {
    const last = out[out.length - 1];
    if (typeof last === 'number' && n - last > 1) out.push('gap');
    out.push(n);
  }
  return out;
}
---
<Layout title="Việc làm — Thái Nguyên Life" active="job">
  <section class="job-hero">
    <div class="wrap">
      <h1>Việc làm tại Thái Nguyên</h1>
      <p class="job-hero-lead">Việc làm tại Thái Nguyên · Liên hệ trực tiếp nhà tuyển dụng</p>
    </div>
  </section>

  <div class="page jobs-page">
    <div class="wrap">
      <form class="job-search" method="get">
        {chip && <input type="hidden" name="chip" value={chip} />}
        <div class="job-search-top">
          <input type="search" name="q" value={q} placeholder="Tìm việc làm, vị trí, công ty…" />
          <button type="submit">Lọc</button>
        </div>
        <div class="job-search-filters">
          <label>
            <span>Hình thức</span>
            <select name="type" onchange="this.form.requestSubmit()">
              <option value="">Tất cả…</option>
              {types.map((t) => (
                <option value={t.id} selected={type === t.id}>{t.label}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Mức lương</span>
            <select name="pay" onchange="this.form.requestSubmit()">
              <option value="">Tất cả…</option>
              <option value="has" selected={pay === 'has'}>Có ghi lương / hỗ trợ</option>
            </select>
          </label>
          <label>
            <span>Địa điểm</span>
            <select name="place" aria-label="Phường / xã" onchange="this.form.requestSubmit()">
              <option value="">Tất cả…</option>
              {WARDS.map((w) => (
                <option value={w.id} selected={place === w.id}>{w.label}</option>
              ))}
            </select>
          </label>
        </div>
      </form>

      <div class="job-chips" role="navigation" aria-label="Lọc nhanh">
        {chips.map((c) => (
          <a class={chip === c.id ? 'is-on' : undefined} href={hrefFor({ chip: c.id })}>{c.label}</a>
        ))}
        {hasFilter && <a class="room-filters-clear" href="/viec">Xóa lọc</a>}
      </div>

      <div class="jobs-layout">
        <div>
          <div class="room-toolbar">
            <p class="room-count">
              {items.length === 0
                ? 'Không có việc khớp'
                : `Hiển thị ${from} – ${to} trong ${items.length} việc làm`}
              {hasFilter && items.length !== all.length ? ` · ${all.length} đang đăng` : ''}
            </p>
            <span class="room-sort">Sắp xếp: Mới nhất</span>
          </div>

          <div class="job-list">
            {slice.map((item, i) => <JobRow item={item} index={(page - 1) * PAGE_SIZE + i} />)}
          </div>
          {items.length === 0 && <p class="empty">Không có việc khớp. Thử bỏ lọc hoặc đổi từ khóa.</p>}

          {pages > 1 && (
            <nav class="room-pager" aria-label="Trang">
              {page > 1 ? <a href={hrefFor({ page: page - 1 })} aria-label="Trang trước">‹</a> : <span class="is-off">‹</span>}
              {pagerNums(page, pages).map((n) =>
                n === 'gap' ? (
                  <span class="is-gap">…</span>
                ) : n === page ? (
                  <span class="is-on" aria-current="page">{n}</span>
                ) : (
                  <a href={hrefFor({ page: n })}>{n}</a>
                )
              )}
              {page < pages ? <a href={hrefFor({ page: page + 1 })} aria-label="Trang sau">›</a> : <span class="is-off">›</span>}
            </nav>
          )}
        </div>

        <aside class="job-side">
          {featured.length > 0 && (
            <section class="panel">
              <h3>Việc nổi bật</h3>
              {featured.map((item, i) => (
                <a class="job-mini" href={listingHref(item)}>
                  <span class={`job-ico c${i % 3}`}>{orgInitial(item)}</span>
                  <div>
                    <strong>{item.title}</strong>
                    {item.organizationName && <span>{item.organizationName}</span>}
                    <em>Lương: {jobPay(item)}</em>
                  </div>
                </a>
              ))}
            </section>
          )}

          <section class="job-seek">
            <h3>Bạn đang tìm việc?</h3>
            <p>Xem tin rồi gọi số trên tin. Nhà tuyển dụng tự nhận ứng viên.</p>
            <ul>
              <li>Xem tin miễn phí</li>
              <li>Liên hệ trực tiếp nhà tuyển dụng</li>
              <li>Đăng tin việc không mất phí</li>
            </ul>
            <a class="btn-green" href="/dang-tin">Đăng tin việc</a>
          </section>

          <section class="panel">
            <h3>Thống kê việc làm</h3>
            <ul class="job-stats">
              {stats.map((row) => (
                <li>
                  <span>{row.label}</span>
                  <strong>{row.count}</strong>
                </li>
              ))}
            </ul>
          </section>
        </aside>
      </div>
    </div>
  </div>
</Layout>
