---
import Layout from '../../layouts/Layout.astro';
import EventRow from '../../components/EventRow.astro';
import { formatClock, hrefFor as listingHref, listListings } from '../../lib/api';
import {
  EVENT_WHEN,
  eventCatsIn,
  eventDateBadge,
  eventPlaces,
  featuredEvents,
  filterEvents,
} from '../../lib/event-filters';
import { collectionJsonLd, siteOrigin } from '../../lib/seo';

const PAGE_SIZE = 10;
const q = Astro.url.searchParams.get('q') ?? '';
const cat = Astro.url.searchParams.get('cat') ?? '';
const when = Astro.url.searchParams.get('when') ?? '';
const place = Astro.url.searchParams.get('place') ?? '';
const all = await listListings('event', q || undefined);
const cats = eventCatsIn(all);
const places = eventPlaces(all);
const items = filterEvents(all, { cat, when, place });
const pages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
const page = Math.min(pages, Math.max(1, Number(Astro.url.searchParams.get('page')) || 1));
const from = items.length === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
const to = Math.min(items.length, page * PAGE_SIZE);
const slice = items.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const hasFilter = Boolean(q || cat || when || place);
const featured = featuredEvents(all);
const catCounts = eventCatsIn(all);

function hrefFor(next: { page?: number; cat?: string } = {}): string {
  const p = new URLSearchParams();
  if (q) p.set('q', q);
  const nextCat = next.cat !== undefined ? next.cat : cat;
  if (nextCat) p.set('cat', nextCat);
  if (when) p.set('when', when);
  if (place) p.set('place', place);
  const nextPage = next.page ?? 1;
  if (nextPage > 1) p.set('page', String(nextPage));
  const qs = p.toString();
  return qs ? `/su-kien?${qs}` : '/su-kien';
}

function pagerNums(current: number, total: number): Array<number | 'gap'> {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const set = new Set([1, total, current, current - 1, current + 1]);
  if (current <= 3) {
    set.add(2); set.add(3); set.add(4);
  }
  if (current >= total - 2) {
    set.add(total - 1); set.add(total - 2); set.add(total - 3);
  }
  const sorted = [...set].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
  const out: Array<number | 'gap'> = [];
  for (const n of sorted) {
    const last = out[out.length - 1];
    if (typeof last === 'number' && n - last > 1) out.push('gap');
    out.push(n);
  }
  return out;
}

const pageDesc = 'Văn hóa, thể thao, du lịch, hội chợ — lọc theo nhóm để xem tin đang mở tại Thái Nguyên.';
---
<Layout
  title="Sự kiện — Thái Nguyên Life"
  description={pageDesc}
  image="/trend/event.jpg"
  jsonLd={[collectionJsonLd({ origin: siteOrigin(Astro.site), path: '/su-kien', name: 'Sự kiện tại Thái Nguyên', description: pageDesc })]}
  active="event"
>
  <section class="job-hero">
    <div class="wrap">
      <h1>Sự kiện tại Thái Nguyên</h1>
      <p class="job-hero-lead">Văn hóa, thể thao, du lịch, hội chợ — lọc theo nhóm để xem tin đang mở.</p>
    </div>
  </section>

  <div class="page events-page">
    <div class="wrap">
      <form class="job-search" method="get">
        <div class="job-search-top">
          <input type="search" name="q" value={q} placeholder="Tìm lễ hội, giải đấu, hội chợ, địa điểm…" />
          <button type="submit">Lọc</button>
        </div>
        <div class="event-search-filters">
          <label>
            <span>Danh mục</span>
            <select name="cat" onchange="this.form.requestSubmit()">
              <option value="">Tất cả</option>
              {cats.map((c) => (
                <option value={c.id} selected={cat === c.id}>{c.label}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Thời gian</span>
            <select name="when" onchange="this.form.requestSubmit()">
              <option value="">Mọi thời điểm</option>
              {EVENT_WHEN.map((w) => (
                <option value={w.id} selected={when === w.id}>{w.label}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Địa điểm</span>
            <select name="place" onchange="this.form.requestSubmit()">
              <option value="">Tất cả</option>
              {places.map((p) => (
                <option value={p} selected={place === p}>{p}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Sắp xếp</span>
            <select disabled>
              <option>Mới nhất</option>
            </select>
          </label>
        </div>
      </form>

      <div class="job-chips" role="navigation" aria-label="Lọc nhanh">
        <a class={!cat ? 'is-on' : undefined} href={hrefFor({ cat: '' })}>Tất cả</a>
        {cats.map((c) => (
          <a class={cat === c.id ? 'is-on' : undefined} href={hrefFor({ cat: c.id })}>{c.label}</a>
        ))}
        {hasFilter && <a class="room-filters-clear" href="/su-kien">Xóa lọc</a>}
      </div>

      <div class="jobs-layout">
        <div>
          <div class="room-toolbar">
            <p class="room-count">
              {items.length === 0
                ? 'Không có sự kiện khớp'
                : `Hiển thị ${from} – ${to} trong ${items.length} sự kiện`}
              {hasFilter && items.length !== all.length ? ` · ${all.length} đang đăng` : ''}
            </p>
            <span class="room-sort">Sắp xếp: Mới nhất</span>
          </div>

          <div class="event-list">
            {slice.map((item, i) => <EventRow item={item} index={(page - 1) * PAGE_SIZE + i} />)}
          </div>
          {items.length === 0 && (
            <p class="empty">Không có sự kiện khớp. Thử bỏ lọc hoặc đổi từ khóa.</p>
          )}

          {pages > 1 && (
            <nav class="room-pager" aria-label="Trang">
              {page > 1 ? <a href={hrefFor({ page: page - 1 })} aria-label="Trang trước">‹</a> : <span class="is-off">‹</span>}
              {pagerNums(page, pages).map((n) =>
                n === 'gap' ? (
                  <span class="is-gap">…</span>
                ) : n === page ? (
                  <span class="is-on" aria-current="page">{n}</span>
                ) : (
                  <a href={hrefFor({ page: n })}>{n}</a>
                )
              )}
              {page < pages ? <a href={hrefFor({ page: page + 1 })} aria-label="Trang sau">›</a> : <span class="is-off">›</span>}
            </nav>
          )}
        </div>

        <aside class="job-side">
          <div class="event-side-art" aria-hidden="true"></div>

          {featured.length > 0 && (
            <section class="panel">
              <h3>Sự kiện nổi bật</h3>
              {featured.map((item) => {
                const badge = eventDateBadge(item.startAt);
                return (
                  <a class="event-mini" href={listingHref(item)}>
                    {badge && (
                      <span class="event-mini-date">
                        <strong>{badge.day}</strong>
                        <em>{badge.mon}</em>
                      </span>
                    )}
                    <div>
                      <strong>{item.title}</strong>
                      {formatClock(item.startAt) && <span>{formatClock(item.startAt)}</span>}
                      {item.placeText && <span>{item.placeText}</span>}
                    </div>
                  </a>
                );
              })}
            </section>
          )}

          <section class="job-seek">
            <h3>Bạn muốn gửi sự kiện?</h3>
            <p>Đăng sự kiện miễn phí trên site.</p>
            <a class="btn-green" href="/dang-tin">Đăng sự kiện</a>
          </section>

          {catCounts.length > 0 && (
            <section class="panel">
              <h3>Danh mục sự kiện</h3>
              <ul class="event-cat-stats">
                {catCounts.map((c) => (
                  <li>
                    <a href={hrefFor({ cat: c.id })}>{c.label}</a>
                    <strong>{c.count}</strong>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </div>
  </div>
</Layout>
