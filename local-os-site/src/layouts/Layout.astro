---
import '../styles/global.css';

interface Props {
  title: string;
  active?: 'home' | 'job' | 'event' | 'room' | 'offer' | 'grant' | 'community' | 'publish';
}
const { title, active = 'home' } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Pattaya&display=swap" rel="stylesheet" />
  </head>
  <body id="top">
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="Thái Nguyên Life">
          <img class="brand-logo" src="/logo-thai-nguyen-life.png" alt="Thái Nguyên Life — Mọi điều hữu ích quanh bạn" />
        </a>
        <nav class="nav">
          <a href="/" class={active === 'home' ? 'is-on' : undefined}>Khám phá</a>
          <a href="/viec" class={active === 'job' ? 'is-on' : undefined}>Việc làm</a>
          <a href="/su-kien" class={active === 'event' ? 'is-on' : undefined}>Sự kiện</a>
          <a href="/tro" class={active === 'room' ? 'is-on' : undefined}>Nhà ở</a>
          <a href="/uu-dai" class={active === 'offer' ? 'is-on' : undefined}>Ưu đãi</a>
          <a href="/uu-dai#hoc-bong" class={active === 'grant' ? 'is-on' : undefined}>Học bổng</a>
          <a href="/#cong-dong" class={active === 'community' ? 'is-on' : undefined}>Cộng đồng</a>
        </nav>
        <div class="header-actions">
          <a href="/dang-tin" class={active === 'publish' ? 'btn-green is-on' : 'btn-green'}>+ Đăng tin</a>
          <a class="icon-btn" href="/#tim" title="Tìm trên trang" aria-label="Tìm kiếm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
          </a>
          <span class="avatar-btn" title="Chưa cần đăng nhập để xem" aria-hidden="true">👤</span>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="brand" href="/" aria-label="Thái Nguyên Life">
              <img class="brand-logo brand-logo-foot" src="/logo-thai-nguyen-life.png" alt="Thái Nguyên Life — Mọi điều hữu ích quanh bạn" />
            </a>
            <p class="foot-lead">Nền tảng thông tin &amp; khám phá dành riêng cho Thái Nguyên.</p>
            <div class="foot-social" aria-label="Kênh mạng xã hội — sắp mở">
              <span class="soc fb" title="Facebook — sắp mở">f</span>
              <span class="soc yt" title="YouTube — sắp mở">▶</span>
              <span class="soc tt" title="TikTok — sắp mở">♪</span>
            </div>
          </div>
          <div>
            <h4>Khám phá</h4>
            <a href="/viec">Việc làm</a>
            <a href="/su-kien">Sự kiện</a>
            <a href="/tro">Nhà ở</a>
            <a href="/uu-dai">Ưu đãi</a>
            <a href="/uu-dai#hoc-bong">Học bổng</a>
          </div>
          <div>
            <h4>Hỗ trợ</h4>
            <a href="/dang-tin">Hướng dẫn đăng tin</a>
            <a href="/thong-tin/quy-dinh">Quy định sử dụng</a>
            <a href="/thong-tin/bao-mat">Chính sách bảo mật</a>
            <a href="/thong-tin/lien-he">Liên hệ</a>
          </div>
          <div>
            <h4>Về chúng tôi</h4>
            <a href="/thong-tin/gioi-thieu">Giới thiệu</a>
            <a href="/thong-tin/dieu-khoan">Điều khoản</a>
            <a href="/thong-tin/quang-cao">Quảng cáo</a>
          </div>
          <div>
            <h4>Nhận tin mới mỗi ngày</h4>
            <p class="muted">Bản tin email — sắp mở. Hiện xem tin trên site, không cần đăng ký.</p>
            <form class="news-form" action="/thong-tin/lien-he" method="get">
              <input type="email" name="email" placeholder="Email của bạn" disabled />
              <button type="button" disabled aria-label="Sắp mở">→</button>
            </form>
          </div>
        </div>
        <div class="copy">
          <span>© 2026 Thái Nguyên Life. All rights reserved.</span>
          <a class="to-top" href="#top" aria-label="Lên đầu trang">↑</a>
        </div>
      </div>
    </footer>
  </body>
</html>
