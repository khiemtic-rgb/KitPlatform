---
import '../styles/global.css';
import { OFFERS_PUBLIC } from '../lib/api';
import {
  absUrl,
  clipMeta,
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  jsonLdGraph,
  siteOrigin,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Array<Record<string, unknown> | null | undefined> | Record<string, unknown> | null;
  robots?: string;
  active?: 'home' | 'discover' | 'job' | 'event' | 'room' | 'offer' | 'grant' | 'community' | 'publish' | 'news';
}
const {
  title,
  active = 'home',
  image,
  ogType = 'website',
  jsonLd,
  robots,
} = Astro.props;
const origin = siteOrigin(Astro.site);
const description = clipMeta(Astro.props.description ?? DEFAULT_DESCRIPTION);
const ogImage = absUrl(origin, image ?? DEFAULT_OG_IMAGE);
const canonical = new URL(Astro.url.pathname, Astro.site ?? origin).href;
const extra = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const graph = jsonLdGraph(origin, extra);
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#1f7a45" />
    <meta name="google-site-verification" content="xWO1oI12OrQkJw3Uxzty71I7VRsaYkydQvbTt5pCPaw" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Thái Nguyên Life" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body id="top">
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/" aria-label="Thái Nguyên Life">
          <img class="brand-logo" src="/logo-thai-nguyen-life.png" alt="Thái Nguyên Life — Mọi điều hữu ích quanh bạn" />
        </a>
        <nav class="nav" aria-label="Chính">
          <a href="/kham-pha" class={active === 'discover' ? 'is-on' : undefined}>Khám phá</a>
          <a href="/viec" class={active === 'job' ? 'is-on' : undefined}>Việc làm</a>
          <a href="/su-kien" class={active === 'event' ? 'is-on' : undefined}>Sự kiện</a>
          <a href="/tin" class={active === 'news' ? 'is-on' : undefined}>Tin</a>
          <a href="/tro" class={active === 'room' ? 'is-on' : undefined}>Phòng trọ</a>
          {OFFERS_PUBLIC && <a href="/uu-dai" class={active === 'offer' ? 'is-on' : undefined}>Ưu đãi</a>}
          {OFFERS_PUBLIC && <a href="/uu-dai#hoc-bong" class={active === 'grant' ? 'is-on' : undefined}>Học bổng</a>}
          <a href="/#cong-dong" class={active === 'community' ? 'is-on' : undefined}>Cộng đồng</a>
        </nav>
        <div class="header-actions">
          <a href="/dang-tin" class={active === 'publish' ? 'btn-green is-on' : 'btn-green'}>+ Đăng<span class="post-extra"> tin</span></a>
          <a class="icon-btn" href="/#tim" title="Tìm trên trang chủ" aria-label="Tìm kiếm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
          </a>
          <details class="nav-drawer">
            <summary class="nav-toggle" aria-label="Mở menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </summary>
            <nav class="nav-mobile" aria-label="Menu điện thoại">
              <a href="/kham-pha">Khám phá</a>
              <a href="/viec">Việc làm</a>
              <a href="/su-kien">Sự kiện</a>
              <a href="/tin">Tin</a>
              <a href="/tro">Phòng trọ</a>
              <a href="/#cong-dong">Cộng đồng</a>
              <a href="/dang-tin">+ Đăng tin</a>
              <a href="/thong-tin/gioi-thieu">Giới thiệu</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="brand" href="/" aria-label="Thái Nguyên Life">
              <img class="brand-logo brand-logo-foot" src="/logo-thai-nguyen-life.png" alt="Thái Nguyên Life — Mọi điều hữu ích quanh bạn" />
            </a>
            <p class="foot-lead">Nền tảng thông tin &amp; khám phá dành riêng cho Thái Nguyên.</p>
          </div>
          <div>
            <h4>Khám phá</h4>
            <a href="/kham-pha">Khám phá Thái Nguyên</a>
            <a href="/kham-pha/dia-diem">Địa điểm</a>
            <a href="/kham-pha/cam-nang">Cẩm nang</a>
            <a href="/viec">Việc làm</a>
            <a href="/su-kien">Sự kiện</a>
            <a href="/tin">Tin</a>
            <a href="/tro">Phòng trọ</a>
            {OFFERS_PUBLIC && <a href="/uu-dai">Ưu đãi</a>}
            {OFFERS_PUBLIC && <a href="/uu-dai#hoc-bong">Học bổng</a>}
          </div>
          <div>
            <h4>Hỗ trợ</h4>
            <a href="/dang-tin">Hướng dẫn đăng tin</a>
            <a href="/thong-tin/quy-dinh">Quy định sử dụng</a>
            <a href="/thong-tin/bao-mat">Chính sách bảo mật</a>
            <a href="/thong-tin/lien-he">Liên hệ</a>
          </div>
          <div>
            <h4>Về chúng tôi</h4>
            <a href="/thong-tin/gioi-thieu">Giới thiệu</a>
            <a href="/thong-tin/dieu-khoan">Điều khoản</a>
          </div>
        </div>
        <div class="copy">
          <span>© 2026 Thái Nguyên Life. All rights reserved.</span>
          <a class="to-top" href="#top" aria-label="Lên đầu trang">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 19V6M6.5 11.5 12 6l5.5 5.5"/></svg>
          </a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var path = location.pathname || '/';
        if (path === '/thong-ke' || path.indexOf('/api/') === 0) return;
        try {
          fetch('/api/hit', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ path: path }),
            keepalive: true,
            credentials: 'omit',
          });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
