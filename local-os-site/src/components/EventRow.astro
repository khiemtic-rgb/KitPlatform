---
import {
  coverFor,
  formatEventLine,
  formatRelative,
  hrefFor,
  type LocalListing,
} from '../lib/api';
import { eventCatLabel, eventCatOf, eventLead, eventTags, isNewEvent } from '../lib/event-filters';

interface Props {
  item: LocalListing;
  index?: number;
}
const { item, index = 0 } = Astro.props;
const cat = eventCatOf(item);
const catLabel = eventCatLabel(cat);
const tags = eventTags(item);
const when = formatRelative(item.lastCheckedAt || item.publishedAt);
const timeLine = formatEventLine(item.startAt) || item.workingTime || '';
const snippet = eventLead(item, 280);
---
<a class="event-row" href={hrefFor(item)}>
  <div class="event-row-photo">
    <img src={coverFor('event', index, item.id)} alt="Ảnh minh họa sự kiện" />
    <span class={`event-row-badge is-${cat || 'event'}`}>{catLabel}</span>
    <span class="photo-caption">Ảnh minh họa</span>
  </div>
  <div class="event-row-body">
    <div class="event-row-top">
      <h3>{item.title}</h3>
    </div>
    {snippet && <p class="event-row-snip">{snippet}</p>}
    <p class="event-row-meta">
      {item.placeText && (
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/>
          </svg>
          {item.placeText}
        </span>
      )}
      {timeLine && (
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="8"/><path d="M12 8v5l3 2"/>
          </svg>
          {timeLine}
        </span>
      )}
      {when && <span>{isNewEvent(item) ? 'Mới · ' : ''}{when}</span>}
    </p>
    {tags.length > 0 && (
      <p class="event-row-tags">
        {tags.map((t) => <span class="job-row-tag">{t}</span>)}
      </p>
    )}
    <span class="event-row-more">Xem chi tiết →</span>
  </div>
</a>
