---
import {
  coverFor,
  coverWashClass,
  hrefFor,
  kindLabel,
  trendFoot,
  trendSubtitle,
  type LocalListing,
} from '../lib/api';

interface Props {
  item: LocalListing;
  index?: number;
}
const { item, index = 0 } = Astro.props;
const sub = trendSubtitle(item);
const foot = trendFoot(item);
---
<a class={`trend-card ${item.kind}`} href={hrefFor(item)}>
  <div class="trend-photo-wrap">
    <img class={`trend-photo ${coverWashClass(item.kind, item.id)}`} src={coverFor(item.kind, index, item.id)} alt="Ảnh minh họa" />
    <span class={`trend-badge ${item.kind}`}>{kindLabel(item.kind)}</span>
    <span class="photo-caption">Ảnh minh họa</span>
  </div>
  <div class="trend-meta">
    <h3>{item.title}</h3>
    {sub && <p class="trend-sub">{sub}</p>}
    {foot.text && (
      <p class={`trend-foot ${foot.kind}`}>
        {foot.kind === 'fire' && '🔥 '}
        {foot.kind === 'party' && '🎉 '}
        {foot.kind === 'pin' && '📍 '}
        {foot.text}
      </p>
    )}
  </div>
</a>
