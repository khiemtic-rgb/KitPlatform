---
import {
  formatRelative,
  hrefFor,
  isRecent,
  orgInitial,
  type LocalListing,
} from '../lib/api';
import { jobTags } from '../lib/job-filters';

interface Props {
  item: LocalListing;
  index?: number;
}
const { item, index = 0 } = Astro.props;
const tags = jobTags(item);
const when = formatRelative(item.lastCheckedAt || item.publishedAt);
const fresh = isRecent(item.publishedAt || item.lastCheckedAt);
const snippet = (item.summary ?? '').replace(/\s+/g, ' ').trim();
---
<a class="job-row" href={hrefFor(item)}>
  <span class={`job-row-logo c${index % 3}`}>{orgInitial(item)}</span>
  <div class="job-row-main">
    <div class="job-row-title">
      {fresh && <span class="new-badge">Mới</span>}
      <h3>{item.title}</h3>
    </div>
    {item.organizationName && <p class="job-row-org">{item.organizationName}</p>}
    <p class="job-row-meta">
      {item.placeText && (
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.2"/>
          </svg>
          {item.placeText}
        </span>
      )}
      {tags.map((t) => <span class="job-row-tag">{t}</span>)}
    </p>
    {snippet && <p class="job-row-snip">{snippet}</p>}
  </div>
  <div class="job-row-side">
    <strong>{item.salaryText || 'Thỏa thuận'}</strong>
    {when && <span>{when}</span>}
  </div>
</a>
