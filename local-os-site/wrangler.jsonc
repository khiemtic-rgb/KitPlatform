{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thainguyenlife",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "thainguyenlife.vn", "custom_domain": true },
    { "pattern": "www.thainguyenlife.vn", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "HITS", "id": "1fbd46805dde4bc88cf302ea80ed12d0" }
  ],
  "vars": {
    "FEED_SYNC_TOKEN": "tnl-kv-feed-7c4e91b2a8d64f0e",
    "LOCAL_OS_API": "https://api.novixa.vn/api/public/local-os"
  }
}
