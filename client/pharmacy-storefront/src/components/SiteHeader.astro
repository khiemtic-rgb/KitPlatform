---
import type { PharmacyTenantConfig } from '../tenants/types';

interface Props {
  tenant: PharmacyTenantConfig;
  currentPath?: string;
}

const { tenant, currentPath = '/' } = Astro.props;
const phoneDigits = tenant.contact.phone.replace(/[^\d+]/g, '');
const phoneHref = phoneDigits.length >= 8 ? `tel:${phoneDigits}` : tenant.appPromo.appUrl;
const isCurrent = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href.startsWith('/#')) return false;
  return currentPath === href || currentPath.startsWith(`${href}/`);
};

const iconCart = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M6 6 5 3H2"/></svg>`;
const iconPhone = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.2 4.8c.4-.4 1-.5 1.5-.3l2.1.8c.5.2.8.7.7 1.2l-.4 2.1a1 1 0 0 1-.7.8l-1.3.4a10.5 10.5 0 0 0 4.8 4.8l.4-1.3a1 1 0 0 1 .8-.7l2.1-.4c.5-.1 1 .2 1.2.7l.8 2.1c.2.5.1 1.1-.3 1.5l-1.1 1.1c-.4.4-1 .6-1.6.5C10.8 18.6 5.4 13.2 4.8 6.5c-.1-.6.1-1.2.5-1.6L8.2 4.8z"/></svg>`;
---

<div class="sf-topbar">
  <div class="sf-container sf-topbar__inner">
    <span class="sf-topbar__addr">{tenant.contact.address}</span>
    <span class="sf-topbar__hours">{tenant.contact.hours}</span>
    <span class="sf-topbar__badge">Tư vấn tận tâm</span>
    <a class="sf-topbar__phone" href={phoneHref}>
      <span set:html={iconPhone} />
      <strong>{tenant.contact.phone}</strong>
    </a>
  </div>
</div>

<header class="sf-header">
  <div class="sf-container sf-header__inner">
    <a class="sf-logo" href="/" aria-label={tenant.brand.name}>
      {
        tenant.brand.logoUrl ? (
          <img class="sf-logo__img" src={tenant.brand.logoUrl} alt={tenant.brand.name} width="200" height="56" />
        ) : (
          <>
            <span class="sf-logo__mark">{tenant.brand.logoText}</span>
            <span class="sf-logo__name">{tenant.brand.name}</span>
          </>
        )
      }
    </a>
    <nav class="sf-nav" aria-label="Chính">
      {
        tenant.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="sf-header__actions">
      <a class="sf-btn sf-btn--primary sf-header__cta" href={tenant.appPromo.appUrl}>
        <span class="sf-btn__icon" set:html={iconCart} />
        Đặt thuốc nhanh
      </a>
      <button
        type="button"
        class="sf-nav-toggle"
        aria-expanded="false"
        aria-controls="sf-mobile-nav"
        data-sf-nav-toggle
      >
        <span class="sf-nav-toggle__bars" aria-hidden="true"></span>
        <span class="sf-visually-hidden">Menu</span>
      </button>
    </div>
  </div>
  <div class="sf-mobile-nav" id="sf-mobile-nav" data-sf-mobile-nav hidden>
    <div class="sf-container sf-mobile-nav__inner">
      {
        tenant.nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="sf-btn sf-btn--primary" href={tenant.appPromo.appUrl}>Đặt thuốc nhanh</a>
    </div>
  </div>
</header>

<script>
  function bindNav() {
    const toggle = document.querySelector('[data-sf-nav-toggle]');
    const panel = document.querySelector('[data-sf-mobile-nav]');
    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.classList.toggle('is-open', open);
      if (open) panel.removeAttribute('hidden');
      else panel.setAttribute('hidden', '');
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }

  bindNav();
  document.addEventListener('astro:page-load', bindNav);
</script>
