---
import type { PharmacyTenantConfig } from '../tenants/types';

interface Props {
  tenant: PharmacyTenantConfig;
}

const { tenant } = Astro.props;
const year = new Date().getFullYear();
const phoneHref = `tel:${tenant.contact.phone.replace(/[^\d+]/g, '')}`;

const iconPin = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s6.5-5.2 6.5-10.2A6.5 6.5 0 0 0 5.5 10.8C5.5 15.8 12 21 12 21z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10.5" r="2.2" stroke="currentColor" stroke-width="1.8"/></svg>`;
const iconPhone = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8.2 4.8c.4-.4 1-.5 1.5-.3l2.1.9c.6.2 1 .8.9 1.4l-.4 2.1c-.1.5.1 1 .5 1.3l1.6 1.3c.4.3.9.3 1.3 0l2-.9c.6-.3 1.3-.1 1.7.4l1.1 1.5c.4.6.3 1.4-.3 1.8l-1.7 1.2c-2.4 1.6-5.6 1.1-7.8-1.2L8 12.1C5.9 9.8 5.5 6.7 7.1 4.4l.5-.7c.3-.4.8-.6 1.3-.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>`;
const iconClock = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8"/><path d="M12 8.2V12l3 1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`;
const iconMail = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="6.5" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m5.5 8.2 6.5 4.5 6.5-4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const iconArrow = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h12M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const socialIcons: Record<string, string> = {
  facebook: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 8.5h2V6h-2c-1.9 0-3.2 1.3-3.2 3.3V11H9v2.5h1.8V19h2.7v-5.5H16l.4-2.5h-2.9V9.4c0-.6.3-.9.9-.9z" fill="currentColor"/></svg>`,
  zalo: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7.2 8.8h3.4V16H8.5v-5.4H7.2V8.8zm4.2 0H14c1.7 0 2.8 1 2.8 2.5S15.7 14 14 14h-1.3v2h-1.3V8.8zm1.3 1.7v1.8H14c.6 0 1-.4 1-.9s-.4-.9-1-.9h-1.3zM17 8.8h1.3V16H17V8.8z" fill="currentColor"/></svg>`,
};

const socialOrder = [
  { key: 'facebook' as const, label: 'Facebook' },
  { key: 'zalo' as const, label: 'Zalo' },
];

const socialLinks = socialOrder
  .map((s) => {
    const href = tenant.contact.social[s.key];
    return href ? { ...s, href, icon: socialIcons[s.key] } : null;
  })
  .filter(Boolean) as { key: string; label: string; href: string; icon: string }[];
---

<footer class="sf-footer">
  <div class="sf-container sf-footer__grid">
    <div class="sf-footer__brand">
      <div class="sf-footer__brand-head">
        <div class="sf-footer__brand-text">
          <strong>NHÀ THUỐC</strong>
          <b>{tenant.brand.shortName.toUpperCase()}</b>
        </div>
      </div>
      {tenant.footer.tagline ? <p class="sf-footer__tagline">{tenant.footer.tagline}</p> : null}
      <p class="sf-footer__mission">{tenant.footer.mission}</p>
      {
        socialLinks.length ? (
          <div class="sf-footer__social">
            {socialLinks.map((s) => (
              <a href={s.href} target="_blank" rel="noreferrer" aria-label={s.label} set:html={s.icon} />
            ))}
          </div>
        ) : null
      }
    </div>

    <div class="sf-footer__col">
      <h4>Thông tin liên hệ</h4>
      <ul class="sf-footer__contact">
        <li>
          <span class="sf-footer__ico" set:html={iconPin} />
          <span>{tenant.contact.address}</span>
        </li>
        <li>
          <span class="sf-footer__ico" set:html={iconPhone} />
          <a href={phoneHref}>{tenant.contact.phone}</a>
        </li>
        <li>
          <span class="sf-footer__ico" set:html={iconClock} />
          <span>{tenant.contact.hours}</span>
        </li>
        <li>
          <span class="sf-footer__ico" set:html={iconMail} />
          <a href={`mailto:${tenant.contact.email}`}>{tenant.contact.email}</a>
        </li>
      </ul>
    </div>

    <div class="sf-footer__col">
      <h4>Danh mục</h4>
      <ul>
        {
          tenant.footer.categoryLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sf-footer__col">
      <h4>Hỗ trợ khách hàng</h4>
      <ul>
        {
          tenant.footer.supportLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sf-footer__col sf-footer__news">
      <h4>Đăng ký nhận tin</h4>
      {tenant.footer.newsletterNote ? <p>{tenant.footer.newsletterNote}</p> : null}
      <form class="sf-newsletter" onsubmit="return false;">
        <label class="sf-visually-hidden" for="sf-newsletter-email">Email</label>
        <input id="sf-newsletter-email" type="email" name="email" placeholder="Nhập email của bạn" />
        <button type="button" aria-label="Đăng ký nhận tin" set:html={iconArrow} />
      </form>
    </div>
  </div>

  <div class="sf-footer__bottom">
    <div class="sf-container">
      © {year} {tenant.brand.name}. {tenant.footer.copyright ?? 'Tất cả quyền được bảo lưu.'}
    </div>
  </div>
</footer>
