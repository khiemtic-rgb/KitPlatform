---
import type { PharmacyTenantConfig } from '../tenants/types';

interface Props {
  tenant: PharmacyTenantConfig;
}

const { tenant } = Astro.props;
const year = new Date().getFullYear();
const phoneHref = `tel:${tenant.contact.phone.replace(/[^\d+]/g, '')}`;
---

<footer class="sf-footer">
  <div class="sf-container sf-footer__grid">
    <div>
      {
        tenant.brand.logoUrl ? (
          <img class="sf-footer__logo" src={tenant.brand.logoUrl} alt={tenant.brand.name} width="180" height="50" />
        ) : (
          <h3>{tenant.brand.name}</h3>
        )
      }
      <p>{tenant.footer.mission}</p>
      <p>{tenant.contact.address}</p>
      <p>
        <a href={phoneHref}>{tenant.contact.phone}</a>
        <br />
        <a href={`mailto:${tenant.contact.email}`}>{tenant.contact.email}</a>
      </p>
    </div>
    <div>
      <h4>Về chúng tôi</h4>
      <ul>
        {tenant.footer.aboutLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Hỗ trợ khách hàng</h4>
      <ul>
        {tenant.footer.supportLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Kiến thức sức khỏe</h4>
      <ul>
        {tenant.footer.knowledgeLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="sf-powered">
      <div class="sf-powered__label">{tenant.poweredBy.label}</div>
      <p>{tenant.poweredBy.blurb}</p>
      <a href={tenant.poweredBy.href} target="_blank" rel="noreferrer">
        Tìm hiểu thêm tại novixa.vn
      </a>
    </div>
  </div>
  <div class="sf-container sf-footer__bottom">
    © {year} {tenant.brand.name}. All rights reserved.
  </div>
</footer>
