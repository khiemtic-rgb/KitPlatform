<script is:inline>
  (function () {
    function bindProductCarousel() {
      var track = document.querySelector('[data-sf-product-track]');
      var prev = document.querySelector('[data-sf-product-prev]');
      var next = document.querySelector('[data-sf-product-next]');
      if (!track || !prev || !next) return;
      if (track.getAttribute('data-sf-bound') === '1') return;
      track.setAttribute('data-sf-bound', '1');

      function step() {
        var card = track.querySelector('.sf-product');
        if (!card) return 280;
        var styles = window.getComputedStyle(track);
        var gap = parseFloat(styles.columnGap || styles.gap || '16') || 16;
        return card.getBoundingClientRect().width + gap;
      }

      function update() {
        var max = track.scrollWidth - track.clientWidth;
        var canScroll = max > 2;
        prev.disabled = !canScroll || track.scrollLeft <= 2;
        next.disabled = !canScroll || track.scrollLeft >= max - 2;
        prev.style.visibility = canScroll ? '' : 'hidden';
        next.style.visibility = canScroll ? '' : 'hidden';
      }

      prev.addEventListener('click', function (e) {
        e.preventDefault();
        track.scrollBy({ left: -step(), behavior: 'smooth' });
      });
      next.addEventListener('click', function (e) {
        e.preventDefault();
        track.scrollBy({ left: step(), behavior: 'smooth' });
      });
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindProductCarousel);
    } else {
      bindProductCarousel();
    }
    document.addEventListener('astro:page-load', bindProductCarousel);
  })();
</script>
