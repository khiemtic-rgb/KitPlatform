const escapeHtml = (s: string) =>
  s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');

const trustBandTitleHtml = (() => {
  const title = tenant.trustBand.title;
  const hi = tenant.trustBand.titleHighlight;
  if (!hi || !title.includes(hi)) return escapeHtml(title);
  const i = title.indexOf(hi);
  return `${escapeHtml(title.slice(0, i))}<em>${escapeHtml(hi)}</em>${escapeHtml(title.slice(i + hi.length))}`;
})();

const appTitleHtml = (() => {
  const title = tenant.appSection.title;
  const hi = tenant.appSection.titleHighlight;
  if (!hi || !title.includes(hi)) return escapeHtml(title);
  const i = title.indexOf(hi);
  return `${escapeHtml(title.slice(0, i))}<em>${escapeHtml(hi)}</em>${escapeHtml(title.slice(i + hi.length))}`;
})();

const platformLeadHtml = (() => {
  const lead = tenant.platformPromo.ctaLead ?? '';
  const hi = tenant.platformPromo.ctaLeadHighlight;
  if (!lead) return '';
  if (!hi || !lead.includes(hi)) return escapeHtml(lead);
  const i = lead.indexOf(hi);
  return `${escapeHtml(lead.slice(0, i))}<strong>${escapeHtml(hi)}</strong>${escapeHtml(lead.slice(i + hi.length))}`;
})();
---

<!-- HERO -->
<section class="sf-hero">
  <div class="sf-container">
    <div class="sf-hero__banner">
      <div class="sf-hero__leaf" aria-hidden="true"></div>
      <div class="sf-hero__copy">
        <h1>{tenant.hero.headline}</h1>
        <p class="sf-hero__sub">{tenant.hero.subhead}</p>
        <ul class="sf-hero__trust">
          {
            tenant.hero.trustItems.map((item) => (
              <li>
                <span class="sf-hero__trust-icon" set:html={trustIcons[item.icon] ?? trustIcons.badge} />
                <span class="sf-hero__trust-text">
                  <strong>{item.label}</strong>
                  {item.sublabel ? <small>{item.sublabel}</small> : null}
                </span>
              </li>
            ))
          }
        </ul>
        <div class="sf-hero__actions">
          <a class="sf-btn sf-btn--primary sf-btn--icon" href={tenant.hero.ctaPrimary.href}>
            <span class="sf-btn__icon" set:html={iconBag} />
            {tenant.hero.ctaPrimary.label}
          </a>
          <a class="sf-btn sf-btn--ghost sf-btn--icon" href={tenant.hero.ctaSecondary.href}>
            <span class="sf-btn__icon" set:html={iconPhone} />
            {tenant.hero.ctaSecondary.label}
          </a>
        </div>
      </div>
      <div class="sf-hero__media">
        <div class="sf-hero__photo">
          <img
            src={tenant.hero.imageUrl}
            alt={`${tenant.brand.name} — tư vấn dược sĩ`}
            width="1200"
            height="760"
            loading="eager"
          />
        </div>
        <ul class="sf-hero__stats">
          {
            tenant.hero.heroStats.map((s) => (
              <li>
                {s.icon ? (
                  <span class="sf-hero__stat-icon" set:html={statIcons[s.icon] ?? statIcons.heart} />
                ) : null}
                <span class="sf-hero__stat-text">
                  {s.value ? <strong>{s.value}</strong> : <strong>{s.label}</strong>}
                  <small>{s.value ? s.label : s.sublabel}</small>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- TRUST BAND -->
<section class="sf-trustband">
  <div class="sf-container">
    <div class="sf-trustband__card">
