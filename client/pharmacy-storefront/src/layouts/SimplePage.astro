---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadTenant } from '../lib/load-tenant';
import '../styles/storefront.css';

interface Props {
  title: string;
  heading: string;
  body: string;
  path: string;
}

const tenantOrRedirect = await loadTenant(Astro);
if (tenantOrRedirect instanceof Response) return tenantOrRedirect;
const tenant = tenantOrRedirect;
const { title, heading, body, path } = Astro.props;
---

<BaseLayout tenant={tenant} title={`${heading} — ${tenant.brand.name}`} description={body}>
  <SiteHeader tenant={tenant} currentPath={path} />
  <main class="sf-page">
    <div class="sf-container">
      <h1>{heading}</h1>
      <p>{body}</p>
      <p style="margin-top:1.5rem">
        <a class="sf-btn sf-btn--primary" href={tenant.appPromo.appUrl}>Mở App Novixa</a>
      </p>
      <slot />
    </div>
  </main>
  <SiteFooter tenant={tenant} />
</BaseLayout>
