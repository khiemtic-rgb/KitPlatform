---
/**
 * Soft-404 for unpublished / unknown pharmacy hosts.
 * Neutral shell only — never use Xuân Hòa pilot branding here.
 */
import '../styles/storefront.css';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content="Website nhà thuốc chưa được xuất bản." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Website chưa sẵn sàng — Novixa</title>
    <style>
      :root {
        --color-primary: #0a5c4c;
        --font-sans: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        color: #12352e;
        background: linear-gradient(180deg, #f3faf7 0%, #fff 48%);
        min-height: 100vh;
      }
      main {
        max-width: 36rem;
        margin: 0 auto;
        padding: 5rem 1.25rem;
        text-align: center;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 0.75rem;
      }
      p {
        margin: 0 0 1rem;
        line-height: 1.6;
        color: #3d5c54;
      }
      .sf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1.2rem;
        border-radius: 0.65rem;
        background: var(--color-primary);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Website chưa sẵn sàng</h1>
      <p>Nhà thuốc này chưa xuất bản trang trên Novixa, hoặc địa chỉ không đúng.</p>
      <p><a class="sf-btn" href="https://novixa.vn">Về Novixa</a></p>
    </main>
  </body>
</html>
