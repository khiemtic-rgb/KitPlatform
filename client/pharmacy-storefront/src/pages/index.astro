---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomePage from '../components/HomePage.astro';
import { loadTenant } from '../lib/load-tenant';
import '../styles/storefront.css';

const tenantOrRedirect = await loadTenant(Astro);
if (tenantOrRedirect instanceof Response) return tenantOrRedirect;
const tenant = tenantOrRedirect;
---

<BaseLayout
  tenant={tenant}
  title={`${tenant.brand.name} — Nhà thuốc số`}
  description={tenant.footer.mission}
>
  <SiteHeader tenant={tenant} currentPath="/" />
  <main>
    <HomePage tenant={tenant} />
  </main>
  <SiteFooter tenant={tenant} />
</BaseLayout>
