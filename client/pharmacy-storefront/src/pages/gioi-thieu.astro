---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { resolveTenant } from '../lib/tenant';
import '../styles/storefront.css';

const tenant = resolveTenant(Astro.request);
const { about } = tenant.pages;
const appUrl = tenant.appPromo.appUrl;

const valueIcons: Record<string, string> = {
  badge: `<svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="23" stroke="#C8E0D6" stroke-width="1.5" fill="#fff"/><path d="M24 12.5 15.5 16v7.5c0 6.2 4 10.4 8.5 12 4.5-1.6 8.5-5.8 8.5-12V16L24 12.5z" fill="#004D40"/><path d="m19.8 24.2 2.7 2.7 5.7-5.9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  advisor: `<svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="23" stroke="#C8E0D6" stroke-width="1.5" fill="#fff"/><circle cx="24" cy="18.5" r="4.5" fill="#004D40"/><path d="M13.5 33c1.4-4.8 5-7.2 10.5-7.2s9.1 2.4 10.5 7.2" fill="#0A7A5C"/></svg>`,
  scooter: `<svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="23" stroke="#C8E0D6" stroke-width="1.5" fill="#fff"/><circle cx="16.5" cy="31" r="2.8" fill="#004D40"/><circle cx="32.5" cy="31" r="2.8" fill="#004D40"/><path d="M19 31h10.5l3.2-10H27" stroke="#004D40" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="M19 21h5" stroke="#0A7A5C" stroke-width="2" stroke-linecap="round"/></svg>`,
  privacy: `<svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="23" stroke="#C8E0D6" stroke-width="1.5" fill="#fff"/><path d="M24 12.8 15.8 16.2v7.2c0 5.7 3.7 9.6 8.2 11.1 4.5-1.5 8.2-5.4 8.2-11.1v-7.2L24 12.8z" fill="#004D40"/><rect x="21.2" y="22" width="5.6" height="6.2" rx="1.2" fill="#7DCEA0"/><path d="M22.4 22v-1.6a1.6 1.6 0 1 1 3.2 0V22" stroke="#7DCEA0" stroke-width="1.6"/></svg>`,
};

const reasonIcons: Record<string, string> = {
  badge: `<svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M20 6.5 10 10.5v8.2c0 7 4.4 11.7 10 13.5 5.6-1.8 10-6.5 10-13.5v-8.2L20 6.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m15.8 20.2 2.8 2.8 5.8-6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  pharmacist: `<svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="14" r="4.2" stroke="currentColor" stroke-width="1.8"/><path d="M11.5 30c1.4-5 4.8-7.4 8.5-7.4s7.1 2.4 8.5 7.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M26 12.5h5M28.5 10v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  customers: `<svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="14" cy="15" r="3.3" stroke="currentColor" stroke-width="1.7"/><circle cx="26" cy="15" r="3.3" stroke="currentColor" stroke-width="1.7"/><circle cx="20" cy="12.5" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M7.8 29c1-3.6 3.2-5.2 6.2-5.2 1.4 0 2.6.4 3.5 1.1M22.5 24.9c.9-.7 2.1-1.1 3.5-1.1 3 0 5.2 1.6 6.2 5.2M14.2 24.2c1.1-3.2 3.4-4.7 5.8-4.7s4.7 1.5 5.8 4.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
  hours: `<svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="10.5" stroke="currentColor" stroke-width="1.8"/><path d="M20 14.5V20l4 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};

const iconPin = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s6.5-5.2 6.5-10.2A6.5 6.5 0 0 0 5.5 10.8C5.5 15.8 12 21 12 21z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10.5" r="2.2" stroke="currentColor" stroke-width="1.8"/></svg>`;
const iconPhone = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8.2 4.8c.4-.4 1-.5 1.5-.3l2.1.9c.6.2 1 .8.9 1.4l-.4 2.1c-.1.5.1 1 .5 1.3l1.6 1.3c.4.3.9.3 1.3 0l2-.9c.6-.3 1.3-.1 1.7.4l1.1 1.5c.4.6.3 1.4-.3 1.8l-1.7 1.2c-2.4 1.6-5.6 1.1-7.8-1.2L8 12.1C5.9 9.8 5.5 6.7 7.1 4.4l.5-.7c.3-.4.8-.6 1.3-.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>`;
const iconClock = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.8"/><path d="M12 8.2V12l3 1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`;
const iconCheck = `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#0A7A5C"/><path d="m8.2 12.2 2.5 2.5 5.2-5.4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<BaseLayout
  tenant={tenant}
  title={`Giới thiệu — ${tenant.brand.name}`}
  description={about.intro}
>
  <SiteHeader tenant={tenant} currentPath="/gioi-thieu" />
  <main class="sf-about">
    <section class="sf-about-hero">
      <div class="sf-container sf-about-hero__grid">
        <div class="sf-about-hero__copy">
          <p class="sf-eyebrow">{about.hero.eyebrow}</p>
          <h1>{about.hero.title}</h1>
          <p class="sf-about-hero__sub">{about.hero.subtitle}</p>
          <p class="sf-about-hero__body">{about.hero.body}</p>
          <ul class="sf-about-hero__chips">
            <li>
              <span class="sf-about-hero__chip-icon" set:html={iconPin} />
              <span>{tenant.contact.address}</span>
            </li>
            <li>
              <span class="sf-about-hero__chip-icon" set:html={iconClock} />
              <span>{tenant.contact.hours}</span>
            </li>
            <li>
              <span class="sf-about-hero__chip-icon" set:html={iconPhone} />
              <a href={`tel:${tenant.contact.phone.replace(/\./g, '')}`}>{tenant.contact.phone}</a>
            </li>
          </ul>
          <div class="sf-about-hero__actions">
            <a class="sf-btn sf-btn--primary" href={about.hero.ctaPrimary.href}>{about.hero.ctaPrimary.label}</a>
            <a class="sf-btn sf-btn--ghost" href={about.hero.ctaSecondary.href}>{about.hero.ctaSecondary.label}</a>
          </div>
        </div>
        <div class="sf-about-hero__media">
          <img src={about.hero.imageUrl} alt={about.hero.imageAlt} width="720" height="560" loading="eager" />
        </div>
      </div>
    </section>

    <section class="sf-about-values" aria-labelledby="about-values-title">
      <div class="sf-container">
        <h2 id="about-values-title" class="sf-about-section-title">{about.valuesTitle}</h2>
        <div class="sf-about-values__grid">
          {
            about.values.map((item) => (
              <article class="sf-about-value-card">
                <div class="sf-about-value-card__icon" set:html={valueIcons[item.icon] ?? valueIcons.badge} />
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sf-about-reasons" aria-labelledby="about-reasons-title">
      <div class="sf-container">
        <h2 id="about-reasons-title" class="sf-about-section-title">{about.reasonsTitle}</h2>
        <ol class="sf-about-timeline">
          {
            about.reasons.map((item) => (
              <li class="sf-about-timeline__item">
                <div class="sf-about-timeline__icon" set:html={reasonIcons[item.icon] ?? reasonIcons.badge} />
                <strong>{item.label}</strong>
                <p>{item.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="sf-about-team" id="doi-ngu" aria-labelledby="about-team-title">
      <div class="sf-container sf-about-team__panel">
        <h2 id="about-team-title" class="sf-about-section-title">{about.team.title}</h2>
        <p class="sf-about-team__body">{about.team.body}</p>
        <ul class="sf-about-team__highlights">
          {about.team.highlights.map((item) => <li>{item}</li>)}
        </ul>
        <div class="sf-about-center-cta sf-about-team__actions">
          <a class="sf-btn sf-btn--primary" href={about.team.ctaPrimary.href}>{about.team.ctaPrimary.label}</a>
          <a class="sf-btn sf-btn--ghost" href={about.team.ctaSecondary.href}>{about.team.ctaSecondary.label}</a>
        </div>
      </div>
    </section>

    <section class="sf-about-digital" id="cong-nghe" aria-labelledby="about-digital-title">
      <div class="sf-container sf-about-digital__grid">
        <div class="sf-about-digital__copy">
          <h2 id="about-digital-title">{about.digital.title}</h2>
          <ul class="sf-about-digital__list">
            {
              about.digital.bullets.map((bullet) => (
                <li>
                  <span class="sf-about-digital__check" set:html={iconCheck} />
                  <span>{bullet}</span>
                </li>
              ))
            }
          </ul>
          <a class="sf-btn sf-btn--primary" href={appUrl}>Đặt thuốc trên App</a>
        </div>
        <div class="sf-about-digital__devices" aria-hidden="true">
          <div class="sf-about-phone sf-about-phone--back">
            <div class="sf-about-phone__screen">
              <strong>Nhắc uống thuốc</strong>
              <small>08:00 · Vitamin</small>
            </div>
          </div>
          <div class="sf-about-phone sf-about-phone--mid">
            <div class="sf-about-phone__screen">
              <strong>Hồ sơ gia đình</strong>
              <small>4 thành viên</small>
            </div>
          </div>
          <div class="sf-about-phone sf-about-phone--front">
            <div class="sf-about-phone__screen">
              <strong>Đặt thuốc nhanh</strong>
              <small>Giao tận nơi</small>
              <span class="sf-about-phone__cta">Đặt ngay</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sf-about-media-band">
      <div class="sf-container sf-about-media-band__grid">
        <div class="sf-about-gallery">
          <h2 class="sf-about-section-title">{about.gallery.title}</h2>
          <div class="sf-about-gallery__grid">
            {
              about.gallery.images.map((image) => (
                <figure>
                  <img src={image.src} alt={image.alt} width="480" height="360" loading="lazy" />
                </figure>
              ))
            }
          </div>
          <a class="sf-btn sf-btn--ghost" href={about.gallery.ctaHref}>{about.gallery.ctaLabel}</a>
        </div>

        <div class="sf-about-certs" id="giay-phep">
          <h2 class="sf-about-section-title">{about.certificates.title}</h2>
          <div class="sf-about-certs__grid">
            {
              about.certificates.items.map((item) => (
                <figure>
                  <img src={item.imageUrl} alt={item.title} width="280" height="360" loading="lazy" />
                  <figcaption>{item.title}</figcaption>
                </figure>
              ))
            }
          </div>
          <a class="sf-btn sf-btn--ghost" href={about.certificates.ctaHref}>{about.certificates.ctaLabel}</a>
        </div>
      </div>
    </section>

    {
      tenant.contact.branches && tenant.contact.branches.length > 0 ? (
        <section class="sf-about-branches" id="chi-nhanh">
          <div class="sf-container">
            <h2 class="sf-about-section-title">Hệ thống chi nhánh</h2>
            <ul class="sf-branch-list">
              {tenant.contact.branches.map((b) => (
                <li>
                  <strong>{b.name}</strong>
                  <span>{b.address}</span>
                  {b.hours ? <span>{b.hours}</span> : null}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ) : null
    }

    <section class="sf-about-support" aria-labelledby="about-support-title">
      <div class="sf-container sf-about-support__inner">
        <div class="sf-about-support__photo">
          <img
            src={about.supportCta.imageUrl}
            alt={about.supportCta.imageAlt}
            width="560"
            height="360"
            loading="lazy"
          />
        </div>
        <div class="sf-about-support__copy">
          <h2 id="about-support-title">{about.supportCta.title}</h2>
          <ul class="sf-about-support__contact">
            <li>
              <span set:html={iconPin} />
              <span>{tenant.contact.address}</span>
            </li>
            <li>
              <span set:html={iconPhone} />
              <a href={`tel:${tenant.contact.phone.replace(/\./g, '')}`}>{tenant.contact.phone}</a>
            </li>
            <li>
              <span set:html={iconClock} />
              <span>{tenant.contact.hours}</span>
            </li>
          </ul>
        </div>
        <div class="sf-about-support__actions">
          <a class="sf-btn sf-about-support__btn" href={about.supportCta.ctaPrimary.href}>
            {about.supportCta.ctaPrimary.label}
          </a>
          <a class="sf-btn sf-about-support__btn" href={about.supportCta.ctaSecondary.href}>
            {about.supportCta.ctaSecondary.label}
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter tenant={tenant} />
</BaseLayout>
