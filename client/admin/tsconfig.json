{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.smoke.ts",
    "src/modules/content/kit-video-phase05.verify.ts",
    "src/modules/content/kit-video-phase05.golden.ts",
    "src/modules/content/kit-video-phase05.reanalyze.ts",
    "src/modules/content/kit-video-phase05.integrity.ts",
    "src/modules/content/kit-video-phase06.golden.ts",
    "src/modules/content/kit-video-phase06.preflight.ts"
  ]
}
