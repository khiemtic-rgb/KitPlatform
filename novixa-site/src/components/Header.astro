---
import { t } from '../i18n';

const m = t('vi');
const base = '/vi';
const path = Astro.url.pathname;
const n = m.nav;

const isHome = path === `${base}/` || path === base || path === '/';
const knowledgeActive =
  path.startsWith(`${base}/kien-thuc`) ||
  (path.startsWith(`${base}/tin-tuc`) && !path.includes('tai-lieu'));
const docsActive = path.startsWith(`${base}/tai-lieu`);
const pharmacyActive = path.startsWith(`${base}/nha-thuoc`);
const peopleActive = path.startsWith(`${base}/nguoi-dan`);
const healthCheckActive = path.startsWith(`${base}/health-check`) || path.startsWith(`${base}/spa-health-check`);
const pricingActive = path.startsWith(`${base}/giai-phap-chi-phi`);
const contactActive = path.startsWith(`${base}/lien-he`);
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a href={`${base}/`} class="logo">
      <span class="logo-crop" aria-hidden="true">
        <img class="logo-img" src="/images/logo.png" alt="" width="160" height="160" decoding="async" />
      </span>
      <span class="logo-stack">
        <span class="logo-text">NOVIXA</span>
        <span class="logo-tagline">{n.logoSubtitle}</span>
      </span>
    </a>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">{n.menuOpen}</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" data-nav aria-label="Menu chính">
      <a href={`${base}/`} class:list={{ active: isHome }}>{n.home}</a>
      <a href={`${base}/nha-thuoc/`} class:list={{ active: pharmacyActive && !peopleActive }}>{n.forPharmacy}</a>
      <a href={`${base}/health-check/`} class:list={{ active: healthCheckActive }}>{n.assess}</a>
      <a href={`${base}/nguoi-dan/`} class:list={{ active: peopleActive }}>{n.forPeople}</a>
      <a href={`${base}/kien-thuc/`} class:list={{ active: knowledgeActive }}>{n.resources}</a>

      <div class="nav-item nav-item--dropdown" data-dropdown class:list={{ active: docsActive }}>
        <button
          type="button"
          class="nav-trigger"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="docs-dropdown"
          data-dropdown-trigger
          class:list={{ active: docsActive }}
        >
          {n.docs}
          <span class="nav-chevron" aria-hidden="true">▾</span>
        </button>
        <div id="docs-dropdown" class="nav-dropdown" role="menu" aria-label="Tài liệu nhà thuốc" data-dropdown-panel>
          <a
            href={`${base}/tai-lieu/`}
            role="menuitem"
            class:list={{ active: docsActive && !path.includes('/van-ban-phap-luat') }}
          >
            Tài liệu nhà thuốc
          </a>
          <a
            href={`${base}/tai-lieu/van-ban-phap-luat/`}
            role="menuitem"
            class:list={{ active: path.includes('/van-ban-phap-luat') }}
          >
            Văn bản pháp luật
          </a>
        </div>
      </div>

      <a href={`${base}/giai-phap-chi-phi/`} class:list={{ active: pricingActive }}>{n.pricing}</a>
      <a href={`${base}/lien-he/`} class:list={{ active: contactActive }}>{n.contact}</a>
    </nav>

    <div class="nav-actions">
      <a href="https://app.novixa.vn" class="nav-login">{n.login}</a>
      <a href={`${base}/lien-he/`} class="nav-cta">{n.demo}</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  const dropdownItems = [...document.querySelectorAll('[data-dropdown]')];

  const isDesktopNav = () => window.matchMedia('(min-width: 1361px)').matches;

  const syncHeader = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 12);
  };

  const dropdownTimers = new WeakMap();

  const getDropdownTimer = (el) => {
    let timer = dropdownTimers.get(el);
    if (!timer) {
      timer = { id: null };
      dropdownTimers.set(el, timer);
    }
    return timer;
  };

  const setOpen = (el, trigger, open, timerRef, { immediate = false } = {}) => {
    window.clearTimeout(timerRef.id);
    if (open) {
      el?.classList.add('is-open');
      trigger?.setAttribute('aria-expanded', 'true');
      return;
    }
    const close = () => {
      el?.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
    };
    if (immediate || !isDesktopNav()) {
      close();
      return;
    }
    timerRef.id = window.setTimeout(close, 220);
  };

  const closeAllDropdowns = (opts) => {
    dropdownItems.forEach((item) => {
      setOpen(item, item.querySelector('[data-dropdown-trigger]'), false, getDropdownTimer(item), opts);
    });
  };

  const setDropdownOpen = (item, open, opts) => {
    if (open) {
      dropdownItems.forEach((other) => {
        if (other === item) return;
        setOpen(other, other.querySelector('[data-dropdown-trigger]'), false, getDropdownTimer(other), {
          immediate: true,
        });
      });
    }
    setOpen(item, item.querySelector('[data-dropdown-trigger]'), open, getDropdownTimer(item), opts);
  };

  syncHeader();
  window.addEventListener('scroll', syncHeader, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('nav-open');
    nav?.classList.toggle('is-open', Boolean(open));
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
    if (!open) closeAllDropdowns({ immediate: true });
  });

  dropdownItems.forEach((item) => {
    const trigger = item.querySelector('[data-dropdown-trigger]');
    item.addEventListener('pointerenter', () => {
      if (isDesktopNav()) setDropdownOpen(item, true);
    });
    item.addEventListener('pointerleave', (event) => {
      if (!isDesktopNav()) return;
      const next = event.relatedTarget;
      if (next instanceof Node && item.contains(next)) return;
      setDropdownOpen(item, false);
    });
    trigger?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      setDropdownOpen(item, !item.classList.contains('is-open'), { immediate: true });
    });
  });

  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node)) return;
    if (dropdownItems.some((item) => item.contains(event.target))) return;
    closeAllDropdowns({ immediate: true });
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      header?.classList.remove('nav-open');
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      closeAllDropdowns({ immediate: true });
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllDropdowns({ immediate: true });
  });
</script>
