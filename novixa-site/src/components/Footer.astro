---
import { t } from '../i18n';
import { KNOWLEDGE_CATEGORIES, newsCategoryPath } from '../lib/news-categories';

const m = t('vi');
const c = m.contact;
const co = m.company;
const year = new Date().getFullYear();
const hasFacebook = Boolean(c.facebookUrl?.trim());
const zaloUrl = c.zaloPhone ? `https://zalo.me/${c.zaloPhone}` : '/vi/lien-he/';

const columns = [
  {
    title: 'Dành cho nhà thuốc',
    links: [
      { href: '/vi/giai-phap/', label: 'Giải pháp' },
      { href: '/vi/#bang-gia', label: 'Bảng giá' },
      { href: '/vi/lien-he/', label: 'Đăng ký demo' },
      { href: '/vi/tai-lieu/', label: 'Hướng dẫn / tài liệu' },
    ],
  },
  {
    title: 'Dành cho người dân',
    links: [
      { href: '/vi/giai-phap/app-khach-hang/', label: 'Tải app' },
      { href: '/vi/giai-phap/app-khach-hang/', label: 'Hướng dẫn sử dụng' },
      { href: '/vi/lien-he/', label: 'Câu hỏi thường gặp' },
    ],
  },
  {
    title: 'Kiến thức',
    links: [
      { href: '/vi/kien-thuc/', label: 'Tổng quan' },
      ...KNOWLEDGE_CATEGORIES.slice(0, 4).map((cat) => ({
        href: newsCategoryPath(cat.id),
        label: cat.label,
      })),
    ],
  },
  {
    title: 'Hỗ trợ',
    links: [
      { href: '/vi/lien-he/', label: 'Trung tâm hỗ trợ' },
      { href: '/vi/lien-he/', label: 'Chính sách bảo mật' },
      { href: '/vi/lien-he/', label: 'Điều khoản sử dụng' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/vi/" class="footer-logo">
        <span class="logo-mark" aria-hidden="true">N</span>
        <span class="footer-logo__text">
          <strong>NOVIXA</strong>
          <small>Healthcare Platform</small>
        </span>
      </a>
      <p>
        Nền tảng AI kết nối nhà thuốc – người dân – phòng khám, giúp tăng khách quay lại và chăm sóc sức khỏe cộng đồng.
      </p>
      <div class="footer-social">
        {
          hasFacebook && (
            <a
              class="footer-social__btn"
              href={c.facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M14.5 8.5H16V6h-1.7C12.3 6 11 7.4 11 9.3V11H9v2.5h2V18h2.7v-4.5H16L16.4 11H13.7V9.5c0-.6.3-1 1-1z"
                />
              </svg>
            </a>
          )
        }
        <a class="footer-social__btn" href={zaloUrl} target="_blank" rel="noopener noreferrer" aria-label="Zalo">
          <span aria-hidden="true">Z</span>
        </a>
        <a class="footer-social__btn" href={`mailto:${c.emailAddress}`} aria-label="Email">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4 6h16v12H4V6zm8 6.7L5.8 8h12.4L12 12.7z" />
          </svg>
        </a>
      </div>
      <div class="footer-legal">
        <p class="footer-provider">
          {co.providerLabel}{' '}
          <a class="footer-link footer-link--inline" href={co.providerUrl} target="_blank" rel="noopener noreferrer">
            {co.providerName}
          </a>
        </p>
        <p>{co.legalName}</p>
        <p>{co.addressShort}</p>
      </div>
    </div>

    {
      columns.map((column) => (
        <div class="footer-column">
          <h2>{column.title}</h2>
          {column.links.map((link) => (
            <a class="footer-link" href={link.href}>
              {link.label}
            </a>
          ))}
        </div>
      ))
    }

    <div class="footer-column footer-contact">
      <h2>Liên hệ</h2>
      <a class="footer-link" href={`tel:${c.phoneTel}`}>{c.phoneDisplay}</a>
      <a class="footer-link" href={`mailto:${c.emailAddress}`}>{c.emailAddress}</a>
      <a class="footer-link" href="https://novixa.vn/" target="_blank" rel="noopener noreferrer">novixa.vn</a>
      <p class="footer-address">{co.address}</p>
      <p class="footer-copy">© {year} Novixa. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0a1b2e;
    color: #d9e6f3;
    padding: clamp(3rem, 7vw, 4.5rem) 0 2.25rem;
    font-size: 0.9rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem 1.35rem;
    grid-template-columns: 1.4fr repeat(4, minmax(0, 0.92fr)) 1.15fr;
    align-items: start;
  }

  .footer-brand p {
    max-width: 34ch;
    margin: 1rem 0 0;
    color: #a9bfd5;
    line-height: 1.55;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #fff;
    text-decoration: none;
  }

  .footer-logo__text {
    display: grid;
    gap: 0.05rem;
    line-height: 1.1;
  }

  .footer-logo__text strong {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .footer-logo__text small {
    color: #b7c9db;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: #16c784;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .footer-legal {
    margin-top: 1rem;
    font-size: 0.72rem;
    color: #7f94a8;
  }

  .footer-legal p {
    margin: 0.12rem 0;
    max-width: none;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.15rem;
  }

  .footer-social__btn {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 999px;
    background: #3d6ea8;
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 800;
    transition: background 150ms ease, transform 150ms ease;
  }

  .footer-social__btn:hover {
    background: #16c784;
    transform: translateY(-1px);
  }

  .footer-social__btn svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .footer-column h2 {
    margin: 0 0 0.9rem;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-link {
    display: block;
    color: #a9bfd5;
    text-decoration: none;
    margin: 0.4rem 0;
  }

  .footer-link:hover {
    color: #16c784;
  }

  .footer-link--inline {
    display: inline;
    margin: 0;
  }

  .footer-address {
    margin: 0.65rem 0 0;
    color: #7f94a8;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .footer-copy {
    margin: 1rem 0 0;
    color: #7f94a8;
    font-size: 0.78rem;
  }

  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
