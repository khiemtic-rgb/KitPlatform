---
import { homeLanding as h } from '../../lib/home-landing';
---

<section class="hl-trio section" aria-label="Vấn đề, giải pháp và vòng đời khách hàng">
  <div class="container hl-trio__grid">
    <article class="hl-card">
      <h2>{h.problems.title}</h2>
      <ul class="hl-icon-grid">
        {
          h.problems.items.map((item) => (
            <li>
              <span class="hl-icon hl-icon--blue" aria-hidden="true">!</span>
              <div>
                <strong>{item.title}</strong>
                <p>{item.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="hl-card">
      <h2>{h.solutions.title}</h2>
      <div class="hl-orbit">
        <div class="hl-orbit__core" aria-hidden="true">N</div>
        <ul>
          {
            h.solutions.items.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <p>{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </article>

    <article class="hl-card">
      <h2>{h.lifecycle.title}</h2>
      <ol class="hl-cycle">
        {h.lifecycle.steps.map((step) => <li>{step}</li>)}
      </ol>
    </article>
  </div>
</section>
