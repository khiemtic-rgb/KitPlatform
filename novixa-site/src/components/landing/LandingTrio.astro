---
import { homeLanding as h } from '../../lib/home-landing';

const painIcons = [
  '<path d="M12 5a4 4 0 1 1-4 4 4 4 0 0 1 4-4Zm0 10c-3.5 0-7 1.7-7 3.5V20h14v-1.5C19 16.7 15.5 15 12 15Z"/>',
  '<path d="M4 6h11l5 5v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Zm11 1.5V11h3.2L15 7.5Z"/>',
  '<path d="M12 3a9 9 0 1 0 9 9A9 9 0 0 0 12 3Zm.8 4.5v4.2l3.4 2-0.8 1.3L11 12.3V7.5h1.8Z"/>',
  '<path d="M8 11a3 3 0 1 1 3-3 3 3 0 0 1-3 3Zm8 0a3 3 0 1 1 3-3 3 3 0 0 1-3 3ZM8 13c-2.8 0-5.5 1.4-5.5 3v1.5h7.2A5.4 5.4 0 0 1 12 13.2 5.4 5.4 0 0 1 14.3 17.5H21.5V16c0-1.6-2.7-3-5.5-3A5.6 5.6 0 0 0 12 14.4 5.6 5.6 0 0 0 8 13Z"/>',
  '<path d="M4 5h16v10H8l-4 3.5V5Zm3 3v1.5h10V8H7Zm0 3.5V13h7v-1.5H7Z"/>',
  '<path d="M4 6h7v5H4V6Zm9 0h7v5h-7V6ZM4 13h7v5H4v-5Zm9 0h7v5h-7v-5Z"/>',
] as const;

const solutionShort = ['Giữ chân KH', 'Nhắc uống AI', 'CSKH sau bán', 'Doanh thu bền'];
---

<section class="hl-trio section" aria-label="Vấn đề, giải pháp và vòng đời khách hàng">
  <div class="container hl-trio__grid">
    <article class="hl-card hl-card--pain">
      <h2>{h.problems.title}</h2>
      <ul class="hl-pain-grid">
        {
          h.problems.items.map((item, i) => (
            <li>
              <span
                class="hl-pain-ico"
                aria-hidden="true"
                set:html={`<svg viewBox="0 0 24 24" fill="currentColor">${painIcons[i]}</svg>`}
              />
              <strong>{item.title}</strong>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="hl-card hl-card--solution">
      <h2>{h.solutions.title}</h2>
      <div class="hl-orbit">
        <div class="hl-orbit__ring"></div>
        <div class="hl-orbit__core" aria-hidden="true">N</div>
        {
          h.solutions.items.map((item, i) => (
            <span class={`hl-orbit__node hl-orbit__node--${i + 1}`} title={item.title}>
              {solutionShort[i] ?? item.title}
            </span>
          ))
        }
      </div>
    </article>

    <article class="hl-card hl-card--cycle">
      <h2>{h.lifecycle.title}</h2>
      <ol class="hl-cycle-ring" aria-label="Vòng đời khách hàng">
        {
          h.lifecycle.steps.map((step, i) => (
            <li class={`hl-cycle-ring__step hl-cycle-ring__step--${i + 1}`}>
              <span>{step}</span>
            </li>
          ))
        }
        <li class="hl-cycle-ring__hub" aria-hidden="true">
          <span>Novixa</span>
        </li>
      </ol>
    </article>
  </div>
</section>
