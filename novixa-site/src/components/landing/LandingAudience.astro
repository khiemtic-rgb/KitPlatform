---
import { homeLanding as h } from '../../lib/home-landing';
---

<section class="hl-audience section" aria-label="Đối tượng sử dụng">
  <div class="container hl-audience__grid">
    <article class="hl-card-aud hl-card-aud--pharmacy" id="nha-thuoc">
      <div class="hl-card-aud__media">
        <img src={h.pharmacy.image} alt={h.pharmacy.imageAlt} width="720" height="960" loading="lazy" decoding="async" />
      </div>
      <div class="hl-card-aud__copy">
        <p class="hl-card-aud__eyebrow">{h.pharmacy.eyebrow}</p>
        <h2 class="hl-card-aud__heading">{h.pharmacy.heading}</h2>
        <p class="hl-card-aud__lead">{h.pharmacy.title}</p>
        <ul>
          {h.pharmacy.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="hl-btn hl-btn--green" href={h.pharmacy.ctaHref}>
          {h.pharmacy.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    <article class="hl-card-aud hl-card-aud--people" id="nguoi-dan">
      <div class="hl-card-aud__copy">
        <p class="hl-card-aud__eyebrow">{h.people.eyebrow}</p>
        <h2 class="hl-card-aud__heading">{h.people.heading}</h2>
        <p class="hl-card-aud__lead">{h.people.title}</p>
        <ul>
          {h.people.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="hl-btn hl-btn--primary" href={h.people.ctaHref}>
          {h.people.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hl-card-aud__media">
        <img src={h.people.image} alt={h.people.imageAlt} width="720" height="960" loading="lazy" decoding="async" />
      </div>
    </article>
  </div>
</section>
