---
import { homeLanding as h } from '../../lib/home-landing';
---

<section class="hl-why section" aria-labelledby="hl-why-title">
  <div class="container">
    <h2 id="hl-why-title" class="hl-why__title">{h.why.title}</h2>
    <ul class="hl-why__stats">
      {
        h.why.stats.map((stat) => (
          <li>
            <span class="hl-why__ico" aria-hidden="true" />
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="hl-eco" id="ecosystem">
      <h2 class="hl-eco__title">{h.ecosystem.title}</h2>
      <div class="hl-eco__diagram" aria-hidden="true">
        <span class="hl-eco__node hl-eco__node--top">{h.ecosystem.nodes[0]}</span>
        <span class="hl-eco__node hl-eco__node--left">{h.ecosystem.nodes[1]}</span>
        <span class="hl-eco__node hl-eco__node--right">{h.ecosystem.nodes[2]}</span>
        <span class="hl-eco__ring" />
        <span class="hl-eco__core">{h.ecosystem.center}</span>
      </div>
    </div>
  </div>
</section>

<section class="hl-pricing section" id="bang-gia" aria-labelledby="hl-pricing-title">
  <div class="container hl-pricing__box">
    <div>
      <h2 id="hl-pricing-title">Bảng giá linh hoạt theo quy mô nhà thuốc</h2>
      <p>
        Novixa triển khai theo giai đoạn founding — mức ưu đãi và gói phù hợp (một cửa hay chuỗi) sẽ được tư vấn
        rõ trong buổi demo.
      </p>
    </div>
    <a class="hl-btn hl-btn--primary" href="/vi/lien-he/">Nhận tư vấn bảng giá</a>
  </div>
</section>
