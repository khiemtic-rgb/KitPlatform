---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { t } from '../../i18n';
import { contactLanding as p } from '../../lib/contact-landing';
import '../../styles/global.css';
import '../../styles/contact-landing.css';

const m = t('vi');
const c = m.contact;
const co = m.company;
const sent = Astro.url.searchParams.get('sent') === '1';

const nextUrl = new URL(Astro.url);
nextUrl.searchParams.set('sent', '1');
nextUrl.hash = 'contact-form';

const mapQuery = encodeURIComponent(co.address);
const mapEmbed = `https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`;
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

const icon = (d: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;

const hiIcons = [
  icon('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>'),
  icon('<path d="M13 3.5 5.5 12H11l-.8 8.5L18.5 12H13V3.5z"/>'),
  icon(
    '<path d="M12 3.2 19 6v5.2c0 4.6-2.9 8-7 9.6-4.1-1.6-7-5-7-9.6V6l7-2.8z"/><path d="m9 12.1 2 2 4.2-4.2"/>',
  ),
] as const;

const infoIcons = [
  icon('<path d="M22 16.9v2a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h2a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L7.1 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6A2 2 0 0 1 22 16.9z"/>'),
  icon('<path d="M4 6h16v12H4V6zm8 6.7L5.8 8h12.4L12 12.7z"/>'),
  icon('<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>'),
  icon(
    '<path d="M5.2 11.2a6.8 6.8 0 0 1 13.6 0v3.2a1.8 1.8 0 0 1-1.8 1.8h-.7"/><path d="M5.2 11.2v3.2a1.8 1.8 0 0 0 1.8 1.8h.7"/><circle cx="12" cy="8.2" r="2.2"/>',
  ),
] as const;

const whyIcons = [
  icon('<path d="M12 3.2 19 6v5.2c0 4.6-2.9 8-7 9.6-4.1-1.6-7-5-7-9.6V6l7-2.8z"/><path d="m9 12.1 2 2 4.2-4.2"/>'),
  icon(
    '<path d="M5.2 11.2a6.8 6.8 0 0 1 13.6 0v3.2a1.8 1.8 0 0 1-1.8 1.8h-.7"/><path d="M5.2 11.2v3.2a1.8 1.8 0 0 0 1.8 1.8h.7"/><circle cx="12" cy="8.2" r="2.2"/><path d="M10 19.2h4"/>',
  ),
  icon('<path d="M12 4v2"/><path d="M8 8.5a4 4 0 0 1 8 0v1H8v-1z"/><path d="M6.5 9.5h11v2.2l-1.3.8v5H7.8v-5l-1.3-.8V9.5z"/><path d="M9.5 20h5"/>'),
  icon('<path d="M5 18h14M7.5 14V18M11 10V18M14.5 12.5V18M18 8V18M8.2 10.2l3.3-3 2.4 1.8 3.8-3.8"/>'),
  icon('<path d="M12 3.5 14 9h5l-4 3.2 1.5 5L12 14.5 7.5 17.2 9 12.2 5 9h5L12 3.5Z"/>'),
] as const;
---

<BaseLayout title={p.meta.title} description={p.meta.description} canonicalPath="/vi/lien-he/">
  <Header slot="header" />

  <div class="ct-page">
    <section class="ct-hero" aria-labelledby="ct-hero-title">
      <div class="container">
        <nav class="ct-crumb" aria-label="Breadcrumb">
          <a href="/vi/">Trang chủ</a>
          <span aria-hidden="true">›</span>
          <span>Liên hệ</span>
        </nav>

        <div class="ct-hero__grid">
          <div>
            <p class="ct-eyebrow">{p.hero.eyebrow}</p>
            <h1 id="ct-hero-title" class="ct-hero__title">
              {p.hero.titleBefore}<em>{p.hero.titleAccent}</em>{p.hero.titleAfter}
            </h1>
            <p class="ct-hero__lead">{p.hero.lead}</p>
            <ul class="ct-hero__highlights">
              {
                p.hero.highlights.map((item, i) => (
                  <li class={`ct-hi ct-hi--${item.tone}`}>
                    <span class="ct-hi__icon" aria-hidden="true" set:html={hiIcons[i]} />
                    <span>{item.title}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="ct-form-card" id={p.form.id}>
            <h2>
              {p.form.titleBefore}<em>{p.form.titleAccent}</em>
            </h2>

            {
              sent && (
                <div class="ct-alert" role="status">
                  <strong>{c.successTitle}</strong>
                  <p>{c.successMessage}</p>
                </div>
              )
            }

            <form
              class="ct-form"
              method="POST"
              action={`https://formsubmit.co/${encodeURIComponent(c.emailAddress)}`}
            >
              <input type="hidden" name="_subject" value="Đăng ký tư vấn / Demo từ novixa.vn" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_next" value={nextUrl.toString()} />
              <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

              <div class="ct-field">
                <label for="name">{p.form.name} *</label>
                <input id="name" name="name" type="text" required autocomplete="name" />
              </div>

              <div class="ct-field-row">
                <div class="ct-field">
                  <label for="phone">{p.form.phone} *</label>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    required
                    autocomplete="tel"
                    inputmode="tel"
                  />
                </div>
                <div class="ct-field">
                  <label for="email">{p.form.email}</label>
                  <input id="email" name="email" type="email" autocomplete="email" />
                </div>
              </div>

              <div class="ct-field-row">
                <div class="ct-field">
                  <label for="role">{p.form.role}</label>
                  <select id="role" name="role">
                    <option value="">{p.form.rolePlaceholder}</option>
                    {p.form.roleOptions.map((opt) => <option value={opt}>{opt}</option>)}
                  </select>
                </div>
                <div class="ct-field">
                  <label for="scale">{p.form.scale}</label>
                  <select id="scale" name="scale">
                    <option value="">{p.form.scalePlaceholder}</option>
                    {p.form.scaleOptions.map((opt) => <option value={opt}>{opt}</option>)}
                  </select>
                </div>
              </div>

              <div class="ct-field">
                <label for="message">{p.form.needs} *</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  placeholder={p.form.needsPlaceholder}
                ></textarea>
              </div>

              <label class="ct-consent">
                <input type="checkbox" name="consent" value="yes" required />
                <span>{p.form.consent}</span>
              </label>

              <button class="ct-btn ct-btn--green ct-btn--block" type="submit">{p.form.submit}</button>
              <p class="ct-form-note">{p.form.note}</p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="ct-info" aria-labelledby="ct-info-title">
      <div class="container ct-info__grid">
        <div class="ct-info-card">
          <h2 id="ct-info-title">{p.info.title}</h2>
          <ul class="ct-info-list">
            {
              p.info.items.map((item, i) => (
                <li>
                  <span class="ct-info-list__icon" aria-hidden="true" set:html={infoIcons[i]} />
                  <div>
                    <strong>{item.label}</strong>
                    {'valueKey' in item && item.valueKey === 'phone' ? (
                      <a href={`tel:${c.phoneTel}`}>{c.phoneDisplay}</a>
                    ) : 'valueKey' in item && item.valueKey === 'email' ? (
                      <a href={`mailto:${c.emailAddress}`}>{c.emailAddress}</a>
                    ) : (
                      <span>{'value' in item ? item.value : ''}</span>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="ct-info-card">
          <h2>{p.office.title}</h2>
          <p class="ct-office__addr">{co.address}</p>
          <a
            class="ct-btn ct-btn--outline"
            href={directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {p.office.directions}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="ct-map">
          <iframe
            title="Bản đồ văn phòng Novixa"
            src={mapEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <section class="ct-why" aria-labelledby="ct-why-title">
      <div class="container">
        <h2 id="ct-why-title" class="ct-why__title">{p.why.title}</h2>
        <div class="ct-why__grid">
          {
            p.why.items.map((item, i) => (
              <article class="ct-why-card">
                <div class="ct-why-card__icon" aria-hidden="true" set:html={whyIcons[i]} />
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ct-faq" id={p.faq.id} aria-labelledby="ct-faq-title">
      <div class="container ct-faq__grid">
        <div>
          <h2 id="ct-faq-title" class="ct-faq__title">{p.faq.title}</h2>
          <p class="ct-faq__lead">Những câu hỏi nhà thuốc thường hỏi trước khi đăng ký demo.</p>
        </div>
        <div class="ct-faq__list">
          {
            p.faq.items.map((item, i) => (
              <details class="ct-faq__item" open={i === 0}>
                <summary>{item.q}</summary>
                <p>
                  {item.a}
                  {'linkHref' in item && item.linkHref ? (
                    <>
                      {' '}
                      <a href={item.linkHref}>{item.linkLabel}</a>.
                    </>
                  ) : null}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
