---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ASSESSMENT } from '../../lib/assessment';
import '../../styles/global.css';
import '../../styles/health-check.css';
import '../../styles/health-check-pharmacy.css';

const assessmentUrl = ASSESSMENT.pharmacy.surveyUrl;

const title = 'Health Check nhà thuốc miễn phí';
const description =
  '31 câu, khoảng 7–10 phút. Làm bài không cần đăng ký, xem kết quả sơ bộ ngay, để lại số điện thoại nếu muốn báo cáo đầy đủ.';

const outcomes = [
  { icon: 'chart', label: 'Chỗ đang để lọt tiền: hàng hết hạn, hết hàng khi khách hỏi' },
  { icon: 'retain', label: 'Khả năng giữ chân khách quen' },
  { icon: 'risk', label: 'Rủi ro vận hành & tồn kho' },
  { icon: 'priority', label: 'Ba việc nên làm trước — làm được ngay tuần này' },
  { icon: 'roadmap', label: 'Lộ trình cải thiện theo giai đoạn' },
];

const meta = [
  { icon: 'list', label: '31 câu hỏi' },
  { icon: 'clock', label: 'khoảng 7–10 phút' },
  { icon: 'flash', label: 'Kết quả ngay' },
  { icon: 'user', label: 'Không đăng ký' },
];

const whyCards = [
  {
    icon: 'search',
    title: 'Nhìn rõ bức tranh thực tế',
    desc: 'Thấy rõ điểm mạnh, điểm yếu trong vận hành.',
  },
  {
    icon: 'warning',
    title: 'Phát hiện rủi ro sớm',
    desc: 'Giảm thiểu sai sót, thất thoát và hàng tồn kém hiệu quả.',
  },
  {
    icon: 'trophy',
    title: 'Thấy chỗ đang để lọt tiền',
    desc: 'Hàng hết hạn và hết hàng khi khách hỏi, ước tính từ số anh/chị nhập.',
  },
  {
    icon: 'clipboard',
    title: 'Ưu tiên đúng việc',
    desc: 'Biết việc gì cần làm ngay, việc gì làm sau.',
  },
  {
    icon: 'rocket',
    title: 'Biết việc làm trong 30 ngày',
    desc: 'Ba việc nên làm trước, việc nào cũng làm được ngay tuần này.',
  },
];

const receiveItems = [
  {
    title: 'Kết quả sơ bộ ngay',
    desc: '6 nhóm: Khách hàng, Vận hành, Kho, Kinh doanh, Dữ liệu & Công nghệ, Phát triển.',
  },
  {
    title: 'Báo cáo đầy đủ khi để lại số điện thoại',
    desc: 'Điểm mạnh, chỗ đang nghẽn và lộ trình 30–60–90 ngày. Không cần đăng ký tài khoản.',
  },
  {
    title: 'Thang điểm',
    desc: 'Dưới 40 Cần cải thiện · 40–59 Cơ bản · 60–79 Khá tốt · từ 80 Xuất sắc.',
  },
  {
    title: 'Cuộc gọi 10–15 phút',
    desc: 'Chỉ khi anh/chị đồng ý. Không đồng ý vẫn xem được báo cáo.',
  },
];

const dimensions = [
  { label: 'Khách hàng', value: 68 },
  { label: 'Vận hành', value: 48 },
  { label: 'Kho', value: 54 },
  { label: 'Kinh doanh', value: 61 },
  { label: 'Dữ liệu & Công nghệ', value: 57 },
  { label: 'Phát triển', value: 52 },
];

const score = 62;
const gaugePct = Math.round((score / 100) * 283); // circumference ~ 2πr with r=45
---

<BaseLayout title={title} description={description} canonicalPath="/vi/health-check/">
  <Header slot="header" />

  <div class="hc-page hc-page--v2">
    <section class="hc-v2-hero">
      <div class="hc-container hc-v2-hero__grid">
        <div class="hc-v2-hero__copy">
          <h1 class="hc-v2-hero__title">Nhà thuốc vẫn bán tốt — nhưng có đang để lọt tiền?</h1>
          <p class="hc-v2-hero__sub">Doanh thu tốt không có nghĩa nhà thuốc đang vận hành tốt.</p>
          <p class="hc-v2-hero__lead">
            Miễn phí, không cần đăng ký. Xem kết quả sơ bộ ngay, để lại số điện thoại để xem báo cáo đầy đủ. Nếu đồng ý thì có cuộc gọi 10–15 phút.
          </p>

          <div class="hc-v2-hero__actions">
            <a id="hc-cta-top" class="hc-v2-btn hc-v2-btn--primary" href={assessmentUrl}>
              Nhận Health Check miễn phí ngay
              <span aria-hidden="true">→</span>
            </a>
            <a class="hc-v2-link" href="#mau-ket-qua">Xem mẫu kết quả</a>
          </div>
          <div class="hc-v2-meta">
            {
              meta.map((item) => (
                <span class="hc-v2-meta__chip">
                  <span aria-hidden="true">
                    {item.icon === 'list' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <path d="M8 7h11M8 12h11M8 17h11M5 7h.01M5 12h.01M5 17h.01" stroke-linecap="round" />
                      </svg>
                    )}
                    {item.icon === 'clock' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <circle cx="12" cy="12" r="8" />
                        <path d="M12 8v4l2.5 1.5" stroke-linecap="round" />
                      </svg>
                    )}
                    {item.icon === 'flash' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <path d="M13 3L5 14h6l-1 7 8-11h-6l1-7z" stroke-linejoin="round" />
                      </svg>
                    )}
                    {item.icon === 'user' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <circle cx="12" cy="8" r="3.5" />
                        <path d="M5 19c1-3.2 3.6-5 7-5s6 1.8 7 5" stroke-linecap="round" />
                      </svg>
                    )}
                  </span>
                  {item.label}
                </span>
              ))
            }
          </div>


          <ul class="hc-v2-outcomes">
            {
              outcomes.map((item) => (
                <li>
                  <span class="hc-v2-outcomes__icon" data-icon={item.icon} aria-hidden="true">
                    {item.icon === 'chart' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <path d="M4 19V5M4 19h16" stroke-linecap="round" />
                        <path d="M8 15l3-4 3 2 4-6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    {item.icon === 'ready' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <path d="M12 3l1.8 4.8L19 9.5l-3.8 3.2L16.4 18 12 15.4 7.6 18l1.2-5.3L5 9.5l5.2-1.7L12 3z" stroke-linejoin="round" />
                      </svg>
                    )}
                    {item.icon === 'retain' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <circle cx="9" cy="8" r="3" />
                        <circle cx="17" cy="9" r="2.5" />
                        <path d="M3.5 19c.6-3 3-5 5.5-5s4.9 2 5.5 5M14 19c.4-2 1.8-3.5 3.5-3.5 1.4 0 2.6.9 3.2 2.2" stroke-linecap="round" />
                      </svg>
                    )}
                    {item.icon === 'priority' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <circle cx="12" cy="12" r="8" />
                        <circle cx="12" cy="12" r="4" />
                        <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
                      </svg>
                    )}
                    {item.icon === 'risk' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <path d="M4 8h12v11H4zM16 11h4v8h-4zM7 8V6a2 2 0 012-2h2a2 2 0 012 2v2" stroke-linejoin="round" />
                      </svg>
                    )}
                    {item.icon === 'roadmap' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                        <path d="M5 19V5M5 19h14" stroke-linecap="round" />
                        <path d="M9 15V9M13 15v-3M17 15V7" stroke-linecap="round" />
                      </svg>
                    )}
                  </span>
                  <span>{item.label}</span>
                </li>
              ))
            }
          </ul>



          <ul class="hc-v2-trust">
            <li>
              <span aria-hidden="true">✓</span>
              Không cần đăng ký
            </li>
            <li>
              <span aria-hidden="true">✓</span>
              Không cần cài đặt
            </li>
            <li>
              <span aria-hidden="true">✓</span>
              Xem sơ bộ ngay — báo cáo đầy đủ khi bạn muốn nhận
            </li>
          </ul>
        </div>

        <div class="hc-v2-hero__visual" aria-hidden="true">
          <div class="hc-v2-scene">
            <div class="hc-v2-maturity">
              <p class="hc-v2-maturity__label">Điểm trưởng thành</p>
              <div class="hc-v2-gauge">
                <svg viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="45" class="hc-v2-gauge__track" />
                  <circle
                    cx="60"
                    cy="60"
                    r="45"
                    class="hc-v2-gauge__value"
                    style={`stroke-dasharray: ${gaugePct} 283`}
                  />
                </svg>
                <div class="hc-v2-gauge__text">
                  <strong>{score}<small>/100</small></strong>
                  <span>Khá tốt</span>
                </div>
              </div>
              <ul class="hc-v2-bars">
                {
                  dimensions.map((d) => (
                    <li>
                      <div class="hc-v2-bars__row">
                        <span>{d.label}</span>
                        <em>{d.value}/100</em>
                      </div>
                      <div class="hc-v2-bars__track">
                        <span style={`width:${d.value}%`} />
                      </div>
                    </li>
                  ))
                }
              </ul>
              <aside class="hc-v2-opportunity">
                <strong>Hình minh họa, không phải kết quả thật</strong>
                <p>Điểm 62/100 trên thang này là Khá tốt. Dưới 40 Cần cải thiện, 40–59 Cơ bản, 60–79 Khá tốt, từ 80 Xuất sắc.</p>
              </aside>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="hc-v2-why">
      <div class="hc-container">
        <h2 class="hc-v2-section-title">Vì sao chủ nhà thuốc nên thực hiện Health Check?</h2>
        <div class="hc-v2-why__grid">
          {
            whyCards.map((card) => (
              <article class="hc-v2-why__card">
                <span class="hc-v2-why__icon" data-icon={card.icon} aria-hidden="true">
                  {card.icon === 'search' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                      <circle cx="11" cy="11" r="6.5" />
                      <path d="M16 16l4 4" stroke-linecap="round" />
                    </svg>
                  )}
                  {card.icon === 'warning' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                      <path d="M12 4l9 16H3L12 4z" stroke-linejoin="round" />
                      <path d="M12 10v4M12 17h.01" stroke-linecap="round" />
                    </svg>
                  )}
                  {card.icon === 'trophy' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                      <path d="M8 4h8v5a4 4 0 01-8 0V4zM8 5H5a2 2 0 000 4h3M16 5h3a2 2 0 010 4h-3M10 20h4M12 13v7" stroke-linejoin="round" />
                    </svg>
                  )}
                  {card.icon === 'clipboard' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                      <rect x="6" y="5" width="12" height="15" rx="2" />
                      <path d="M9 5V4h6v1M9 11h6M9 15h4" stroke-linecap="round" />
                    </svg>
                  )}
                  {card.icon === 'rocket' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                      <path d="M14 4c3 1 5 4 6 8-4 1-7 3-8 6-4-1-7-4-8-8 4-1 7-3 10-6z" stroke-linejoin="round" />
                      <circle cx="14.5" cy="9.5" r="1.5" />
                      <path d="M7 17l-2 4M10 19l-1 3" stroke-linecap="round" />
                    </svg>
                  )}
                </span>
                <h3>{card.title}</h3>
                <p>{card.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="hc-v2-receive" id="mau-ket-qua">
      <div class="hc-container hc-v2-receive__grid">
        <div class="hc-v2-receive__copy">
          <h2 class="hc-v2-section-title hc-v2-section-title--left">Bạn sẽ nhận được gì?</h2>
          <ul class="hc-v2-checklist">
            {
              receiveItems.map((item) => (
                <li>
                  <span class="hc-v2-checklist__mark" aria-hidden="true">✓</span>
                  <div>
                    <strong>{item.title}</strong>
                    <p>{item.desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="hc-v2-receive__preview" aria-hidden="true">
          <article class="hc-v2-preview-card hc-v2-preview-card--radar">
            <p>Phân tích 6 nhóm</p>
            <svg viewBox="0 0 200 180" class="hc-v2-radar">
              <polygon points="100,16 164,48 164,112 100,144 36,112 36,48" fill="none" stroke="#d1e7e5" />
              <polygon points="100,36 148,60 148,108 100,132 52,108 52,60" fill="none" stroke="#d1e7e5" />
              <polygon points="100,28 156,54 150,116 100,138 44,110 48,52" fill="rgba(22,199,132,0.18)" stroke="#16c784" stroke-width="2" />
              <text x="100" y="12" text-anchor="middle">Khách hàng</text>
              <text x="168" y="46">Vận hành</text>
              <text x="168" y="124">Kho</text>
              <text x="100" y="162" text-anchor="middle">Kinh doanh</text>
              <text x="4" y="124">Dữ liệu</text>
              <text x="8" y="46">Phát triển</text>
            </svg>
          </article>

          <article class="hc-v2-preview-card hc-v2-preview-card--gauge">
            <p>Điểm tổng</p>
            <strong>62<span>/100</span></strong>
            <em>Khá tốt</em>
          </article>

          <article class="hc-v2-preview-card hc-v2-preview-card--roadmap">
            <p>Lộ trình 30 · 60 · 90 ngày</p>
            <table>
              <thead>
                <tr>
                  <th>Giai đoạn</th>
                  <th>Ưu tiên</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>30 ngày</td>
                  <td>Kiểm soát tồn kho</td>
                </tr>
                <tr>
                  <td>60 ngày</td>
                  <td>Chăm sóc khách hàng</td>
                </tr>
                <tr>
                  <td>90 ngày</td>
                  <td>Chuẩn hóa vận hành</td>
                </tr>
              </tbody>
            </table>
          </article>
        </div>
      </div>
    </section>

    <section class="hc-v2-cta">
      <div class="hc-container">
        <div class="hc-v2-cta__banner">
          <div class="hc-v2-cta__copy">
            <span class="hc-v2-cta__gift" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none">
                <rect x="8" y="20" width="32" height="22" rx="3" fill="#fff" />
                <path d="M8 26h32" stroke="#f59e0b" stroke-width="4" />
                <rect x="21" y="20" width="6" height="22" fill="#f59e0b" />
                <path d="M14 20c0-4 4-7 10-7s10 3 10 7" stroke="#fbbf24" stroke-width="3" stroke-linecap="round" />
                <ellipse cx="24" cy="15" rx="7" ry="5" fill="#fbbf24" />
              </svg>
            </span>
            <div>
              <p class="hc-v2-cta__title">Hoàn toàn miễn phí</p>
              <p class="hc-v2-cta__sub">31 câu, khoảng 7–10 phút · Không cần đăng ký · Báo cáo đầy đủ khi để lại số điện thoại</p>
            </div>
          </div>
          <div class="hc-v2-cta__action">
            <a id="hc-cta-bottom" class="hc-v2-btn hc-v2-btn--accent" href={assessmentUrl}>
              Nhận Health Check miễn phí ngay
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="hc-v2-sticky" id="hc-sticky" hidden>
    <a class="hc-v2-btn hc-v2-btn--primary" href={assessmentUrl}>
      Làm Health Check miễn phí
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <script>
    // Chuyển tiếp mã theo dõi (utm_*, ref) từ URL trang sang mọi link tới bài khảo sát,
    // để quảng cáo trỏ vào trang này không mất nguồn.
    const KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'ref'];
    const SAFE = /^[A-Za-z0-9_-]{1,100}$/;
    const params = new URLSearchParams(window.location.search);
    const carry = KEYS.filter((k) => SAFE.test(params.get(k) ?? ''));
    if (carry.length) {
      document.querySelectorAll<HTMLAnchorElement>('a[href^="https://survey.novixa.vn"]').forEach((a) => {
        const url = new URL(a.href);
        for (const k of carry) url.searchParams.set(k, params.get(k)!);
        a.href = url.toString();
      });
    }

    // Thanh nút cố định trên điện thoại: hiện khi nút đầu trang đã cuộn qua,
    // ẩn khi nút cuối trang đang trong màn hình.
    const sticky = document.getElementById('hc-sticky');
    const top = document.getElementById('hc-cta-top');
    const bottom = document.getElementById('hc-cta-bottom');
    if (sticky && top && 'IntersectionObserver' in window) {
      let topVisible = true;
      let bottomVisible = false;
      const update = () => {
        const show = !topVisible && !bottomVisible;
        sticky.hidden = !show;
        document.body.classList.toggle('hc-has-sticky', show);
      };
      new IntersectionObserver(([e]) => {
        topVisible = e.isIntersecting || e.boundingClientRect.top > 0;
        update();
      }).observe(top);
      if (bottom) {
        new IntersectionObserver(([e]) => {
          bottomVisible = e.isIntersecting;
          update();
        }).observe(bottom);
      }
    }
  </script>

  <Footer slot="footer" />
</BaseLayout>
