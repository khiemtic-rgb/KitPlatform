---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { pharmacyLanding as p } from '../../../lib/pharmacy-landing';
import '../../../styles/global.css';
import '../../../styles/pharmacy-landing.css';

const journeyIcons = [
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M5 19.5h14M7 19.5V10l5-4 5 4v9.5M10 19.5v-4h4v4"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M8.5 10.5a2.8 2.8 0 1 0-2.8-2.8 2.8 2.8 0 0 0 2.8 2.8Zm7.2 0a2.4 2.4 0 1 0-2.4-2.4 2.4 2.4 0 0 0 2.4 2.4ZM4.2 19v-.7c0-1.9 1.9-3.2 4.3-3.2h0c.8 0 1.5.2 2.1.5M19.5 19v-.7c0-1.7-1.6-2.9-3.6-2.9h0a3.8 3.8 0 0 0-1.8.4"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M12 3.8a5.8 5.8 0 0 0-5 8.8c.4.7 1.1 1.7 1.9 2.7C10.2 17 12 19.2 12 19.2s1.8-2.2 3.1-3.9c.8-1 1.5-2 1.9-2.7A5.8 5.8 0 0 0 12 3.8Zm0 3.2a2 2 0 1 1-2 2 2 2 0 0 1 2-2Z"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M12 6.2v6.3l3.8 2.2M12 3.5a8.5 8.5 0 1 0 8.5 8.5A8.5 8.5 0 0 0 12 3.5Z"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M5.5 7.5h8.8l2.2 3V17a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 4 17V9a1.5 1.5 0 0 1 1.5-1.5Zm8.8 0V10H18"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M5 18h14M7.5 14V18M11 10V18M14.5 12.5V18M18 8V18M8.2 10.2l3.3-3 2.4 1.8 3.8-3.8"/>',
] as const;

const featIcons = [
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M8.5 11a2.6 2.6 0 1 0-2.6-2.6A2.6 2.6 0 0 0 8.5 11Zm7 0a2.6 2.6 0 1 0-2.6-2.6A2.6 2.6 0 0 0 15.5 11ZM4.5 19v-.8c0-2 2-3.4 4-3.4h0c.7 0 1.4.2 2 .5M19.5 19v-.8c0-2-2-3.4-4-3.4h0a4 4 0 0 0-2 .5"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M12 3.8a5.8 5.8 0 0 0-5 8.8c.4.7 1.1 1.7 1.9 2.7C10.2 17 12 19.2 12 19.2s1.8-2.2 3.1-3.9c.8-1 1.5-2 1.9-2.7A5.8 5.8 0 0 0 12 3.8Zm0 3.2a2 2 0 1 1-2 2 2 0 0 1 2-2Z"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M12 4.5 14 9h5l-4 3.2 1.5 5L12 14.5 7.5 17.2 9 12.2 5 9h5L12 4.5Z"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M12 3.5 13.2 8l4.3 1.2L13.2 10.4 12 14.9l-1.2-4.5L6.5 9.2 10.8 8 12 3.5Z"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M5 18h14M7.5 14V18M11 10V18M14.5 12.5V18M18 8V18"/>',
] as const;

const whyIcons = [
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M5 18h14M7.5 14V18M11 10V18M14.5 12.5V18M18 8V18M8.2 10.2l3.3-3 2.4 1.8 3.8-3.8"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M4 6.5h16v3.2H4V6.5Zm0 5.2h10.5V19H4v-7.3Zm12.2 0H20V19h-3.8v-7.3Z"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M12 3.2l7 2.8v5.2c0 4.6-2.9 8-7 9.6-4.1-1.6-7-5-7-9.6V6l7-2.8z"/><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M9 12.1l2 2 4.2-4.2"/>',
  '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M8 12.5 5.8 10a1.8 1.8 0 0 1 2.5-2.5L10 9.2m4 3.3 2.2-2.5a1.8 1.8 0 1 0-2.5-2.5L12 9.2m-4.5 3.5 2.2 2.2a2 2 0 0 0 2.8 0l.8-.8"/>',
] as const;
---

<BaseLayout title={p.meta.title} description={p.meta.description} canonicalPath="/vi/nha-thuoc/">
  <Header slot="header" />

  <div class="ph-page">
    <section class="ph-hero" aria-labelledby="ph-hero-title">
      <div class="container ph-hero__grid">
        <div>
          <p class="ph-eyebrow">{p.hero.eyebrow}</p>
          <h1 id="ph-hero-title" class="ph-hero__title">{p.hero.title}</h1>
          <p class="ph-hero__lead">{p.hero.lead}</p>
          <div class="ph-hero__actions">
            <a class="ph-btn ph-btn--green" href={p.hero.primaryHref}>
              {p.hero.primary}
              <span aria-hidden="true">→</span>
            </a>
            <a class="ph-btn ph-btn--outline" href={p.hero.secondaryHref}>
              <span aria-hidden="true">▶</span>
              {p.hero.secondary}
            </a>
          </div>
          <ul class="ph-hero__trusts">
            {p.hero.trusts.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="ph-hero__visual">
          <img
            src={p.hero.image}
            alt={p.hero.imageAlt}
            width="1400"
            height="1000"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="ph-compare-title">
      <div class="container">
        <h2 id="ph-compare-title" class="ph-compare__title">{p.compare.title}</h2>
        <div class="ph-compare__grid">
          <article class="ph-card-cmp ph-card-cmp--before">
            <span class="ph-card-cmp__label">{p.compare.before.label}</span>
            <div class="ph-card-cmp__people">
              <div class="ph-card-cmp__avatars" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <strong>{p.compare.before.customers}</strong>
            </div>
            <p class="ph-card-cmp__return">{p.compare.before.returnLabel}</p>
            <div class="ph-card-cmp__chart" aria-hidden="true">
              <svg viewBox="0 0 160 56" fill="none">
                <path d="M8 14 C42 18, 72 26, 100 36 S138 50, 152 52" stroke="#e11d48" stroke-width="3" stroke-linecap="round"></path>
                <circle cx="152" cy="52" r="4" fill="#e11d48"></circle>
              </svg>
            </div>
            <p class="ph-card-cmp__metric">
              <strong>{p.compare.before.metric}</strong>
              <span>{p.compare.before.metricDesc}</span>
            </p>
          </article>

          <article class="ph-card-cmp ph-card-cmp--after">
            <span class="ph-card-cmp__label">{p.compare.after.label}</span>
            <div class="ph-card-cmp__people">
              <div class="ph-card-cmp__avatars" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
              </div>
              <strong>{p.compare.after.customers}</strong>
            </div>
            <p class="ph-card-cmp__return">{p.compare.after.returnLabel}</p>
            <div class="ph-card-cmp__chart" aria-hidden="true">
              <svg viewBox="0 0 160 56" fill="none">
                <path d="M8 48 C42 44, 72 32, 100 20 S138 8, 152 6" stroke="#12a86e" stroke-width="3" stroke-linecap="round"></path>
                <circle cx="152" cy="6" r="4" fill="#12a86e"></circle>
              </svg>
            </div>
            <p class="ph-card-cmp__metric">
              <strong>{p.compare.after.metric}</strong>
              <span>{p.compare.after.metricDesc}</span>
            </p>
          </article>

          <aside class="ph-compare__side">
            <h3>{p.compare.sideTitle}</h3>
            <ul>
              {p.compare.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="ph-journey section" aria-labelledby="ph-journey-title">
      <div class="container">
        <header class="ph-head">
          <h2 id="ph-journey-title" class="ph-title">{p.journey.title}</h2>
        </header>
        <ol class="ph-journey__track">
          {
            p.journey.steps.map((step, i) => (
              <>
                <li class="ph-journey__step">
                  <span
                    class="ph-journey__ico"
                    aria-hidden="true"
                    set:html={`<svg viewBox="0 0 24 24">${journeyIcons[i]}</svg>`}
                  />
                  <strong>{step}</strong>
                </li>
                {i < p.journey.steps.length - 1 && (
                  <li class="ph-journey__arrow" aria-hidden="true">
                    →
                  </li>
                )}
              </>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="ph-feat section" aria-labelledby="ph-feat-title">
      <div class="container">
        <header class="ph-head">
          <h2 id="ph-feat-title" class="ph-title">{p.features.title}</h2>
        </header>
        <ul class="ph-feat__grid">
          {
            p.features.items.map((item, i) => (
              <li class={`ph-feat-card ph-feat-card--${item.tone}`}>
                <span
                  class="ph-feat-card__ico"
                  aria-hidden="true"
                  set:html={`<svg viewBox="0 0 24 24">${featIcons[i]}</svg>`}
                />
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
                <div class="ph-feat-card__preview" aria-hidden="true">
                  {item.preview === 'customers' && (
                    <div class="ph-preview-ui">
                      <div class="ph-preview-ui__row">
                        Khách cần chăm sóc <span class="ph-preview-ui__badge">8</span>
                      </div>
                      <div class="ph-preview-ui__row">Sắp hết thuốc</div>
                      <div class="ph-preview-ui__row">Nhắc tái mua hôm nay</div>
                    </div>
                  )}
                  {item.preview === 'notify' && (
                    <div class="ph-preview-notify">
                      <strong>Novixa Care</strong>
                      Đến giờ uống thuốc · Nhắc mua lại sau 3 ngày
                    </div>
                  )}
                  {item.preview === 'loyalty' && (
                    <div class="ph-preview-loyalty">
                      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                        <path d="M12 4.5 14 9h5l-4 3.2 1.5 5L12 14.5 7.5 17.2 9 12.2 5 9h5L12 4.5Z"></path>
                      </svg>
                      <strong>Tích điểm đổi quà</strong>
                    </div>
                  )}
                  {item.preview === 'ai' && (
                    <div class="ph-preview-ui">
                      <div class="ph-preview-ui__row">Gợi ý cho bạn</div>
                      <div class="ph-preview-ui__row">Vitamin C · phù hợp</div>
                      <div class="ph-preview-ui__row">Men tiêu hóa</div>
                    </div>
                  )}
                  {item.preview === 'chart' && (
                    <div class="ph-preview-bars">
                      <span style="height:35%"></span>
                      <span style="height:55%"></span>
                      <span style="height:42%"></span>
                      <span style="height:70%"></span>
                      <span style="height:58%"></span>
                      <span style="height:82%"></span>
                      <span style="height:68%"></span>
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="ph-why section" aria-labelledby="ph-why-title">
      <div class="container">
        <header class="ph-head">
          <h2 id="ph-why-title" class="ph-title">{p.why.title}</h2>
        </header>
        <ul class="ph-why__grid">
          {
            p.why.items.map((item, i) => (
              <li class="ph-why-card">
                <span
                  class="ph-why-card__ico"
                  aria-hidden="true"
                  set:html={`<svg viewBox="0 0 24 24">${whyIcons[i]}</svg>`}
                />
                <strong>{item.title}</strong>
                <p>{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id={p.video.id} aria-labelledby="ph-video-title">
      <div class="container ph-video__grid">
        <div class="ph-video__copy">
          <h2 id="ph-video-title" class="ph-title">{p.video.title}</h2>
          <p class="ph-lead">{p.video.lead}</p>
          <a class="ph-btn ph-btn--green" href={p.video.ctaHref}>
            {p.video.cta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="ph-video__visual">
          <img
            src={p.video.image}
            alt={p.video.imageAlt}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <a class="ph-video__play" href={p.video.ctaHref} aria-label="Đăng ký để xem demo Novixa">
            <span aria-hidden="true">▶</span>
          </a>
        </div>
      </div>
    </section>

    <section class="ph-cta section" aria-labelledby="ph-cta-title">
      <div class="container">
        <div class="ph-cta__banner">
          <div class="ph-cta__art" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 40h32M12 40V18l12-8 12 8v22"></path>
              <path d="M22 40v-10h4v10M20 24h8M24 20v8"></path>
            </svg>
          </div>
          <div class="ph-cta__copy">
            <h2 id="ph-cta-title">{p.cta.title}</h2>
            <ul class="ph-cta__trusts">
              {p.cta.trusts.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <div class="ph-cta__actions">
            <a class="ph-btn ph-btn--light" href={p.cta.primaryHref}>
              {p.cta.primary}
              <span aria-hidden="true">→</span>
            </a>
            <a class="ph-btn ph-btn--outline-light" href={p.cta.secondaryHref}>{p.cta.secondary}</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
