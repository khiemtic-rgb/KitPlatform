---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LandingHero from '../../components/landing/LandingHero.astro';
import LandingPain from '../../components/landing/LandingPain.astro';
import LandingFlow from '../../components/landing/LandingFlow.astro';
import LandingAudience from '../../components/landing/LandingAudience.astro';
import LandingEcosystem from '../../components/landing/LandingEcosystem.astro';
import LandingCta from '../../components/landing/LandingCta.astro';
import { t } from '../../i18n';
import { buildSiteGraphStructuredData } from '../../lib/site-structured-data';
import '../../styles/global.css';
import '../../styles/home-landing.css';

const m = t('vi');
const jsonLd = buildSiteGraphStructuredData();
---

<BaseLayout
  title={m.meta.siteName}
  description={m.meta.description}
  canonicalPath="/vi/"
  jsonLd={jsonLd}
>
  <Header slot="header" />

  <div class="home-page">
    <LandingHero />
    <LandingPain />
    <LandingFlow />
    <LandingAudience />
    <LandingEcosystem />
    <LandingCta />
  </div>

  <Footer slot="footer" />
</BaseLayout>
