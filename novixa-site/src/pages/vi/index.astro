---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LandingHero from '../../components/landing/LandingHero.astro';
import LandingTrio from '../../components/landing/LandingTrio.astro';
import LandingAudience from '../../components/landing/LandingAudience.astro';
import LandingWhy from '../../components/landing/LandingWhy.astro';
import LandingKnowledge from '../../components/landing/LandingKnowledge.astro';
import LandingCta from '../../components/landing/LandingCta.astro';
import { t } from '../../i18n';
import { buildSiteGraphStructuredData } from '../../lib/site-structured-data';
import { getCollection } from 'astro:content';
import { sortPublishedNews } from '../../lib/newsDate';
import '../../styles/global.css';
import '../../styles/home-landing.css';

const m = t('vi');
const jsonLd = buildSiteGraphStructuredData();
const posts = sortPublishedNews(await getCollection('tinTuc')).slice(0, 5);
---

<BaseLayout
  title={m.meta.siteName}
  description={m.meta.description}
  canonicalPath="/vi/"
  jsonLd={jsonLd}
>
  <Header slot="header" />

  <div class="home-page">
    <LandingHero />
    <LandingTrio />
    <LandingAudience />
    <LandingWhy />
    <LandingKnowledge posts={posts} />
    <LandingCta />
  </div>

  <Footer slot="footer" />
</BaseLayout>
