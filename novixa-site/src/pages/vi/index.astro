---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LandingHero from '../../components/landing/LandingHero.astro';
import LandingPain from '../../components/landing/LandingPain.astro';
import LandingFlow from '../../components/landing/LandingFlow.astro';
import LandingAudience from '../../components/landing/LandingAudience.astro';
import LandingEcosystem from '../../components/landing/LandingEcosystem.astro';
import LandingKnowledge from '../../components/landing/LandingKnowledge.astro';
import LandingCta from '../../components/landing/LandingCta.astro';
import { getCollection } from 'astro:content';
import { filterPublishedPosts } from '../../lib/publishedNews';
import { t } from '../../i18n';
import { buildSiteGraphStructuredData } from '../../lib/site-structured-data';
import '../../styles/global.css';
import '../../styles/home-landing.css';

const m = t('vi');
const jsonLd = buildSiteGraphStructuredData();
const homeArticleIds = [
  'mot-khach-quay-lai-nhieu-lan-dang-gia-hon-mot-khach-mua-mot-lan',
  'cach-giam-thuoc-can-han',
  'nha-thuoc-ban-kha-tot-nhung-chu-van-phai-co-mat-o-quay-ca-ngay',
];
const published = filterPublishedPosts(await getCollection('tinTuc'));
const homeArticles = homeArticleIds.flatMap((id) => {
  const post = published.find((item) => item.id === id);
  return post ? [post] : [];
});
---

<BaseLayout
  title={m.meta.siteName}
  description={m.meta.description}
  canonicalPath="/vi/"
  jsonLd={jsonLd}
>
  <Header slot="header" />

  <div class="home-page">
    <LandingHero />
    <LandingPain />
    <LandingFlow />
    <LandingAudience />
    <LandingEcosystem />
    <LandingKnowledge posts={homeArticles} />
    <LandingCta />
  </div>

  <Footer slot="footer" />
</BaseLayout>
