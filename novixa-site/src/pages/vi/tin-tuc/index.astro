---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import KnowledgeListing from '../../../components/KnowledgeListing.astro';
import { getCollection } from 'astro:content';
import { sortPublishedNews } from '../../../lib/newsDate';
import { getNewsCategory } from '../../../lib/news-categories';
import { t } from '../../../i18n';
import '../../../styles/global.css';

const m = t('vi');
const posts = sortPublishedNews(await getCollection('tinTuc')).filter(
  (p) => getNewsCategory(p.data.category).navGroup === 'knowledge',
);
---

<BaseLayout title="Kiến thức nhà thuốc" description={m.news.intro} canonicalPath="/vi/tin-tuc/">
  <Header slot="header" />
  <KnowledgeListing title="Kiến thức nhà thuốc" intro={m.news.intro} posts={posts} newLabel={m.news.newBadge} />
  <Footer slot="footer" />
</BaseLayout>
